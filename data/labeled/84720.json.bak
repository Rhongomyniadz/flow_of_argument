    "turn_idx": 10,
    "turn_text": "Yeah, one of the best arguments I heard against church and state coming together is if you're really pro-Christian, just imagine the government trying to push Islam on you and you know how non-believers feel.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
