  },
  {
    "episode_id": 84720,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84720.jsonl",
    "turn_idx": 87,
    "turn_text": "know, the enlightenment founders of our Constitution were adamant about using science and empiricism and reason. to arrive at the correct public policy analyses and outcomes. And if we don't, then we're in danger. And we can be exploited by particular groups that have other interests in mind. So the struggle to defend science is a critical one. And that doesn't mean that science has to be in conflict with people's religious faith in belief, as long as people aren't allowing their religious faith in belief to thwart science and to thwart the ability of us to have public dialogue that's based on reason and facts.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The Enlightenment founders of the U.S. Constitution emphasized science, empiricism, and reason.",
        "confidence": 0.96
      },
