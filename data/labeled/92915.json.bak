  {
    "episode_id": 92915,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92915.jsonl",
    "turn_idx": 19,
    "turn_text": "Tell the story if you would have approached Warren after she was less than cuddly toward you in",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [],
