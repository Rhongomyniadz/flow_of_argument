    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92915.jsonl",
    "turn_idx": 145,
    "turn_text": "I'm Alec Baldwin, and this is Here's the Thing from iHeartRadio. When protesters stormed the US Capitol Building on January 6th, Katie Porter wasn't far from the insurrection.",
