    "turn_idx": 121,
    "turn_text": "What are some of the legislation you might or might not propose to address that?",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
