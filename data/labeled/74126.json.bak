  {
    "episode_id": 74126,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/4/74126.jsonl",
    "turn_idx": 54,
    "turn_text": "Well, that's an easy one. And as much as I sometimes tell schoolchildren, you know, my job description is in my title, right? I'm a representative, which is an interesting distinction between the United States Congress and Westminster. There's no doubt about what my most important role is and that is to represent 750,000 people as all members of Congress do in the House of Representatives. So, you know, whenever I'm off opining on national security or how the CIA ought to be running their businesses or how we ought to regulate our banks, my touchstone has to be what would the 750,000 people who elected me to this position want me to do. And if you're somebody like me who actually thinks that you've got an intelligent thought or two to offer to the debate, you always have to go back to yes. But remember, I'm a representative.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
