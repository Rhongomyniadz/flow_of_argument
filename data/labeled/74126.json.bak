  {
    "episode_id": 74126,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/4/74126.jsonl",
    "turn_idx": 7,
    "turn_text": "Well, it was mind-boggling. I imagine that even for someone who grew up in Great Britain, Oxford is such an iconic thing that it's probably a heck of a culture shock. For an American, only more so, right? Nothing in our country has more than 200 plus years of tradition. And so to be wandering around in a quad where traditions were developed 600 years ago, where the accents are exotic and unusual, and all of a sudden you realize that you're actually the one with the accent where the method of education is so radically different from what we're used to. It was one of the most significant, even though of course obviously the British and the American people are closely related, it was a moment of profound culture shock.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
