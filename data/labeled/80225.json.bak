    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "For the first time in fifty years, the microphone of the president of the Senate and the speaker of the House are both under Republican control.",
        "confidence": 0.95
      },
