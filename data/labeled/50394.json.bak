        "confidence": 0.94
      },
      {
        "text": "Persistence over time is essential for maintaining democratic institutions.",
        "confidence": 0.92
      },
      {
        "text": "Building resilience is a critical component of preserving democracy.",
        "confidence": 0.91
      }
    ],
    "assumptions": [
