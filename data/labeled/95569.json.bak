  {
    "episode_id": 95569,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95569.jsonl",
    "turn_idx": 7,
    "turn_text": "Well, it seems to me that there's a very simple calculation here going on. If this is the area where your own colleagues on the Republican side of the aisle feel that things need to move, then where do they feel like they can fight instead? Because this is clearly a justified fight. The Pentagon under Joe Biden is doing something that is clearly unconstitutional and illegal. So are they going to give, you know, on something else? Are they going to find some other thing to, you know, sort of move on to if they believe that these need to move now? Or are they just going to give up?",
    "speaker_id": "SPEAKER_07",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The Pentagon's actions under Joe Biden are unconstitutional.",
        "confidence": 0.96
      },
      {
        "text": "The Pentagon's actions under Joe Biden are illegal.",
        "confidence": 0.96
      },
      {
        "text": "There is a very simple calculation happening in this situation.",
        "confidence": 0.95
      },
      {
        "text": "The fight over the Pentagon's actions under Joe Biden is justified.",
        "confidence": 0.94
      },
      {
        "text": "Republican colleagues believe that changes need to happen in this area.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Republicans who oppose the Pentagon's actions have strategic leverage to negotiate elsewhere.",
        "confidence": 0.93
      },
      {
        "text": "A justified cause warrants political resistance regardless of institutional consequences.",
        "confidence": 0.9
      },
      {
        "text": "Political compromise requires trade-offs between issues rather than total concessions.",
        "confidence": 0.88
      },
      {
        "text": "The speaker has sufficient credibility to judge constitutional and legal violations by the Pentagon.",
        "confidence": 0.87
      },
      {
        "text": "The audience accepts that the Pentagon’s actions under Biden constitute a serious legal breach.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 95569,
