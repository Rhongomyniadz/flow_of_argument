  {
    "episode_id": 43897,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/3/43897.jsonl",
    "turn_idx": 12,
    "turn_text": "Well, I think it needs to be released because we've got to get these people on track. The other breaking news is that Trump has said, and you know this because the border is John and I are tired of an open border. You know, people would be alive if some of these illegals weren't here. Trump has said he's going to deport these people. So I want to do to tell us, um, are you on in line with that? Cause I'm, I'm pro legal, uh, legal immigrants, my family, my mother from Spain, my father in law, Hungary, my mother in law, Scotland, they all came here legally. So I welcome you illegally, but I don't welcome you illegally. Can we deport millions of people out of this country?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
