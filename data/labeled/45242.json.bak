  {
    "episode_id": 45242,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45242.jsonl",
    "turn_idx": 29,
    "turn_text": "Yeah, well, it was definitely a tragic accident, but it's a part of my life story. And of course, it was many years ago. But I started out in a police cadet program at the work police department and I fell in love with law enforcement. I thought that was going to be my career. I was really excited about law enforcement. I thought maybe I'd become a police officer and then perhaps go on to the FBI as an agent someday. But, you know, I've had other plans and an accident happen when I was in the locker room. Police officers gone accidentally went off and the officer, he didn't realize it was loaded and the bullet went through my neck and severed my spinal cord because I was paralyzed ever since. It definitely derailed my plans to go into law enforcement but didn't diminish my passion for life and doing other things.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
