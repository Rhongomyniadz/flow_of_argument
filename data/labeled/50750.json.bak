        "confidence": 0.94
      },
      {
        "text": "I am currently living in a country where socialism is being built.",
        "confidence": 0.93
      },
      {
        "text": "It was only a matter of time before socialism failed financially.",
        "confidence": 0.92
      },
      {
        "text": "My personal experience represents a full circle moment regarding socialism.",
        "confidence": 0.91
      },
      {
        "text": "Socialized healthcare is a terrifying prospect based on my experience.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "Financial collapse is an inevitable outcome of socialism.",
