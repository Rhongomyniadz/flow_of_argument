  {
    "episode_id": 90453,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90453.jsonl",
    "turn_idx": 75,
    "turn_text": "I think that Chicago politics, by and large, is an entirely different ballgame than it was, certainly a generation ago, but I think even 10, 20 years, I think it's the city is being run increasingly in much more professional way. I think our elections are pretty darn clean. There are those in DC when I was seeking to get election security dollars spent and talk about protecting our elections. I had those who say, so you don't want the Russians to steal our votes, but it's okay if people in graveyards do. So I get to your point, our reputation is still where it was a while ago, and I think that's unwarranted. I will say though that what I was working for Alderman Bernie Hanson in his service office. The calls that came in were about potholes, streetlights, the quality of schools, whether people felt safe walking home from the train. That's a great lesson in life to appreciate this.",
    "speaker_id": "SPEAKER_05",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
