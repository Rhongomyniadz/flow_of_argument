  {
    "episode_id": 75412,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/5/75412.jsonl",
    "turn_idx": 7,
    "turn_text": "Well, I don't accept that we're the stupid party, but I understand what he was trying to say. I hope what he was trying to say, and I think what he was trying to say was that the Republican Party did a better job of making more people feel like we are the home of their aspirations. We were entering an era in American politics where we have perhaps a higher level of economic insecurity as we certainly had in my lifetime. And that's not just a function of a cyclical downturn in the economy, it's a function of a structural change in the nature of the economy. For example, people like my parents who arrived at the US as basically immigrants with very little formal education, today people like that with no education would struggle to make it to the middle class the way they were able to do in service sector jobs because the nature of our economy has changed. Too many of these folks feel like the Republican Party does not speak for them, and we have to change that perception because we have ideas that I think could empower their aspirations for themselves and their",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
