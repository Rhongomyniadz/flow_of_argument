  {
    "episode_id": 66467,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/6/66467.jsonl",
    "turn_idx": 162,
    "turn_text": "Well, I like how in the book you talk about how historically as a country, we weren't in love with big, big, bigger. We weren't looking to have these companies get so huge and sort of take over large factions of American society. And that's why people like Teddy Roosevelt and frankly FDR and others started cracking down on these monopolies because they're not healthy for a democracy. Now people like Stassel, my friend and libertarian John Stassel might say, So what? They provide a lot of good services. They got so big because people loan. And that's the United States. That's capitalism. What would you say to that?",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Historically, the U.S. has been wary of excessively large corporations.",
        "confidence": 0.97
      },
      {
        "text": "Teddy Roosevelt and Franklin D. Roosevelt took action against corporate monopolies.",
        "confidence": 0.96
