      {
        "text": "Stassel argues that large corporations provide valuable services and grow due to market demand.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "The speaker believes democratic health depends on limiting concentrated economic power.",
        "confidence": 0.95
      },
      {
        "text": "The speaker views government intervention in markets as justified when it protects democratic values.",
        "confidence": 0.93
      },
      {
        "text": "Market-driven growth alone does not constitute moral or societal legitimacy for corporate size.",
        "confidence": 0.91
      },
      {
        "text": "The speaker trusts historical precedent as evidence for current policy concerns.",
        "confidence": 0.89
      },
      {
        "text": "The listener agrees with the speaker’s framing of the issue enough to respond to the counterargument.",
