      }
    ],
    "assumptions": [
      {
        "text": "The Wall Street Journal is a credible source of information.",
        "confidence": 0.95
      },
      {
        "text": "A reliable negotiating partner must consistently honor agreements.",
        "confidence": 0.93
      },
      {
        "text": "The Prime Minister has good judgment and integrity in foreign policy matters.",
        "confidence": 0.9
      },
      {
        "text": "Iran’s willingness to negotiate in good faith is questionable.",
        "confidence": 0.89
      },
      {
        "text": "Calling Iran's bluff is a strategically sound move in negotiations.",
        "confidence": 0.88
      },
