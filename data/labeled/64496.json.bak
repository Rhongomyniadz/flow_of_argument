    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 64496,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/4/64496.jsonl",
    "turn_idx": 10,
    "turn_text": "No, he can. And that's why the administration has been so angry and so fearful of him coming to speak to us because they know that he could. And honestly, Doug, he's one of the most powerful leaders on the world stage right now. And he's driven by a value of protecting his people. It's not by politics. You know, the clip that you just played, I think he goes on at that point to say, the enemy of my enemy is not my friend. In this case, the enemy of my enemy is still my enemy.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "He can come to speak to us.",
        "confidence": 0.97
      },
      {
        "text": "The administration has been angry and fearful of him coming to speak to us.",
