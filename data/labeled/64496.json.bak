      },
      {
        "text": "The editorial makes the point that we cannot trust Iran on anything.",
        "confidence": 0.96
      },
      {
        "text": "It is foolish to assume Iran will comply with an agreement they see as contrary to their national interest.",
        "confidence": 0.95
      },
      {
        "text": "Iran has worked against American interests over a long period.",
        "confidence": 0.94
      },
      {
        "text": "Iran has killed Americans through groups like Hezbollah and Hamas.",
        "confidence": 0.92
      },
      {
        "text": "We currently believe we can trust Iran on a key national security issue.",
        "confidence": 0.91
      },
      {
        "text": "Iran’s hostile activities extend from North Korea to South America to Mexico.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "Trustworthiness requires consistency between actions and stated intentions over time.",
        "confidence": 0.93
      },
      {
        "text": "National interest is a reliable predictor of state behavior in international agreements.",
        "confidence": 0.92
      },
      {
        "text": "A history of hostility toward the U.S. undermines current claims of reliability.",
        "confidence": 0.9
      },
      {
        "text": "The Wall Street Journal is a credible source of political analysis.",
        "confidence": 0.88
      },
      {
        "text": "The speaker’s position reflects a widely accepted standard of rational foreign policy decision-making.",
        "confidence": 0.87
      },
      {
        "text": "The audience shares skepticism toward Iran's motives and values the speaker’s perspective.",
