  {
    "episode_id": 64496,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/4/64496.jsonl",
    "turn_idx": 13,
    "turn_text": "It was interesting to watch this unfold and it was interesting to to note that there were some who were not there and whether it's because they're out of the country if that was by design or not, you know, who'll know, but the secretary stayed out of the country as I understand it, the vice president out of the country, the president chose not to not only attend, but also not to meet with Mr. Netanyahu while he is here. It left our Senator Hatch sitting to the left of Mr. Boehner as the President Pro Tem of the Senate. It was an interesting setting this morning and all kinds of interesting messages just even in who's there, who's not there, and who's applauding, who's not applauding. It was really quite revealing.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Senator Hatch served as the President Pro Tempore of the Senate.",
