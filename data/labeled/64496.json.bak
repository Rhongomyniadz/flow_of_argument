    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Ahmadinejad made statements at the United Nations.",
        "confidence": 0.96
      },
      {
        "text": "Iran has made bombastic comments over the years.",
        "confidence": 0.95
      },
      {
        "text": "Iran has made blatant comments over the years.",
        "confidence": 0.94
      },
      {
        "text": "Iran has made threatening comments over the years.",
        "confidence": 0.93
      },
