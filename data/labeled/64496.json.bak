    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 64496,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/4/64496.jsonl",
    "turn_idx": 9,
    "turn_text": "And then he went on to say, this is a deadly game of thrones. I'll tell you this, Chris, I have never heard it put that way that succinctly before Netanyahu can really deliver a message.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
