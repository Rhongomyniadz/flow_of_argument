  {
    "episode_id": 49919,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49919.jsonl",
    "turn_idx": 82,
    "turn_text": "Chairman Neil, just a bit of a gear change here, because you have been a massive defender of the Good Friday Agreement ever since the Brexit chaos from 2016. For you, what would a Republican House mean for US, Irish and UK relations?",
