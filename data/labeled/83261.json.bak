    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83261.jsonl",
    "turn_idx": 23,
    "turn_text": "Yeah, that's such a good point. Well, something that Democrats are pushing right now is looking at sending checks of $2,000 a month to Americans until the economy hits pre-coronavirus levels. Do you think that their thought on that is an appropriate response?",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
