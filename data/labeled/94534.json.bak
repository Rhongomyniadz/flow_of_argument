      }
    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 94534,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94534.jsonl",
    "turn_idx": 41,
    "turn_text": "No, I don't think. because it's not because the conversation and immigration reform has been one-sided. We've been playing on the defensive on this issue. And I think once you talk to people in a very real way about what it means, what benefits are derived from reforming a broken law, accepting the fact that security has to be part and parcel of any reform, and saying that loudly and clearly, but also talking about family unification, that I think you can have that conversation, you can have that in a logical, reasonable way, okay? And we haven't done enough of that. And it's not because it's either our way or the highway in terms of those of us that pro reform in this Congress, it's that when those issues hit, people have ran away from them. And I really think we need to confront it, but the message can't be shrill on one end and shrill on the other end. It's got to be a rational discussion that deals with people's insecurities about immigration. And more importantly, there's stereotypes about what it is. And I think you can have that conversation.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The conversation around immigration reform has been one-sided.",
        "confidence": 0.97
      },
      {
        "text": "Security must be included as part of any immigration reform.",
        "confidence": 0.96
      },
      {
        "text": "We have been playing defensively on the issue of immigration reform.",
        "confidence": 0.95
      },
      {
        "text": "Talking to people in a real way about the benefits of reforming a broken law is important.",
        "confidence": 0.94
      },
      {
        "text": "Family unification should be discussed in conversations about immigration reform.",
        "confidence": 0.93
