  {
    "episode_id": 94534,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94534.jsonl",
    "turn_idx": 40,
    "turn_text": "Look, we talked about this a little bit earlier in terms of people like Joe Manchin, but the way the electoral map is in the United States, you have a fast-growing Hispanic population, but a lot of them are in states which are probably not or may not be the swing states in the next election. And I was wondering, do you feel that the Democratic Party has done a good job of talking to people who are not supremacists but are concerned about rising immigration?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Many Hispanic Americans live in non-swing states.",
        "confidence": 0.94
      },
      {
        "text": "The electoral map in the United States makes it difficult for the growing Hispanic population to influence elections.",
        "confidence": 0.92
      },
      {
        "text": "The speaker is questioning whether the Democratic Party effectively communicates with non-supremacist voters concerned about immigration.",
        "confidence": 0.9
