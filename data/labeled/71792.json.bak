        "confidence": 0.94
      },
      {
        "text": "The speaker then questioned how many Americans are killed by individuals who successfully entered the U.S.",
        "confidence": 0.93
      },
      {
        "text": "The speaker knew individuals who were killed by people entering the U.S. illegally.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
