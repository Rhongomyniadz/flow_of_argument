    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Profiling is necessary to function in law enforcement.",
        "confidence": 0.95
      },
      {
        "text": "The Democrats on the Judiciary Committee claim that profiling is illegal.",
        "confidence": 0.92
      },
      {
        "text": "There is no law against profiling.",
        "confidence": 0.9
      },
      {
        "text": "I have served on the Judiciary Committee for 16 years.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "Effective law enforcement requires making quick judgments based on observable characteristics.",
        "confidence": 0.94
      },
      {
        "text": "The claim that profiling is illegal is false or misleading.",
        "confidence": 0.91
      },
      {
        "text": "The audience accepts the speaker’s authority due to their long tenure on the committee.",
        "confidence": 0.89
      },
      {
        "text": "Categorizing individuals by visible traits is a legitimate and non-arbitrary basis for suspicion.",
        "confidence": 0.87
      },
      {
        "text": "Law enforcement effectiveness depends on the ability to use generalizations under time pressure.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Disrupted"
  },
  {
    "episode_id": 71792,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71792.jsonl",
    "turn_idx": 19,
    "turn_text": "But that's profiling, isn't it? And as you have to be able to profile, you have to be able to describe what they're driving, what they're wearing, what they look like. And they're saying, but if they're a minority, you can't do that because they have a special protected status like they were an endangered species or something. Well, I'd be happy if the endangered species in America were illegal aliens. I'd be happy if there were none of them. in this country at all. That's my level of tolerance for illegal immigration into America, Scott.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
