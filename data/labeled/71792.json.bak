  {
    "episode_id": 71792,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71792.jsonl",
    "turn_idx": 3,
    "turn_text": "Well, Scott, this has broken my heart for years. And it goes back to sitting at the immigration hearing. So this is my 16th year in Congress. So it would be 16 years ago. And they would bring witnesses forward to testify. How many people died in the Arizona desert trying to sneak into America? And I kept hearing that testimony week by week. And I thought, what's the other side of this equation? Because I've known people who were killed by illegals. And so I began asking the question, are you told me how many people died in the Arizona desert trying to sneak into America? Now can you tell me how many Americans die at the hands of those who actually got into America?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I have been serving in Congress for 16 years.",
        "confidence": 0.99
      },
      {
