  {
    "episode_id": 71792,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71792.jsonl",
    "turn_idx": 60,
    "turn_text": "We love that, and we love him. He is terrific. He is a great guy, and I've met him socially as well as watch the way he coached. He inspires young people, he brings good values to play. These guys want to play ball for Matt Campbell. And so I had a former political opponent with the same name, so I had to get over that. But other than that, we're really, really happy with him. I'll say to the folks in Toledo, here was my advice to the president of Iowa State University when we got near the end of the season last year, and I think his contract was up. I said, here's what you need to do. Set Matt Campbell down, Coach Campbell down, and take a look at his contract. Then you ask him, how much do you want?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
