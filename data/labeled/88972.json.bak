  {
    "episode_id": 88972,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88972.jsonl",
    "turn_idx": 81,
    "turn_text": "What was Mitch McConnell like when you were down in the Senate? I mean, did you have conversations with him over your time there? Was he friendly, welcoming, standoffish, aloof, none of the above?",
