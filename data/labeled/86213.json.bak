  {
    "episode_id": 86213,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86213.jsonl",
    "turn_idx": 118,
    "turn_text": "Just anxiety overwhelming. As I described in the book, you know, my life was very stressful at that point. My children were four and one. I was on that Tuesday, Thursday schedule, two small children. And I don't know, I came home one night and this overwhelming sense of anxiety just hit me. It wouldn't go away. Among other things, I was terrified of the inevitability of my own death at that point. That seemed to hit me. But then I was just, I mean, and it was just, I had never felt anything like that in my life. It was just this unbelievable anxiety. Every second of every day was like an existential threat. The only way I can describe it is imagine that you know, you're basically facing what you think is your own death, like someone's coming at you with a machete or your car skidding towards a cliff. You know, that's the way I felt every second of every day.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
