    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 45210,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45210.jsonl",
    "turn_idx": 5,
    "turn_text": "I wish that were the case. What I have figured out is that we do have the finest form of government that's ever been devised as long as we recognize that and honor it. And that means the Constitution.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
