  {
    "episode_id": 45210,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45210.jsonl",
    "turn_idx": 20,
    "turn_text": "Well, like most members of Congress, you put a lot of miles in. You want to talk about the balance between home life and Washington life? How has that worked for you over the years?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Most members of Congress accumulate significant travel mileage.",
