  {
    "episode_id": 45210,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45210.jsonl",
    "turn_idx": 14,
    "turn_text": "I know that you know that wildfires in California have grown to catastrophic levels. The cost for containment and rebuilding continually grows. When addressing this, you've often spoke about the need for improving land and forest management, right?",
