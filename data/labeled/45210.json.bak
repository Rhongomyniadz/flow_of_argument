        "text": "We have the finest form of government that has ever been devised.",
        "confidence": 0.94
      },
      {
        "text": "I wish that were the case.",
        "confidence": 0.92
      },
      {
        "text": "This claim holds true if we recognize and honor the Constitution.",
        "confidence": 0.91
      }
    ],
    "assumptions": [
