    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45210.jsonl",
    "turn_idx": 4,
    "turn_text": "That's good enough. Congratulations on your recent re-election and now with your sixth term in office underway, you've got a full decade under your belt of being a member of Congress. Thinking you've probably got a few things figured out here by now, right?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
