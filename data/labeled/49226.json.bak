  {
    "episode_id": 49226,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49226.jsonl",
    "turn_idx": 24,
    "turn_text": "What percentage of the Republican caucus would you say privately says the things you're saying about former President Trump? And",
