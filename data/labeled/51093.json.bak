        "confidence": 0.9
      },
      {
        "text": "The left argues that platforms like Facebook threaten democracy by amplifying harmful content such as QAnon.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "Democracy depends on the integrity of public discourse and information ecosystems.",
        "confidence": 0.93
      },
      {
        "text": "Technological platforms have substantial influence over societal norms and political processes.",
        "confidence": 0.92
      },
      {
        "text": "The speaker believes that framing tech issues as purely economic or competitive misses their broader democratic significance.",
        "confidence": 0.9
      },
      {
        "text": "Audience members are likely familiar with debates about tech regulation and partisan divides.",
        "confidence": 0.87
      },
      {
        "text": "The speaker views Senator Hawley’s position as representative of a conservative critique of big tech.",
