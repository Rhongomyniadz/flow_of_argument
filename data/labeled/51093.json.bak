  {
    "episode_id": 51093,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/1/51093.jsonl",
    "turn_idx": 43,
    "turn_text": "Something that's immediately coming to mind here is a deep frustration I have with this debate, which is people will usually frame the tech quash, the constant of the tech as a bipartisan issue. But when you actually look into, and you set a lot of bipartisan things here, but I think when you go into the deeper critiques that both parties are making, there's a really large disagreement. So a key thing in your book is you make the argument that this monopoly power isn't just a conversation around competition and money and market dominance. It's actually about the status of democracy. And something that people on the left will say is they'll make that same argument, but in the opposite direction. So they'll say, we agree, Senator Hawley, Facebook is a threat to democracy because they platform all sorts of bad people. They allow QAnon to spread all sorts of different references. What do you say to people who are swayed by that argument?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
