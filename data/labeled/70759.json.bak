  {
    "episode_id": 70759,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/0/70759.jsonl",
    "turn_idx": 28,
    "turn_text": "The Democratic Party should stop pandering to a far left that is far more representative of Twitter and TikTok than it is of the real world. And it should start listening to working-class people of color. And we have to take positions that are aligned with the priorities of working-class people of color. Look, take the issue of immigration. strongly for immigration. For me, the more the merrier I see immigration as the driver of entrepreneurial and the essential workforce of America. But I'm also self-aware enough to know that I'm considerably to the lots of the country. And you have to meet people where they are. You cannot impose your ideology on the majority of the American people. As elected officials, we are constrained by public opinion.",
    "speaker_id": "SPEAKER_07",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We need to invest in infrastructure including roads, bridges, and broadband.",
