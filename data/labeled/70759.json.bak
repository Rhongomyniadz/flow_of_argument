      },
      {
        "text": "Investing in infrastructure serves both economic growth and national security objectives.",
        "confidence": 0.9
      },
      {
        "text": "Bold action is required rather than incremental steps.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
