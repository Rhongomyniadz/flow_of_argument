  {
    "episode_id": 88023,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88023.jsonl",
    "turn_idx": 8,
    "turn_text": "I did because I believe that I said this publicly and this is why I mounted a hopeless primary challenge to Donald Trump. I believe then and I still believe that Donald Trump is an existential threat to this country. He's everything our founders feared. So if you believe that and I did, then you have to help the only person who can beat him. And last year, that was Joe Biden. So I did everything I could do to get other Republicans to vote for Biden.",
