  {
    "episode_id": 88023,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88023.jsonl",
    "turn_idx": 33,
    "turn_text": "Here's why really simply Republican voters are generally older white guys and older white gals. And for a number of years, these older white people were scared at how quickly life was changing in America. And the Republican Party ignored their fears and didn't listen to them. They were losing their jobs. The country was becoming less white. We weren't defending our borders. But the party establishment ignored their voters. Then along in 2016, along comes a demagogue who says, I'm going to build a wall and make Mexico pay for it. I'll keep brown people out of America. And even though it was all BS because Trump lies about everything, Republican voters said, Oh my God, for the first time a Republican is listening to me. And so they clung to him even though he's a demagogue.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
