    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90932.jsonl",
    "turn_idx": 122,
    "turn_text": "Why is that important? Why is it important to, I mean, people don't think of Congress as a social club, but you do have to have relationships.",
    "speaker_id": "SPEAKER_10",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
