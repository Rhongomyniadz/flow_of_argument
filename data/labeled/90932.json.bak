  },
  {
    "episode_id": 90932,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90932.jsonl",
    "turn_idx": 131,
    "turn_text": "Yeah. Getting caught in the crossfire is where you compromise those beliefs of the people you represent. I often tell the leadership here on the hill that when I'm running my committee, I'm running the American, America's House of Representatives Committee on Homeland Security. But when I step onto the floor to vote, I'm voting for my district. And if my district wants me to vote against the speaker or against whomever, I'm voting my district when I'm on the floor. Now, when I get into a discussion in the committee, we're oftentimes talking through, like I did. I shared bringing people back, let's work it out. When I go on the floor though, I vote my district and I feel like that's my obligation to the people who send me up here. And so that's where I thread the needle. Now I don't, I'm not gonna share an opinion on whether I thought McCain or Romney threaded the needle correctly, but that's how I thread the needle.",
    "speaker_id": "SPEAKER_08",
    "inferred_speaker_name": null,
