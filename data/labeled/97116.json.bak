  },
  {
    "episode_id": 97116,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/7/97116.jsonl",
    "turn_idx": 16,
    "turn_text": "So recently you visited said field elementary and Newport News to see the impact firsthand. So what impact does this have to the average family in schools in your congressional district?",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
