  {
    "episode_id": 97116,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/7/97116.jsonl",
    "turn_idx": 10,
    "turn_text": "I'm Michael Pope. I'm Thomas Bellman. And this is Pod Virginia, a podcast that is pleased to welcome back to the show the senior member of the Virginia Congressional Delegation Congressman Bobby Scott. Thanks for joining us.",
