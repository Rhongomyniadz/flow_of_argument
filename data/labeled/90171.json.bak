  {
    "episode_id": 90171,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90171.jsonl",
    "turn_idx": 7,
    "turn_text": "Wait, how can you explain a little more about that loophole? It's like, how do they do this?",
