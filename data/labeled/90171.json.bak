  {
    "episode_id": 90171,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90171.jsonl",
    "turn_idx": 11,
    "turn_text": "Well, so these medications that use this parking strategy to keep them off, keep lower price drugs off the market, are more like the medicines that you would have your doctor prescribe to you in the doctor's office. So we're not talking about drugs like, you know, acetaminophen or common allergy medicines. For example, that you might get over the counter in a drug store. These would be medications that would be used for treating more serious illnesses or, you know, like cancers, those kinds of medications. But that can still cost patients hundreds and hundreds and sometimes thousands of dollars. In fact, an analysis shows that if we stopped this doing this, people would be able to save 80% of the cost and that is a big bite out of people's budgets.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Some medications use a 'parking strategy' to prevent lower-priced drugs from entering the market.",
