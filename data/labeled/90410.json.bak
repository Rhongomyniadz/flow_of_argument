      },
      {
        "text": "If we had seen some subpoenas enforced that were not enforced, we might have had clearer evidence supporting the need for impeachment initially.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "The enforcement of subpoenas is a relevant indicator of the seriousness of the investigation into misconduct.",
        "confidence": 0.94
      },
      {
        "text": "Clearer evidence would have justified impeachment earlier than it was pursued.",
