  {
    "episode_id": 90410,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90410.jsonl",
    "turn_idx": 146,
    "turn_text": "The biggest thing is probably the things that I assumed about the strength of our democratic system, the things that I assumed about elected officials, and not just assumed, but thought that I really knew because of decades spent in and around politics that those things are not true. And at least they're not true in this moment, but the corollary to that is that at the end of the day, it was individuals who actually did the right thing, who stopped this from being much worse. And it's hard to think of a much clearer and more important lesson for every American watching, especially young people. then the lesson of those individuals, the individuals making the right choice, not allowing themselves to be pressured by Donald Trump, individuals who defended the Capitol when it was attacked, the people in the administration who stood up to him, those people prevented this from being far worse. And that's a lesson for all of us.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
