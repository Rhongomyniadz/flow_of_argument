    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 90410,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90410.jsonl",
    "turn_idx": 85,
    "turn_text": "It's such an interesting thing because your committee, which is done in my view, really extraordinary work, is this strange amalgam of people. You have the two Democrats on the committee who led the two impeachments, Adam Schiff and Jamie Raskin, I think if I dug into the archives of quotes of yours that there may have been an unkind quote here and there about them during those processes, what has it been like working together now and what does that tell you about what's right and wrong with our politics?",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Adam Schiff and Jamie Raskin were leaders of the two impeachment proceedings.",
        "confidence": 0.97
      },
      {
        "text": "The committee is doing extraordinarily good work.",
        "confidence": 0.95
      },
      {
        "text": "The committee consists of a diverse group of individuals.",
        "confidence": 0.92
      },
      {
        "text": "There may have been unkind quotes made by the speaker about Adam Schiff and Jamie Raskin during past impeachment processes.",
        "confidence": 0.88
      },
      {
