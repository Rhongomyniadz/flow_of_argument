        "confidence": 0.93
      },
      {
        "text": "The speaker had long-standing experience in politics and considered their understanding authoritative.",
        "confidence": 0.92
      },
      {
        "text": "Certain government personnel stood up to Donald Trump during the incident.",
        "confidence": 0.91
      }
    ],
    "assumptions": [
