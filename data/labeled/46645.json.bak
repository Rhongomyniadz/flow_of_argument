  {
    "episode_id": 46645,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/6/46645.jsonl",
    "turn_idx": 6,
    "turn_text": "Yeah, no, it is interesting, though, to note, I know that you are talking to constituents all the time. What are they telling you about where things stand in America post-assassination attempt?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I am aware that you regularly communicate with constituents.",
        "confidence": 0.95
