  },
  {
    "episode_id": 91276,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/1/91276.jsonl",
    "turn_idx": 13,
    "turn_text": "My answer, the short answer is yes. My long answer is that we have to go back three years before I ran for president of student government and realized that in my eighth grade year, there were race riots at my high school. And to then walk into the school and three years later to become the president of the student government with a 70% majority white student body, showed me the progress that can be made in very little time. I would say that the Republican Party today I hope that we are all the great opportunity party, those of us who believe, and if you understand the evolution of the Southern heart that made the possibility of me becoming president of the student government, I hope that that same evolution has been manifest in the policy positions that I have fought for and have successfully accomplished on the Republican side of the aisle.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
