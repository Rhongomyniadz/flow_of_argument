    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 66259,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/6/66259.jsonl",
    "turn_idx": 44,
    "turn_text": "Well, black and Latino unemployment alone are astronomical. I think that the overall black unemployment is 14.3. Young black man, it's over 30%. Now we're talking about a piece of legislation, a law that has been deemed to tax by John Roberts on the court. This goes into place and people who already are having a hard time making ends meet are going to go from full time down to part time or from part time down to no time. And those are facts. They are political. They aren't me saying I can't stand Obama. That's me saying, holy mackerel, look at what's happening and Obamacare is not even funded yet. What happens once it gets",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Black unemployment is 14.3%.",
        "confidence": 0.95
      },
      {
        "text": "Unemployment among young Black men exceeds 30%.",
