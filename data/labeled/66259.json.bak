      },
      {
        "text": "The legislation will cause people currently working full-time to lose their jobs and become part-time workers.",
        "confidence": 0.88
      },
      {
        "text": "The legislation will cause people currently working part-time to lose their jobs and become unemployed.",
        "confidence": 0.87
      },
      {
        "text": "Obamacare is not yet fully funded.",
        "confidence": 0.85
      }
    ],
    "assumptions": [
      {
        "text": "Economic hardship is more severe for Black and Latino communities than for other groups.",
        "confidence": 0.93
      },
      {
        "text": "The speaker believes that job loss due to policy changes reflects systemic injustice.",
        "confidence": 0.91
      },
      {
        "text": "The ruling by John Roberts carries significant weight and should inform public understanding of the law.",
        "confidence": 0.89
      },
      {
        "text": "People struggling financially cannot afford further economic setbacks.",
        "confidence": 0.88
      },
      {
        "text": "The speaker views the expansion of healthcare through this law as economically destabilizing rather than beneficial.",
        "confidence": 0.86
      },
      {
