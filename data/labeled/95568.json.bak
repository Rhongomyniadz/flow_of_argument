    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 95568,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95568.jsonl",
    "turn_idx": 76,
    "turn_text": "Yeah, I don't know. Maybe. That may be something to that. You don't have a good fit up the ladder or down the ladder. So I don't know. That may be it. I'm not quite sure. Our politics has been so scrambled. But you know, you got like me, like, I wasn't into politics, but I like Ronald Reagan. He seems like a badass. He's taking on the Soviet Union. I mean, I wasn't getting into his economic policy, but I'm like, that's a good dude, respectful dude. Him and Tip O'Neill were drinking beer together and trying to work things out seemed pretty cool. He was an actor. It just seemed cool. It was like, okay, this is kind of normal. Um, in, in safe, I think we all felt safe too. I mean, you know, we didn't have the school shootings and some of the stuff that kids are dealing with today. We, we had the tech mobile and, you know, some pretty elementary tech. Now, now my kid knows every football player in the NFL when he plays Madden and he knows their ratings. We're like watching TV and Brady's like, yeah, that guy's got an 86 rating.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
