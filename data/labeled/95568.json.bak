  {
    "episode_id": 95568,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95568.jsonl",
    "turn_idx": 33,
    "turn_text": "Well, we started this conversation talking about football. You know, America is a country that likes to compete, you know, and they like to look up at the scoreboard, whether it's, you know, I mean, look at football almost every day of the week in the fall, whether it's NBA, NCAA, tournament. Look, we're talking about, you know, the run in October with baseball. You look at women's basketball now. America is a country that wants to compete and watch people compete and watch people compete at a high level. Our competition is with China, primarily economically. And so the decisions that we have to make have to be seen looking up at the scoreboard saying, what's China up to what are we doing? They've got some significant anchors around their neck with their demographic issues, energy issues, aging population issues, their one child policies coming back to bite them on the rear end. And so they've got some real issues. Now's the time for us to hit the gas panel. So I think you frame AI, you frame reshoring manufacturing.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
