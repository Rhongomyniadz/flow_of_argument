    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There are two primary goals in conversations with individuals who have been involved.",
        "confidence": 0.95
      },
      {
        "text": "One primary goal is to provide consumers with the information they want and need to know.",
        "confidence": 0.94
      },
      {
        "text": "A second primary goal is to avoid stigmatizing a technology.",
        "confidence": 0.93
      },
      {
        "text": "Some people fear that mandatory labeling standards could lead to stigma against specific products.",
        "confidence": 0.92
      },
      {
        "text": "Mandatory labeling standards may imply that certain products are different from others.",
        "confidence": 0.91
      }
    ],
    "assumptions": [
      {
        "text": "Consumers value transparency and access to relevant information about technologies.",
        "confidence": 0.93
      },
      {
        "text": "Stigmatization negatively affects consumer perception and adoption of new technologies.",
        "confidence": 0.92
      },
      {
        "text": "Labeling standards influence public perception of products.",
