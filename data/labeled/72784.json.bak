  {
    "episode_id": 72784,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72784.jsonl",
    "turn_idx": 39,
    "turn_text": "I've been generally supportive of opening up additional trade with Cuba, and that again goes back to my days in the House of Representatives. I do have real concerns about some of the other attempts that he's making with regard to normalization of relations there simply because I don't think you are a reward bad behavior. I mean creating an embassy there doing a lot of things that he's attempting to do. I think fly in the face of what we try to do in terms of promoting freedom and democracy around the world. This is a country that It represses the rights of people when it comes to speech and expression and continues to imprison people for speaking out. This is a country that you don't want to, I think, go to the full lengths that he's talking about in terms of opening up a fleet in full diplomatic relationships. That said, we have, I think, in the past tried through the use of trade to get Cuba to come more into the into the world, into the international marketplace, and hopefully in doing so, get them to a point where they're ready to start changing their behavior. So I've had, when it comes to trade issue and agricultural trade, I've been a general supporter of that, but I also recognize how important it is that we send the right messages and the right signals in terms of the behavior of the regime there, and I hope that the president uses discretion when it comes to rewarding behavior from a regime that has not demonstrated I think the kind of record that warrants full recognition by the United States.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
