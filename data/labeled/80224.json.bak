        "confidence": 0.9
      },
      {
        "text": "The speaker has access to reliable information about political agendas related to healthcare reform.",
        "confidence": 0.88
      },
      {
        "text": "Political actors who advocate for privatization of public services have ulterior motives that may undermine public trust.",
        "confidence": 0.86
      },
      {
        "text": "Privatizing Medicare would represent a significant departure from its current structure and purpose.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 80224,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80224.jsonl",
    "turn_idx": 12,
    "turn_text": "What's your feeling on the government providing healthcare for everyone?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There exists a question about people's feelings regarding universal healthcare provision by the government.",
        "confidence": 0.92
      },
      {
        "text": "The government should provide healthcare for everyone.",
        "confidence": 0.75
      }
    ],
    "assumptions": [
      {
