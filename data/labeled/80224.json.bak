    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 80224,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80224.jsonl",
    "turn_idx": 14,
    "turn_text": "How do you propose to do that? Is that something like the Canadian system where it's available to everyone or there's a pay as you go?",
