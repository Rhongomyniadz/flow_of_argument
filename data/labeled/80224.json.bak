    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80224.jsonl",
    "turn_idx": 10,
    "turn_text": "Well, that's true, but if we're looking at the leadership, and I presume there are some people, as you say, with a mission or an agenda, presumably intelligent individuals, why are they doing it this way?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "That is true.",
