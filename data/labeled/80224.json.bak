  {
    "episode_id": 80224,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80224.jsonl",
    "turn_idx": 9,
    "turn_text": "Let's take Medicare Reform. It's the first major reform of the Medicare program, 38 years. uh... it seems to me that when you take on something that significant it should be done cooperatively in a bipartisan manner and we should do it in a way that represents all the people of this great country",
