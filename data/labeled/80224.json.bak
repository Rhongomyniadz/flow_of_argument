    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80224.jsonl",
    "turn_idx": 3,
    "turn_text": "so i i just don't know how you can have a hearing and put forward what it policy that's in the best interest of uh... of all americans by having one small group uh... meet in secret to uh... conceive that policy",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "It is impossible to create a policy in the best interest of all Americans through a process involving a single small group meeting in secret.",
        "confidence": 0.97
      },
      {
        "text": "The policy-making process described involves one small group meeting in secret to develop policy recommendations.",
        "confidence": 0.95
      },
      {
        "text": "A public hearing cannot effectively produce policies that serve all Americans if decisions are made by a small, secretive group.",
