      },
      {
        "text": "We are examining leadership.",
        "confidence": 0.95
      },
      {
        "text": "Some people have a mission or an agenda.",
        "confidence": 0.92
      },
      {
        "text": "These people are presumed to be intelligent.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
