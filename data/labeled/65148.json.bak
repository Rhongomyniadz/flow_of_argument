  {
    "episode_id": 65148,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/5/65148.jsonl",
    "turn_idx": 4,
    "turn_text": "I'm great. So I really, really actually want to talk about Florida, your reelection and the future of the state. But I got to ask you out of the gate, if you would, just kind of explain the rationale for moving the illegal aliens to Martha's Vineyard. And I want to give you a chance to kind of address that, that I think nonsensical story that none of these people knew where they were going.",
