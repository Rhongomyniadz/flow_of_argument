    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I am great.",
        "confidence": 0.97
      },
      {
        "text": "I need to know the rationale for moving illegal aliens to Martha's Vineyard.",
        "confidence": 0.96
      },
      {
        "text": "I really, really actually want to talk about Florida, your reelection, and the future of the state.",
        "confidence": 0.94
      },
      {
        "text": "I want to give you a chance to address the claim that the move was nonsensical.",
