        "confidence": 0.92
      },
      {
        "text": "Funding should prioritize areas demonstrating high performance and quality.",
        "confidence": 0.9
      },
      {
        "text": "Catering services should not perform police work due to mismatched expertise.",
        "confidence": 0.88
      },
      {
        "text": "Social workers are professionals with distinct training and roles.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "Quality of service depends on professional training and experience.",
        "confidence": 0.94
      },
      {
