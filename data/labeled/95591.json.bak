    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 95591,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95591.jsonl",
    "turn_idx": 20,
    "turn_text": "The thing that I hear about big tech from conservatives across the country is frustration with a lot of elected Republicans who they feel like are perfectly happy to help hold hearings where they yell at the various members, the leaders of these global you know, multi-billion, multi-companies that are essentially nation-states unto themselves. And then that's it. They just yell at them, they send some letters, they complain, but they don't actually do anything. And the answer that they typically get is, well, just elect more Republicans and will do something. But they certainly didn't see that happen when they got the White House and the Senate in 2016. How does that change? What is the difference that needs to happen in terms of actually delivering change within this space as opposed to just having another instance of yelling at Mark Zuckerberg?",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
