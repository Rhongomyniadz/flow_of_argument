      },
      {
        "text": "Woke corporations are the primary drivers of left-wing social change in America.",
        "confidence": 0.85
      },
      {
        "text": "Woke capitalism and big government are allied forces.",
        "confidence": 0.84
      }
    ],
    "assumptions": [
