  {
    "episode_id": 90457,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90457.jsonl",
    "turn_idx": 406,
    "turn_text": "Yeah, I mean, it's just, I've thought as a Republican and a conservative, I've always thought, you know, we preach the gospel of travel and commerce and contact as a way to nudge countries toward democracy. Yet with Cuba, we say, not we'll work there. And the truth is, it will work. Certainly, policy of isolation for over 50 years hasn't worked. And so I've just thought that we're better off by actually exposing them to American values. And these sanctions are not on Cuba, they're on us. And so I thought if somebody's going to limit my travel, it should be a communist, not my own government.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Cuba has been subject to a policy of isolation by the U.S. for over 50 years.",
        "confidence": 0.97
      },
      {
        "text": "The United States has long pursued a foreign policy based on promoting democracy through travel, commerce, and international contact.",
        "confidence": 0.96
      },
      {
        "text": "The U.S. policy of isolating Cuba has failed to achieve its intended democratic outcomes.",
        "confidence": 0.94
      },
      {
        "text": "Exposing Cuba to American values through increased interaction would be beneficial.",
        "confidence": 0.92
      },
      {
        "text": "U.S. sanctions against Cuba primarily harm Americans rather than Cubans.",
        "confidence": 0.9
      },
      {
        "text": "Government restrictions on personal travel are unjust when imposed by one's own nation.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "Democracy can be promoted effectively through cultural and economic exchange.",
        "confidence": 0.95
      },
      {
        "text": "American values are inherently superior and desirable for other nations to adopt.",
        "confidence": 0.91
      },
      {
        "text": "The U.S. government’s enforcement of travel restrictions reflects a failure of trust in individual autonomy.",
        "confidence": 0.88
      },
      {
        "text": "The speaker identifies strongly with being a Republican and conservative, which shapes their view on foreign policy.",
        "confidence": 0.87
      },
      {
        "text": "A communist regime is more legitimate than a democratic one in restricting citizens' freedoms.",
        "confidence": 0.85
