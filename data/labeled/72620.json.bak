  },
  {
    "episode_id": 72620,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72620.jsonl",
    "turn_idx": 15,
    "turn_text": "Now a congressman under the president's executive order undocumented young people can be issued work permits. We know that high unemployment among African Americans has been a persistent problem. Is it difficult for you to justify to your black constituents your support for a measure that will put more people into the labor market and create increased competition for jobs?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
