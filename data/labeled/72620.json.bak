    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The primary qualification for a congressional representative is effective representation of all constituents in the district.",
        "confidence": 0.98
      },
      {
        "text": "The representation of congressional districts often does not reflect the demographic majority of those districts.",
        "confidence": 0.97
      },
