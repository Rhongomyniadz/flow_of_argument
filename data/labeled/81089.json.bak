    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 81089,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/1/81089.jsonl",
    "turn_idx": 12,
    "turn_text": "Originally, my mother is from the island of Barbados and my father is from Guyana. I was born here but I grew up in the British West Indies and my mother was a domestic for many, many years and my father was an unskilled laborer in a burlap bag factory. So I really came out of the depths of poverty and deprivation.",
