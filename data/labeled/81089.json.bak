    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 81089,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/1/81089.jsonl",
    "turn_idx": 14,
    "turn_text": "And Shirley Chisholm spelt it out in a BBC interview she gave shortly after announcing her presidential bid that it was being a woman that was harder.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Shirley Chisholm announced her presidential bid.",
        "confidence": 0.95
      },
      {
