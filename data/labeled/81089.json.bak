    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 81089,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/1/81089.jsonl",
    "turn_idx": 15,
    "turn_text": "Particularly in the political arena, I have found that I have met much more discrimination as a woman than being black. Because I think essentially we have to realize that black males and white males are no different from each other in terms of the fact that first of all they are homo sapiens and they are part of the male species who definitely have feelings about women on top level and top level positions in our country both administratively and in decision making process.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Black males and white males are biologically identical as Homo sapiens.",
        "confidence": 0.95
      },
      {
        "text": "I have experienced more discrimination as a woman than as a Black person.",
        "confidence": 0.92
      },
      {
        "text": "Black males and white males share the same male biological characteristics.",
        "confidence": 0.9
      },
      {
        "text": "Male individuals possess emotional responses toward women occupying high-level leadership roles.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "Discrimination based on gender is more impactful than racial discrimination in my personal experience.",
        "confidence": 0.94
      },
      {
        "text": "Leadership positions in administration and decision-making are predominantly held by men.",
        "confidence": 0.93
      },
      {
        "text": "The speaker identifies primarily as a woman and secondarily as Black.",
        "confidence": 0.91
      },
      {
        "text": "There exists a hierarchy of oppression where gender-based marginalization takes precedence over race-based marginalization in this context.",
        "confidence": 0.89
      },
      {
        "text": "Men’s emotional reactions to female leaders are significant enough to influence systemic power dynamics.",
        "confidence": 0.86
      }
    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 81089,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/1/81089.jsonl",
    "turn_idx": 16,
