        "confidence": 0.92
      },
      {
        "text": "In the BBC interview, Shirley Chisholm stated that being a woman made running for president more difficult.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "Being a woman creates systemic disadvantages in political leadership contexts.",
        "confidence": 0.94
      },
      {
        "text": "Public statements by prominent figures like Chisholm carry weight as evidence of broader societal challenges.",
        "confidence": 0.91
      },
      {
        "text": "The difficulty of being a woman in politics is a legitimate and recognized concern worth highlighting.",
        "confidence": 0.89
      },
      {
        "text": "Audiences value direct testimony from political pioneers on gender-related barriers.",
        "confidence": 0.87
