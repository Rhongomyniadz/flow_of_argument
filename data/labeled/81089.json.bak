        "confidence": 0.94
      },
      {
        "text": "It is inappropriate to add additional burdens to Black people.",
        "confidence": 0.92
      },
      {
        "text": "The individual was raised in a foreign country during her younger years.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "Black individuals already face significant societal burdens.",
        "confidence": 0.93
      },
      {
        "text": "Being a woman adds unique challenges, particularly in societies lacking gender equity.",
        "confidence": 0.91
      },
      {
        "text": "Intersectionality of race, gender, and migration status compounds disadvantage.",
        "confidence": 0.9
      },
      {
        "text": "Growing up in a foreign country contributes to increased personal hardship.",
        "confidence": 0.87
      },
      {
        "text": "There exists a shared understanding between speaker and listener regarding systemic inequities.",
        "confidence": 0.85
