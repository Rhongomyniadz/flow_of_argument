    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/1/81089.jsonl",
    "turn_idx": 11,
    "turn_text": "Shirley Chisholm was the first African-American woman to be elected to Congress in 1968. Before entering formal politics, she had been a teacher. Both her parents were from the Caribbean.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
