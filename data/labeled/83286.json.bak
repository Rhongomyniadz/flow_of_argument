  {
    "episode_id": 83286,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83286.jsonl",
    "turn_idx": 17,
    "turn_text": "Because I wanted to write an interesting book. I have lots of time and lots of opportunities to talk about my ideas and to talk about myself. The Old Guard has never had its story told in a full book length format. And they deserve to have that story told. And it's a very long and rich story. So it needs book length treatment, not just an interview or a magazine article on Memorial Day or on Veterans Day. And I could tell from the interest that Americans had in the cemetery and in Arlington that their story would resonate, that the story, how they strive for perfection, how they hold themselves to the standard of the highest excellence for every single funeral, even if there's no one attending the funeral to honor their fallen comrades was a story that would resonate with Americans of all stripes.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
