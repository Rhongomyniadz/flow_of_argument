    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83286.jsonl",
    "turn_idx": 16,
    "turn_text": "This is your first book and it seems like most politicians usually write an autobiography or a policy book. Why did you choose to do something different?",
