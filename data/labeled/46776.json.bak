        "confidence": 0.9
      },
      {
        "text": "Telling young people that college is necessary for success is a widespread societal error.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "Financial responsibility should align with individual effort or academic engagement during college.",
