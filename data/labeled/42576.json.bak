  {
    "episode_id": 42576,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/2/42576.jsonl",
    "turn_idx": 38,
    "turn_text": "Yes, regarding testing, there's been several evolutions of that in the department across the time we've had the pandemic. At this point though, they're going to be using a local hospital and they just call and make an appointment and they can be tested whether or not they have symptoms. Also, I know there's.",
    "speaker_id": "SPEAKER_07",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
