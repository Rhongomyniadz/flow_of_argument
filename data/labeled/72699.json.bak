    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 72699,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72699.jsonl",
    "turn_idx": 49,
    "turn_text": "You know, that, in my mind, would be regulation. And I think if you do that, you're going to end up maybe forcing a solution which are going to be disrupting a lot of the economic benefit that comes from any endeavor. And I think the more you can have basic regulation in place in lieu of any additional regulation, try to have things that are maybe a little more along the line of the carrot rather than the stick, it's going to have more sustainability. And it's not going to further tax my new employer, the federal government, that sports a far different balance sheet and that spends a whole lot more money than what it takes in each year already, which would complicate the issue of how does it do more. So many people look to it and it can never probably be in a worse shape to try to do not only what it's currently doing, let alone more.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
