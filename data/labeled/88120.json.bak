  {
    "episode_id": 88120,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88120.jsonl",
    "turn_idx": 21,
    "turn_text": "Yeah, no, I couldn't agree more, which actually brings me to my next question, which would be if you were elected president of the United States as a libertarian, you know, essentially an independent third party. How are you going to work with Democrats and Republicans in Congress to get stuff done? Do you envision them just totally stonewalling you and not being able to get stuff done? Or how are you going to make that work?",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I strongly agree with the previous point.",
        "confidence": 0.95
      },
      {
        "text": "The speaker has a follow-up question about presidential governance under libertarian principles.",
        "confidence": 0.92
