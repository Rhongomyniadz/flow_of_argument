  {
    "episode_id": 88120,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88120.jsonl",
    "turn_idx": 20,
    "turn_text": "I'd certainly consider Larry and I've talked a little bit to Larry and I know he's running and he's running a strong campaign and I've talked to some other people too, some of them who are candidates and some who are not candidates yet. I think the delegates of the Libertarian Party really need to have a lot of influence here in terms of who the choice is. At the same time, when you run a ticket, the ticket has to be cohesive. You have to run a presidential candidate and a vice presidential candidate who get along, who are on the same wavelength and can put out the same message. If you have people at odds with each other, that creates a problem too. So it's important that we have someone who can get the message out to the American people and broaden the coalition. It's not just going to be die-hard libertarians that we have to reach out to. We have to reach out to all Americans.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
