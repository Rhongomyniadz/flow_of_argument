  {
    "episode_id": 88120,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88120.jsonl",
    "turn_idx": 18,
    "turn_text": "Hey, Andrew, yeah, thanks so much. Yeah, I mean, the fact that people are so riled up, I think is a good sign. I mean, people are interested. Some people are concerned because they know that we're going to take votes from people they took for granted. And that's not the way the American system is supposed to work. Let's put people out there on the ballot and give people choices. And that's what I'm doing.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
