    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72741.jsonl",
    "turn_idx": 6,
    "turn_text": "You had several funding challenges even before you started 39 unfunded programs plus new and existing calls for additional spending. How were you able to accomplish that, especially with that cushion of credit through the rural electric co-ops?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
