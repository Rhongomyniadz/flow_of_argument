  {
    "episode_id": 72741,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72741.jsonl",
    "turn_idx": 9,
    "turn_text": "It's both. It's the best we could do and I think it's adequate. I think it's a good bill.",
