  {
    "episode_id": 90754,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90754.jsonl",
    "turn_idx": 101,
    "turn_text": "Well, no, so this is the bumper of it. You mentioned about the Olympics. So we were supposed to, after they won, the Kathy Castor, who's the coach of our team, and the head of the Congressional Soccer Caucus, said, I've got a set up, Megan Rapinoe, and a couple of other members are going to come out, and we're going to do something with the Congressional Soccer Caucus. And so my daughters were like, all right, clear the decks. I'm skipping school. You tell me as soon as it happens. And then COVID hit and all of that sort of stuff died down. So hopefully we'll find some other opportunity. But it's at least an incentive for me to stay in shape long enough to stay on this soccer talk.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
