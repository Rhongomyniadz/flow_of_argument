  {
    "episode_id": 90754,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90754.jsonl",
    "turn_idx": 102,
    "turn_text": "That's right. That's right. Okay, so let's talk about your personal fandom. I'm someone who moved around as a kid, so I picked up teams from Baltimore, Ohio, ultimately kind of settled in Illinois. Now I've kind of rallied around a lot of the Chicago teams. Where are your allegiances and how are they sort of shaped throughout your life?",
    "speaker_id": "SPEAKER_05",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The speaker is asking about the listener's team allegiances.",
        "confidence": 0.98
      },
      {
        "text": "I am someone who moved around as a kid.",
        "confidence": 0.97
      },
      {
        "text": "I have rallied around a lot of the Chicago teams.",
        "confidence": 0.96
      },
      {
