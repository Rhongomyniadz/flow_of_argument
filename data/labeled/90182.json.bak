  {
    "episode_id": 90182,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90182.jsonl",
    "turn_idx": 16,
    "turn_text": "It absolutely is important. It's important because there are so many things that are important issues in New York state and that I often say this when we're talking about the Department of Health in New York state or the health budget would be a better way to say it because I am on the health budget work group. I say that that health budget is made of a thousand cubes and the disabilities cube is just one cube stuck over there in the corner. And unfortunately because I think partially because of that is why we're in such a tough situation that we are because in advocacy for what we would call traditional healthcare sort of dynamics That has eaten up a lot of the focus.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
