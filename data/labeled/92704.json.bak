  {
    "episode_id": 92704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92704.jsonl",
    "turn_idx": 41,
    "turn_text": "You know, Rockford is a very, very important part of our congressional district. We have an office here right downtown. And so with anybody listening to this needs our help on any federal government issue, whether it's Medicare, Social Security, the Veterans Administration, Immigration, Any of that, we have very, very good staff here who love to help people. And my job is to serve people. And we have 711,000 people who live in this congressional district. And the way I look at it is those are the people who are my bosses. I don't report to the President of the United States or the Speaker of the House or anybody else. I report to the people in Rockford and Winnebago County and the rest of the 13 counties outside of this region.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "My job is to serve people.",
        "confidence": 0.96
      },
      {
        "text": "Rockford is a very important part of our congressional district.",
        "confidence": 0.95
      },
      {
        "text": "Our staff in Rockford can assist anyone with federal government issues such as Medicare, Social Security, the Veterans Administration, or Immigration.",
        "confidence": 0.94
      },
      {
        "text": "There are 711,000 people living in this congressional district.",
        "confidence": 0.93
      },
      {
        "text": "We have an office downtown in Rockford.",
        "confidence": 0.92
      },
      {
        "text": "The people in Rockford, Winnebago County, and the other 13 counties are my bosses.",
        "confidence": 0.91
      }
    ],
    "assumptions": [
      {
        "text": "The speaker believes that constituents have ultimate authority over their political decisions.",
        "confidence": 0.94
      },
      {
        "text": "The speaker views themselves as accountable primarily to their constituents rather than institutional leaders.",
        "confidence": 0.92
      },
      {
        "text": "The effectiveness of public service depends on being accessible through local offices.",
        "confidence": 0.9
      },
      {
        "text": "People expect and deserve assistance with complex federal systems like Medicare and Social Security.",
        "confidence": 0.89
