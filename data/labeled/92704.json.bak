  {
    "episode_id": 92704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92704.jsonl",
    "turn_idx": 36,
    "turn_text": "One issue locally that we're following here at the Rockford Register Star is the impending increase of the minimum wage to $15 an hour. What would you say to small business owners who are a little bit concerned about how their small operation is going to be affected by that wage increase?",
