  {
    "episode_id": 92704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92704.jsonl",
    "turn_idx": 32,
    "turn_text": "What's something that has stood out to you when you've seen workers and business owners run their operation?",
