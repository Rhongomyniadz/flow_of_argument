  {
    "episode_id": 92704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92704.jsonl",
    "turn_idx": 33,
    "turn_text": "I would say the one that I can't get out of my mind is there was a home care nurse and she was married to a guy who worked in one of the cities and they had two kids and I asked her what she and her family did for fun and she said they have cable television. And I said, oh, you don't like to go to the movies. And it's not a matter of not liking to go to the movies. It's that we can't afford. By the time you buy the tickets and buy soda and popcorn, it's too expensive. And here we're two people working full time, working hard and with hard tough jobs. And it just shows you the struggles that some people go through.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
