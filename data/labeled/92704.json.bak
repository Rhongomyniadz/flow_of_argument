  {
    "episode_id": 92704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92704.jsonl",
    "turn_idx": 31,
    "turn_text": "Yeah, so, and I've been doing this now for going on seven years, but it's, I job shadow people. It's basically what it is. We call it sherry on shift because we like the alliteration and my name happened to be sherry and, you know, I do shift work. So, but I just go into businesses all over our region and work shoulder to shoulder with people and learn about what they do to make a living, you know, how hard so many people work and a lot of times how the struggles that people go through.",
    "speaker_id": "SPEAKER_00",
