  {
    "episode_id": 80518,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80518.jsonl",
    "turn_idx": 39,
    "turn_text": "You have said that you consider the Democratic majority in the House to be a fragile majority. Do you still hold that view? Do you perceive a seismic cultural shift underway that might cement it for much longer than majorities have existed in the past? Or as chair of the D-Trip, do you operate by Sherrod Brown's maxim? You're either running scared or running unopposed?",
