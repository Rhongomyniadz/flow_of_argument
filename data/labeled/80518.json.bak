  {
    "episode_id": 80518,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80518.jsonl",
    "turn_idx": 47,
    "turn_text": "Well, thank you so much, Sherry, for coming on the show. We end every episode of Burn the Boats with the same question, what is the bravest decision that you've ever been a part of?",
    "speaker_id": "SPEAKER_01",
