  {
    "episode_id": 80518,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80518.jsonl",
    "turn_idx": 2,
    "turn_text": "You can't be one of a Democrat that says, oh, that's rural America. We're going to write that off. They're just going to vote Republicans. You don't do that. You go in, even if it's uncomfortable. You go in and you show up and you listen to people.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Some Democrats say they will write off rural America.",
        "confidence": 0.95
      },
      {
        "text": "Writing off rural America is unacceptable behavior.",
        "confidence": 0.92
      },
      {
        "text": "Listening to rural people is necessary when engaging with them.",
        "confidence": 0.91
      },
      {
        "text": "Rural Americans are expected to vote Republican.",
        "confidence": 0.9
      },
      {
        "text": "Engaging with rural communities requires showing up physically.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "Democratic politicians have a moral obligation to engage with all constituents, including rural voters.",
        "confidence": 0.94
      },
      {
        "text": "True political connection requires personal presence and active listening.",
        "confidence": 0.93
      },
      {
        "text": "Discomfort during engagement does not justify avoiding dialogue.",
        "confidence": 0.9
      },
      {
        "text": "Rural Americans deserve representation regardless of their voting tendencies.",
        "confidence": 0.89
      },
      {
        "text": "Political legitimacy depends on inclusive participation rather than strategic neglect.",
        "confidence": 0.87
      }
    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 80518,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80518.jsonl",
    "turn_idx": 3,
    "turn_text": "I'm Ken Harbaugh, and this is Burn the Boats, a podcast about big decisions. On Burn the Boats, I interview political leaders and other history makers about choices they confront when failure is not an option. A quick note before we dive into the episode, Sherry and I recorded this conversation about two months ago, and at the end of the interview she takes a moment to pay tribute to Congressman John Lewis when we spoke he had passed away just a few days before. My guest today, Congresswoman Sherry Bustos, is the chair of the DCCC, the Democratic Congressional Campaign Committee, which is working to elect other Democrats to the House of Representatives. She's been called the future of the Democratic Party, one of the only Democrats representing Illinois from outside Chicagoland. In 2016, she won her district by more than 20 points, a district that voted for Donald Trump. Sherry, welcome to Burn the Boats, it's great to have you.",
