  {
    "episode_id": 80518,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80518.jsonl",
    "turn_idx": 25,
    "turn_text": "Like Joe Biden, you have also taken your share of incoming for your efforts to reach out to Trump voters, to understand them to empathize. And that speaks to a real tension within the party today between those like you who are making that appeal and those who fear it will dilute or water down the ambitions of progressives to affect real systemic change. How do you answer that charge?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
