    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80518.jsonl",
    "turn_idx": 45,
    "turn_text": "Do you think those efforts are going to be enough to overcome the overt voter suppression and intimidation that we are seeing day after day?",
