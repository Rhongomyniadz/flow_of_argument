  {
    "episode_id": 72487,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72487.jsonl",
    "turn_idx": 75,
    "turn_text": "You know, Tom, the fact that I already have 10 sponsors on the Republican side and five on the Democratic side is promising. I also say I'm a 20-year military veteran. I fought in two wars in Iraq and Afghanistan. And most importantly, I have six children, so I do not scare easy. I think it's important that we have these new ideas, if you will. And once again, this bill was three pages. It's not intended to solve the immigration crisis. It is intended to move this country, have one step. Imagine if the 118th Congress can do one thing, and then all of a sudden, then maybe we can take a second step and a third step. So it tackles it from that approach.",
    "speaker_id": "SPEAKER_19",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The speaker is a 20-year military veteran.",
        "confidence": 0.98
