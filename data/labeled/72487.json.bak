        "confidence": 0.83
      }
    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 72487,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72487.jsonl",
    "turn_idx": 132,
    "turn_text": "Amicia, do you believe the No Labels Party, I'm not sure what we're going to call it at this point, but the No Labels Group, do you think this is a real threat to Democrats? You think Senator Manchin, you think former Governor Huntsman, you think they're really going to run for the presidency?",
