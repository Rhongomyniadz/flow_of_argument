  {
    "episode_id": 84417,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84417.jsonl",
    "turn_idx": 12,
    "turn_text": "Turn in the page on the rundown. Friends, ladies and gentlemen, ruminators near and far. Thanks so much. As always, you humble us with your presence and your kindness in sharing time. It's the Morning Show with Preston Scott for the 5,143rd occasion. It's Grant Allen over there in Studio 1A. I'm here in Studio 1B and I remind you, I am voted on twice every year. That's exactly right. That's how that works. We are thrilled to have back on the program with us. Busy schedule, busy calendar, but making time. U.S. Congresswoman Kat Kamik, Florida's third district. Kat, how in the world are you?",
    "speaker_id": "SPEAKER_07",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "This is the 5,143rd occasion of The Morning Show with Preston Scott.",
