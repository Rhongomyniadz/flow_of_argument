    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 84417,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84417.jsonl",
    "turn_idx": 21,
    "turn_text": "No, that's, I appreciate that. And I want to be accurate. Let me see here.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I aim to be accurate in my response.",
        "confidence": 0.95
      },
      {
        "text": "I appreciate your input.",
        "confidence": 0.92
      },
      {
        "text": "I am currently reviewing something before responding.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "Accuracy is valued in this interaction.",
        "confidence": 0.94
      },
      {
        "text": "The interlocutor’s contribution deserves acknowledgment.",
        "confidence": 0.9
      },
      {
        "text": "Pausing to verify information is appropriate behavior.",
        "confidence": 0.89
      },
      {
