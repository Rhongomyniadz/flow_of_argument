    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83280.jsonl",
    "turn_idx": 33,
    "turn_text": "What are some of those things that Congress should be doing on",
    "speaker_id": "SPEAKER_08",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
