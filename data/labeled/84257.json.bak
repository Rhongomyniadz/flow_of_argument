        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "The speaker believes that legal accountability depends on institutional processes like committee investigations.",
        "confidence": 0.93
      },
      {
        "text": "The public expects political leaders to uphold the rule of law even under scrutiny.",
        "confidence": 0.9
      },
      {
        "text": "Document requests are a credible and necessary method for uncovering evidence of wrongdoing.",
        "confidence": 0.89
      },
      {
