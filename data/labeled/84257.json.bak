  },
  {
    "episode_id": 84257,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84257.jsonl",
    "turn_idx": 16,
    "turn_text": "Look, nobody knows where this thing is going. It could go in a lot of directions. And, you know, the standard for impeachment is high crimes in misdemeanors. And there's certainly serious allegations of those. I like to think that all of those who have taken an oath of office take seriously the rule of law and that we have to deal in a solemn way with threats to the rule of law, obstruction of justice, abuse of power and corruption. And these are the categories of things we're looking at, and the Judiciary Committee has issued more than 80 document requests to try to find out what's been going on in the administration on a whole series of things from emoluments clause and foreign payments to campaign finance violations and hush money, cover up payments to abuse of the security clearance process. The Oversight Committee is undertaking similar kinds of inquiries. And nobody knows right now where it's going to all lead",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
