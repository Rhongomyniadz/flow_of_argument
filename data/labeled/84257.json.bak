        "confidence": 0.96
      },
      {
        "text": "We need to take care of our democracy.",
        "confidence": 0.95
      },
      {
        "text": "People who do not value democracy should not be present at this gathering.",
        "confidence": 0.94
      }
    ],
    "assumptions": [
      {
        "text": "The health of the republic depends on active civic engagement by participants.",
        "confidence": 0.93
      },
      {
        "text": "Being present at political events like this reflects a commitment to democratic values.",
        "confidence": 0.92
      },
      {
        "text": "Democracy requires vigilance and institutional responsibility.",
        "confidence": 0.91
      },
      {
        "text": "There is a moral obligation to protect democratic institutions.",
        "confidence": 0.9
      },
      {
        "text": "Audience members share basic agreement on the importance of democracy.",
