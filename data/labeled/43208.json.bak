    ],
    "assumptions": [
      {
        "text": "The return of Major League Baseball reflects broader societal confidence.",
        "confidence": 0.92
      },
      {
        "text": "Round tables hosted by Pat are credible and worth engaging with.",
        "confidence": 0.9
      },
      {
        "text": "Everyday people's confidence in society can be influenced by major cultural events like MLB returning.",
        "confidence": 0.89
      },
