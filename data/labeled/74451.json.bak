  {
    "episode_id": 74451,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/4/74451.jsonl",
    "turn_idx": 2,
    "turn_text": "So what do you see as the biggest differences between Democrats and Republicans right now that might prevent a stopgap agreement before this weekend?",
