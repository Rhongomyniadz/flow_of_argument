    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There are significant differences between Democrats and Republicans at present.",
        "confidence": 0.95
      },
      {
        "text": "These differences may hinder a temporary agreement before this weekend.",
        "confidence": 0.92
      },
      {
        "text": "The speaker is seeking input on identifying those key differences.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "A stopgap agreement is both desirable and feasible within the current timeframe.",
        "confidence": 0.94
      },
      {
        "text": "The speaker believes the interlocutor has relevant insight into political party dynamics.",
        "confidence": 0.91
      },
      {
        "text": "Differences between parties are primarily policy-based rather than procedural or strategic.",
        "confidence": 0.87
      },
