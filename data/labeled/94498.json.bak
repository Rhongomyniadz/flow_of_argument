  {
    "episode_id": 94498,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94498.jsonl",
    "turn_idx": 47,
    "turn_text": "So, look, I think I'm actually in line with where the, you know, where Arizona is. We are a very interesting state, you know, we have a very libertarian street to us. Yes, some of our values are conservative, some of our values are considered liberal, but overall what we really value in Arizona is people being straightforward, right? And this is where it has been killing someone like Kirsten, and the reason why she is faltering, it's not because she's voting against the values of Arizonans, it's because she has, you know, been deceptive. She has avoided conversations. She has not been honest and straightforward with, with Arizonaans. Now, people may say whatever they want about me. And by the way, every time any Arizonaans runs in Arizona, they're always a liberal.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Arizona has a libertarian streak.",
        "confidence": 0.95
      },
