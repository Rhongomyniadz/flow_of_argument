    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There exists a specific emotional experience associated with someone arriving precisely when needed.",
        "confidence": 0.97
      },
      {
        "text": "Uber provides services beyond transportation, including food delivery.",
        "confidence": 0.95
      },
      {
        "text": "Uber enables people to be present during meaningful personal moments.",
        "confidence": 0.94
      },
      {
        "text": "Being physically present at critical life moments can improve one's emotional state.",
