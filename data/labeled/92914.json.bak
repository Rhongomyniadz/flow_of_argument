  {
    "episode_id": 92914,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92914.jsonl",
    "turn_idx": 6,
    "turn_text": "So sticking first with your public audience, the American public, what is the impact that you hope that seeing the actual images, and I suspect for a number of people, seeing images they perhaps have seen before, and for the first time realizing that they were produced by the Russian Internet Research",
