  {
    "episode_id": 83237,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83237.jsonl",
    "turn_idx": 20,
    "turn_text": "Well, you are a new member to the Senate. Can you tell us a little bit about your story and your life before you are a senator?",
    "speaker_id": "SPEAKER_06",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
