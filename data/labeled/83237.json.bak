        "text": "The addressee is a new member of the Senate.",
        "confidence": 0.97
      },
      {
        "text": "The addressee has a personal history prior to becoming a senator.",
        "confidence": 0.95
      },
      {
        "text": "The speaker wants the addressee to share their background story.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Personal background stories are relevant to understanding someone’s qualifications or perspective in the Senate.",
        "confidence": 0.94
      },
      {
        "text": "The addressee is willing and able to discuss their past experiences.",
        "confidence": 0.9
      },
      {
        "text": "Public officials should be personally relatable to the public through shared narratives.",
        "confidence": 0.89
