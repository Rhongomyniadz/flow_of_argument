        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "The Supreme Court has the authority to dismiss cases brought before it.",
        "confidence": 0.94
      },
      {
        "text": "The Biden administration believes the legal basis for the case is flawed or unjustified.",
        "confidence": 0.91
      },
      {
        "text": "A change in administrative interpretation of 'public charge' constitutes a significant enough shift to warrant judicial review.",
        "confidence": 0.89
      },
      {
