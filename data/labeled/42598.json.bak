  {
    "episode_id": 42598,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/2/42598.jsonl",
    "turn_idx": 111,
    "turn_text": "You know, I think the modeling numbers will continue to adjust based on how well we're doing our social distancing and how rapidly this virus is spreading. So it's not an exact point in time. We're going to go back and look at that curve when we have data. But the number of cases, as we know, most of the cases that are out there, it's really important to point out, we're not counting. So even though we're counting this number of cases, 80% or more. are not being tested. So most of the cases out there are outpatients being diagnosed clinically based on their symptoms and they're staying at home. Even a good number of cases within nursing homes. Again, not every nursing home person is being tested. There's a couple tested and then they're assumed to have the same disease spreading. So that's a very important part of that.",
    "speaker_id": "SPEAKER_20",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
