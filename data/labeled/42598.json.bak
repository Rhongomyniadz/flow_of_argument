  {
    "episode_id": 42598,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/2/42598.jsonl",
    "turn_idx": 95,
    "turn_text": "Yeah, parades are not a good thing. Look, you can go back in history, and I know we've talked about this before, but when you go back 1918, the pandemic then, one of the things that Philadelphia got wrong was they went ahead and held this big war bond parade. They were in the midst of World War I. They had the parade. People look back on that and think that that was one of the main things they did wrong is people coming together. When you have a parade, it's not just the people in the parade, it's people who are going to watch the parade. Somebody's got to watch the parade, so they're congregating on the side. So I don't know the facts about the parade, but by and large, parades would not be something that should be happening.",
    "speaker_id": "SPEAKER_12",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
