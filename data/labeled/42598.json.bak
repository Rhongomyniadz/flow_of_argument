  {
    "episode_id": 42598,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/2/42598.jsonl",
    "turn_idx": 74,
    "turn_text": "Good afternoon, Ben Schwartz with WCPO and Cincinnati. Lieutenant Governor Houston, we have been getting a lot of questions sent in to WCPO about people wondering about their unemployment claims. I know you've addressed a lot of these issues already, but one of our viewers wants me to ask about what advice you have for someone who's been having a lot of trouble getting their claims through ODJFS. This particular person has been in touch with their state representative and was told that their problem would be solved immediately but has still made no progress. We know these are unprecedented times but a lot of people are still struggling and I just want to know if you have a message for someone like that who was told their problem would be solved but hasn't heard back.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "It is currently good afternoon.",
        "confidence": 0.98
