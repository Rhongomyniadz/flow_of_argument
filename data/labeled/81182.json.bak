  {
    "episode_id": 81182,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/1/81182.jsonl",
    "turn_idx": 3,
    "turn_text": "You've been a champion of Buffalo's revitalization from the days when you joined as council member and the assembly down in New York state fighting for all the good stuff you brought back to Buffalo. Can you talk about why you thought the revitalization of Buffalo was so core to this area?",
    "speaker_id": "SPEAKER_01",
