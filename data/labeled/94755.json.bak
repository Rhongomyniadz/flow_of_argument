  {
    "episode_id": 94755,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94755.jsonl",
    "turn_idx": 99,
    "turn_text": "Here's how it got at the data. In 2022, we had a result that was quite contrary to what I thought, because I was looking at the polling data. close to the election. My background, I started out at a place called the Boston Consulting Group, very analytically oriented. We basically went back and looked at each state and tried to figure out what caused us to lose.",
    "speaker_id": "SPEAKER_14",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
