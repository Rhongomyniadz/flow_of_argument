    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Today's date is Tuesday, February 27th.",
        "confidence": 0.97
      },
      {
        "text": "An Alabama court has ruled that a person can be held legally responsible if frozen embryos are destroyed.",
        "confidence": 0.96
      },
      {
        "text": "Ari Shapiro is the host of this broadcast.",
        "confidence": 0.95
      },
      {
        "text": "The source of this information is NPR.",
        "confidence": 0.94
      },
      {
        "text": "This legal precedent might apply beyond Alabama to other states with personhood statutes that define life and rights as beginning at conception.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "The audience expects accurate and timely news reporting from NPR.",
        "confidence": 0.91
      },
      {
        "text": "Legal responsibility for destruction of frozen embryos implies recognition of embryos as persons under the law.",
        "confidence": 0.9
      },
