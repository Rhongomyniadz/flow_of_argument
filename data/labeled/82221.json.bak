    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 82221,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82221.jsonl",
    "turn_idx": 13,
    "turn_text": "We have some patients that are in active treatment and on medications that is not safe for them to stop their treatment at this point. So we are continuing with those patients. We have put on hold frozen embryo transfer. We are hoping to have protocols and consents in place that would allow us to move forward.",
