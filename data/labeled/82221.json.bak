  {
    "episode_id": 82221,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82221.jsonl",
    "turn_idx": 12,
    "turn_text": "The Alabama ruling is putting hopeful parents in limbo and doctors who provide IVF like Dr. Malizia on shaky legal ground. There are many questions and not a lot of answers at this point. Like what happens if an embryo doesn't materialize into a pregnancy?",
