    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84250.jsonl",
    "turn_idx": 121,
    "turn_text": "Well, that's the great thing about the First Amendment and our Constitution. Anybody can believe whatever they want to believe. But they should read Mary Trump's book about what Donald Trump has done to their family. And they should read the report of the January 6 Select Committee when it comes out.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The First Amendment protects freedom of belief.",
        "confidence": 0.97
      },
      {
        "text": "People are free to believe whatever they want.",
        "confidence": 0.95
      },
      {
        "text": "Mary Trump wrote a book about Donald Trump's actions toward his family.",
        "confidence": 0.92
      },
      {
        "text": "The January 6 Select Committee will release a report.",
        "confidence": 0.9
