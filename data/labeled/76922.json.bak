    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/6/76922.jsonl",
    "turn_idx": 8,
    "turn_text": "Let's talk a little bit about the year that you had in the midst of all of this, you were running a campaign. What's it like to campaign for the House of Representatives in the middle of the worst pandemic since 1918?",
