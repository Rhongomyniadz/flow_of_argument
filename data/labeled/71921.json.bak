  {
    "episode_id": 71921,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71921.jsonl",
    "turn_idx": 229,
    "turn_text": "It's not even just so much as a a grift as much as it is reality One of the great things and like this is probably the most popular thing to say but one of the one of the great things in my mind about doge Is for 30 years everyone who has a conversation about the 10 20 30 35 36 trillion dollars in debt is always said like oh Well, if we can't just eliminate the waste fraud and abuse. It's a good place to start or, oh, you know, if we don't have a war with the Ukraine type situation, like that would all be a balanced budget. The truth is that you could shut down our government tomorrow and not reopen it until 2036 and still not have a balanced budget, even if you had four and a half percent growth in the economy. That's the truth.",
    "speaker_id": "SPEAKER_10",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
