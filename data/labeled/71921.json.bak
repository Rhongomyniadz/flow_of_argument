  {
    "episode_id": 71921,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71921.jsonl",
    "turn_idx": 452,
    "turn_text": "And that's what you've done here, which, you know, look, I was a part of a lot of these things over the years. And I remember in 20, I think it was a 2011 with Barack Obama, and I remember John Boehner did his damn just to try to figure out if there was a way that we could get that administration at a time would have been very easy, much easier than it is now, to sort of address those entitlement things that were now becoming enveloped in. And ultimately, they're like, no. No, we're not interested in it. And you know, you mentioned the 2017 again, and now we get to a point where there's a wholesale conversation, not just with what you're doing in the budget process, but with Doge. Yes. And we're having",
    "speaker_id": "SPEAKER_10",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
