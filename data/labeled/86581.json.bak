  {
    "episode_id": 86581,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86581.jsonl",
    "turn_idx": 21,
    "turn_text": "behind what they consider the immunities in the Communications Decency Act. And so we have clarified our intent there, and then made sure that not only can prosecutors use our sex trafficking statutes, and we've strengthened those, but really created a new crime in the prostitution statutes that says that it is criminal, in fact, for the promotion or facilitation of prostitution, and in reckless disregard of sex trafficking. We lowered the mens rea of reckless disregard, which actually makes it easier for the prosecutors to go after these nefarious websites. So it's a very, as I said, landmark piece of legislation that's tough on crime, wonderful justice for our victims, and does finally clarify the Communications Decency Act. That was passed back in 1996.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
