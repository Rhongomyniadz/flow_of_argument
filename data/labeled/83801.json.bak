        "text": "Meetings are scheduled every 15 minutes.",
        "confidence": 0.95
      },
      {
        "text": "The meetings are part of the problem.",
        "confidence": 0.92
      },
      {
        "text": "People attend multiple consecutive meetings without breaks.",
        "confidence": 0.9
      },
