  },
  {
    "episode_id": 83801,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83801.jsonl",
    "turn_idx": 277,
    "turn_text": "The economic term is rent-seeking, but shocking how much of Washington DC is trying to almost put up barriers to the next best thing. And that's actually part of what we're going to talk about. And so you go through this sort of world where, what happens if you're scheduled constantly? So your first meeting's at 7 a.m., your last one's at 9.30 at night. When do you read? When do you learn that the way you've been doing something, the way government does something, the way You know, regulated industry does something is now on a date because of a breakthrough, because of a cure for disease, a new type of technology, new types of sensors that are available. And there becomes one of the things I think is a real fragility of the way politics and Congress works is there's not a lot of time to read and think.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
