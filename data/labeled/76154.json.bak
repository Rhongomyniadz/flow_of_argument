  {
    "episode_id": 76154,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/6/76154.jsonl",
    "turn_idx": 51,
    "turn_text": "Part of what was amazing was that your tax cuts and jobs act, the nonpartisan congressional budget office said, it reduced federal tax rates for families across every income level, while actually increasing the share of taxes paid by the top 1% of American households. When liberals attack it for not being fair, in fact, is you are helping virtually everybody and making it more fair. And at the same time, you're creating economic growth.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
