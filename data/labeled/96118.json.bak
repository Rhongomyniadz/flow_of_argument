    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/6/96118.jsonl",
    "turn_idx": 26,
    "turn_text": "Well, you know, everybody wants to know. And I'm in a discussion daily online and offline about what's going to happen. So, you know, where where are you? If if it were if the vice presidency were offered to you, would you accept it?",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
