  {
    "episode_id": 96489,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/6/96489.jsonl",
    "turn_idx": 2,
    "turn_text": "So first and foremost, Deborah, you most recently ran for the US Senate seat in North Carolina in 2016. Correct. So what have you been up to since that race?",
