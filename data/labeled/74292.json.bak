  {
    "episode_id": 74292,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/4/74292.jsonl",
    "turn_idx": 27,
    "turn_text": "I really was taken by the way that she broke down how human failings or human realities as they really are can impact our technology in ways that harm us, that with in pivotal functions, meaning as we decide who is benefiting from job opportunities, from COVID treatments, et cetera, that we need to be so mindful of this technology that is thriving and that is enabling us to succeed and continue to live our lives during the pandemic can also be so limiting if we're not mindful of the biases that are being embedded within.",
