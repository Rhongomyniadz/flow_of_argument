  {
    "episode_id": 89163,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/9/89163.jsonl",
    "turn_idx": 42,
    "turn_text": "I went to your house. My most vivid memory was your wife made two pies. And of course I told everybody I don't eat sweets. And there were two pies there. And I went ahead and decided to have a little bit of one. And then I had half of it. And then I ate the rest of it. And then your wife, I'll never forget to look on her face. She said, well, I mean, we have two. I think she was going to donate one to church or something. She says, you're welcome to have the other one too. So I had that for breakfast. And I thought, One of these days, Jim is going to leave Washington. He's going to be a German farmer. He's going to be a volunteer wrestling coach. And here you are. I mean, I'm at you in 2010. So I would have lost a bet on whether or not you would have stuck it out and stayed in Washington. I know there are times you have thought about going back home. There has to be.",
    "speaker_id": "SPEAKER_06",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
