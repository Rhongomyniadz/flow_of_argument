  {
    "episode_id": 91649,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/1/91649.jsonl",
    "turn_idx": 21,
    "turn_text": "What are some of the biggest transportation challenges for the state of",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [],
