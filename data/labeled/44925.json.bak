    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 44925,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/4/44925.jsonl",
    "turn_idx": 15,
    "turn_text": "Congressman, while most definitely I am as strong a conservative as can possibly be on the topic of border security, I do have to ask you, and I'm a little concerned about this, it's always been the prerogative of the executive branch. exactly what tactics they are going to use on the border. Their instructions have been very clear from Congress. The law is the law and ironically that law has not changed for years and it's, you know, the law regulating who can come and who cannot come into this country and the way that entry is allowed. Clearly the Biden administration has been ignoring the law. But does the legislative branch have the authority under the Constitution to do what you're trying to do? I'm a little concerned about that.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I am a strong conservative on the topic of border security.",
        "confidence": 0.97
      },
      {
        "text": "The law governing immigration entry into the U.S. has not changed for years.",
        "confidence": 0.96
      },
      {
        "text": "Congress has provided clear instructions regarding border policy.",
        "confidence": 0.94
      },
      {
        "text": "It has always been the prerogative of the executive branch to decide on tactics used at the border.",
        "confidence": 0.92
      },
      {
        "text": "The Biden administration has been ignoring the law.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "The legislative branch lacks constitutional authority to dictate specific enforcement tactics to the executive branch.",
        "confidence": 0.93
      },
      {
        "text": "The separation of powers doctrine requires clear boundaries between congressional mandates and executive discretion.",
        "confidence": 0.91
      },
      {
        "text": "The speaker views the rule of law as central to legitimate governance.",
        "confidence": 0.89
      },
      {
        "text": "The speaker trusts the legal framework established by Congress as authoritative and stable over time.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive"
  },
