    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Medicaid spending per beneficiary has been below the rate of medical inflation for many years.",
        "confidence": 0.97
