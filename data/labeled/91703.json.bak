  {
    "episode_id": 91703,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/1/91703.jsonl",
    "turn_idx": 133,
    "turn_text": "The worst advice I would get when I was starting out was to conform to something that was hot at the moment. Focus on the thing that makes you unique, that makes you different. I mean, really lock on that thing and it may take longer because it takes longer for something new or something different. But lock into that thing and I promise like in the long run, you'll start to stick out and people start to say, no, I want that thing. They've been doing that consistent thing. So they know to go to that thing. And so I would say be yourself. That's the main message that I want to put out there.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
