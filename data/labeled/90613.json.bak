        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "There is a gendered double standard in political scrutiny regarding candidates' motivations.",
        "confidence": 0.95
      },
      {
        "text": "The public assumes women in politics have ulterior motives more readily than men.",
        "confidence": 0.93
      },
      {
        "text": "The speaker sees themselves as having insider knowledge of 'her' intentions due to personal acquaintance.",
        "confidence": 0.91
      },
      {
        "text": "Asking 'why is she running?' reflects underlying skepticism toward female leadership.",
        "confidence": 0.89
      },
      {
