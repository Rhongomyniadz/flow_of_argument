  },
  {
    "episode_id": 88436,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88436.jsonl",
    "turn_idx": 14,
    "turn_text": "Well, I don't. And at this point in time, there have been problems in the course of negotiation that has worsened that situation. But that doesn't mean I can't work with him. Provided we get sufficient guardrails to make sure that we're not going to keep doing the same thing we've been doing for the entire 14 years that he's been in leadership in Congress. It epitomizes the problem. Why should we he'll pass our vote for leadership that is echoing Nancy Pelosi's style of governance in the house",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The individual has been in leadership in Congress for 14 years.",
        "confidence": 0.95
      },
      {
        "text": "There have been problems in the course of negotiation that have worsened the situation.",
        "confidence": 0.92
