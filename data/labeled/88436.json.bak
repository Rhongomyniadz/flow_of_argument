  },
  {
    "episode_id": 88436,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88436.jsonl",
    "turn_idx": 7,
    "turn_text": "His opponents would like to see McCarthy just stand down, but he says that is not happening. I'm not going anywhere. Not going anywhere. One of those voting against Kevin McCarthy is Charlotte Congressman Dan Bishop. Bishop says McCarthy is part of the old way of doing things in Washington and that needs to change. Bishop wants a lot of changes in such things as how votes are handled, how bills can be amended, how much time is allowed for debate, how committees are run, and it is the House Speaker who sets those rules. So that's some of what the debate over Kevin McCarthy is about and Congressman Dan Bishop is right in the center of all of that and he joins me now on Charlotte at six. Congressman, you said you want a leader in the house who will make change for the American people and obviously you don't think Kevin McCarthy is that guy. Why not?",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The speaker believes that Congressman Dan Bishop wants a leader in the House who will make change for the American people.",
        "confidence": 0.97
      },
      {
        "text": "The speaker believes that Congressman Dan Bishop does not think Kevin McCarthy is that kind of leader.",
        "confidence": 0.96
      },
      {
        "text": "The speaker is asking Congressman Dan Bishop why he does not believe Kevin McCarthy is a leader who will make change for the American people.",
        "confidence": 0.94
      }
    ],
    "assumptions": [
