        "confidence": 0.91
      },
      {
        "text": "The speaker views current congressional operations as serving lobbyists and special interests rather than the American public.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "True commitment to policy issues requires measurable progress over time.",
        "confidence": 0.95
      },
      {
