  {
    "episode_id": 44975,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/4/44975.jsonl",
    "turn_idx": 32,
    "turn_text": "How do you think that the Republican Party can make sure that they're recruiting the right candidates? Well, I think",
