  {
    "episode_id": 44975,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/4/44975.jsonl",
    "turn_idx": 6,
    "turn_text": "Okay, so let's just dive right in. Your part of our right leaders network initiative is one of our advisory council members means that you served in state office before running for the congressional seat that you have now. And you currently serve as a mentor to candidates who are in the very shoes that you were once in, not too long ago. So what initially made you want to get involved and run for the state house back in the day before you served in the US house?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
