    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 44975,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/4/44975.jsonl",
    "turn_idx": 7,
    "turn_text": "Well, I think it comes down to a couple of things. I was a journalist for more than a decade before I decided to get into the crazy world of politics. I was a morning news anchor, so I had a chance to really interview a lot of policymakers, a lot of politicians. Saw really what was good policy, a lot of really bad policy, and the impact that that truly had on families. So that's kind of what inspired me to step up and run. I saw that there was an opportunity to really stop talking about it and actually start doing something about it. And so when I had that opportunity to run for the state legislature, I took it. I firmly believe I'm a mom too. and 11 and nine year old. And I think about being a good advocate for them, it's being their parent, but it's also making sure that someone's there making good decisions on their behalf. And so that's why I decided that I was gonna step up and run for the state legislature and then obviously that kind of led me on my path here to run and serve in Congress.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
