  {
    "episode_id": 84194,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84194.jsonl",
    "turn_idx": 6,
    "turn_text": "Now both the state of Florida and the federal government are investigating the September 15th attack, and there was some concern expressed as a reason for that, that the feds might not be able to bring sufficient charges against the suspect. At the time, he was just facing firearm charges. He's now been charged with attempted assassination, which could give him a life sentence in the federal system. The fact that charges have been upgraded, does that give you any effect or confidence in how federal prosecutors are handling the West Palm Beach attempt?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
