  {
    "episode_id": 84194,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84194.jsonl",
    "turn_idx": 9,
    "turn_text": "So the FBI will have information, not just about, the Secret Service is the best source of information for us about the security detail itself, about the planning and the preparation, and what happened in the days leading up to these two attacks and the response thereto. The FBI is responsible for leading the criminal investigation. So the FBI will have information related to who these assailants are, what led them to this place, who they may have been communicating with, what types of things were they involved in, any groups, any contact. So that's a key part in understanding where these threats are coming from and whether there is anybody else who needs to be investigated, needs to be prosecuted, that information is all with the FBI and their criminal investigators. So we are very hopeful. It is very important for us to get information from the FBI as well because that's what's going to give us the context about who these people are and be hopeful in ensuring that we're doing everything possible to keep this from happening again.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
