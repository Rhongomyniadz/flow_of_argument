    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "As of this morning, the Democratic lead in the House appears to be approximately +35 to +36 seats.",
        "confidence": 0.96
      },
      {
        "text": "The outcome of the midterm elections likely resulted in a shift toward the Democrats in the House.",
        "confidence": 0.94
      },
