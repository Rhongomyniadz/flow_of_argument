      },
      {
        "text": "The speaker believes that Congressman Lewis's issues are personally relevant to the listener.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "The listener has experience collaborating with Congressman Lewis.",
        "confidence": 0.94
      },
      {
        "text": "Congressman Lewis's issues have moral significance and deserve individual engagement.",
        "confidence": 0.91
      },
      {
