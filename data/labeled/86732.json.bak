  },
  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 61,
    "turn_text": "I'm not so sure, but I have this strange feeling that in American politics, not just at the national level, but even the local level, We have men and women emerging that want to be elected to a responsible position, but they don't believe in government. They really don't believe in service. You have people who love the world, but they don't like people. And sometimes I feel like maybe we should conduct nonviolent workshops with local and national political leaders.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There are individuals in American politics at both national and local levels who seek election to positions of responsibility.",
        "confidence": 0.92
      },
      {
        "text": "These individuals do not believe in government.",
        "confidence": 0.87
      },
      {
        "text": "These individuals do not believe in public service.",
        "confidence": 0.86
      },
      {
        "text": "I am uncertain about my assessment.",
        "confidence": 0.85
      },
      {
        "text": "Some political figures love the idea of the world or humanity but dislike actual people.",
        "confidence": 0.84
      },
      {
        "text": "Nonviolent workshops could be conducted with local and national political leaders.",
        "confidence": 0.8
      }
    ],
    "assumptions": [
      {
        "text": "Belief in government and belief in public service are necessary components of legitimate political leadership.",
        "confidence": 0.91
      },
      {
        "text": "The disconnection between loving humanity and disliking people reflects a moral failing in political actors.",
        "confidence": 0.89
      },
      {
        "text": "Political leaders' personal attitudes toward people influence their effectiveness in governance.",
        "confidence": 0.87
      },
      {
        "text": "Nonviolent workshops are a viable method for addressing systemic issues in political culture.",
        "confidence": 0.85
      },
      {
        "text": "Audience members value ethical integrity in political leadership.",
        "confidence": 0.83
      }
    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 62,
    "turn_text": "Well, I noticed when I was reading this comic book from the 50s, it says here in the back, how the Montgomery Method works. The second thing is much harder. God loves your enemy, too, and that makes him important to you to see your enemy as a human being. You have to stop seeing him as your enemy.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
