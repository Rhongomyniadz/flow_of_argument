  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 53,
    "turn_text": "Well, I think here in America, we got to learn to live together. We got to leave this little piece of real estate that we call America. A little cleaner, a little more peaceful, and a little more loving. Leave people with a sense of happiness. Why do we have to be so mean to each other? This is positive, first just to respect all human beings. We got to stop spending so much of our limited resources on bombs and missiles and guns and take care of people who had home and around the world.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
