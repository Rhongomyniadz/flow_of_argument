  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 72,
    "turn_text": "I said to everyone. Be not discouraged. Don't give up. Keep your faith. Keep your eyes on the prize. Hang in there. There's a way out. You have to be hopeful. You have to be optimistic. It's in keeping with the philosophy and the discipline of non-violence to be hopeful, to be optimistic. I got arrested 40 times during the 60s. Been arrested five times since I've been in Congress. Been left bloody and unconscious. Had a concussion on that bridge in Selma, on bloody Sunday. But I'm still hopeful. Still optimistic. I still believe that we can overcome and redeem the soul of America and create the beloved community. And if we can get it right here in America, maybe just maybe we'll be a model, an example for the rest of the world.",
    "speaker_id": "SPEAKER_02",
