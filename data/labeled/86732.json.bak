  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 133,
    "turn_text": "So to have this happen, to have this idea in the Congressman's office, you're about to, you know, go on your break and everything. And it turns into a number one best-selling book. It says something, doesn't it, about people's interest in the subject.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
