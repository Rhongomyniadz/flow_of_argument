    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 63,
    "turn_text": "Well, I think that is a status of it. When we are born into this world, we come innocent little creatures, little babies. We're not born hating or putting someone down because of their beliefs, their faith, of their party identification. The way of love is a better way.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We are born as innocent little creatures.",
        "confidence": 0.97
      },
      {
        "text": "Babies are not born hating others due to their beliefs, faith, or political affiliations.",
        "confidence": 0.95
      },
      {
        "text": "The way of love is superior to other ways.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Human nature at birth is inherently neutral or good rather than corrupt or predisposed to hatred.",
        "confidence": 0.94
      },
      {
        "text": "Hatred based on beliefs, faith, or political identity develops after birth through socialization or experience.",
        "confidence": 0.91
      },
      {
        "text": "Love is a viable and preferable moral framework for human interaction.",
        "confidence": 0.9
      },
      {
        "text": "There exists a meaningful distinction between 'the way of love' and alternative approaches to human relationships.",
        "confidence": 0.89
      }
    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 64,
