  },
  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 59,
    "turn_text": "It's possible. I believe it is possible. You can never give up. You can never give in or give out. You have to keep the faith and continue to push and pull.",
    "speaker_id": "SPEAKER_02",
