  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 102,
    "turn_text": "Now when I talk with the Congress and I mentioned that the book does not shy away from certain issues, certain words and word. Was that important to you as well to hit certain issues head on in a graphic form?",
