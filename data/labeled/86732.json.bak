    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 96,
    "turn_text": "Tell me a little bit about your own life and why you were attracted to work with Congressman Lewis to begin with and why the issues that he cares about are relevant to you as well.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
