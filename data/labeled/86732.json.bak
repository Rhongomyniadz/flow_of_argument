  {
    "episode_id": 86732,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86732.jsonl",
    "turn_idx": 99,
    "turn_text": "what about his issues to attract you? Because you can't write a book like this that delves into the civil rights issues without, I would think, having some passion for them yourselves. I mean, the South is very different now than when Congressman Lewis grew up.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The American South has changed significantly since Congressman Lewis was young.",
        "confidence": 0.96
      },
      {
        "text": "It is difficult to write a book about civil rights issues without having personal passion for those issues.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Passion for civil rights is necessary to authentically portray them in writing.",
        "confidence": 0.94
      },
      {
        "text": "The audience recognizes Congressman John Lewis as a significant figure in the civil rights movement.",
        "confidence": 0.91
      },
      {
        "text": "The speaker believes that understanding historical context requires empathy or lived experience.",
        "confidence": 0.89
      },
      {
        "text": "The author of the book being discussed is likely passionate about civil rights.",
        "confidence": 0.87
