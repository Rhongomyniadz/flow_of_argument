      {
        "text": "They voted against work requirements.",
        "confidence": 0.92
      },
      {
        "text": "This group does not have the right to claim the label 'conservative'.",
        "confidence": 0.92
      },
      {
        "text": "They voted against NEPA reform.",
        "confidence": 0.91
      },
