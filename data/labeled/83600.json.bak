  {
    "episode_id": 83600,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83600.jsonl",
    "turn_idx": 71,
    "turn_text": "Benny, you know, what do you say? I get it, he's upset. He said that while he was, he'd just been ousted from his dream job, and I understand it. So I'm not gonna stop on his grave. But I don't think there's anybody in Congress who would step back and say, you know, Andy Biggs is really not a very conservative guy. There's nobody who would say that. And there's nobody who's known me and watched me in public life for more than 20 years now who would say that big is not conservative. There's nobody that actually ranks people who would say, you know, hey, I think Kevin McCarthy is a little bit more conservative than big. There is no one who would say that. So I don't feel the need to defend myself. And I also don't want to stomp on Kevin McCarthy because What he went through was a personal thing to him. And for me, it wasn't a personal thing. And so for me, I just think that he wasn't the leader for our time. And I don't think he was a successful leader.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
