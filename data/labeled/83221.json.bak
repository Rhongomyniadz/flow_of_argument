  {
    "episode_id": 83221,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83221.jsonl",
    "turn_idx": 4,
    "turn_text": "Let's remember this date was not established by the Taliban. It was established by the US government. And here's the problem with this, which is right now we don't have the throughput problem. The problem is people getting to the airport. So you're making assumptions about the ability of people to get to the airport between now and the 31st. Once you decide to withdraw, You can't really reverse that decision because you're drawing down all the assets and capabilities at the airfield. And so if it's August 31st and you find out that there's a whole bunch of people that are still outside the wire. There's no way back. So it's a very risky decision to just say, we are definitely gonna leave on the 31st because what you may wind up doing is leaving behind the largest hostage crisis in modern history. The alternative is stick it out and the Taliban won't be happy. And there are things they can do and including trying to shut the whole thing down, you have to choose between those.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The date was not established by the Taliban.",
        "confidence": 0.95
      },
      {
        "text": "The date was established by the US government.",
        "confidence": 0.94
      },
      {
        "text": "Currently, there is no throughput problem at the airport.",
        "confidence": 0.92
      },
      {
        "text": "The current problem is people getting to the airport.",
        "confidence": 0.91
      },
      {
        "text": "Making assumptions about the ability of people to reach the airport before August 31st is problematic.",
        "confidence": 0.9
      },
      {
        "text": "Once withdrawal begins, the decision cannot be reversed.",
        "confidence": 0.89
      },
      {
        "text": "Drawing down assets and capabilities at the airfield makes reversal impossible.",
        "confidence": 0.88
      },
      {
        "text": "If many people remain outside the wire by August 31st, there will be no way to retrieve them.",
        "confidence": 0.87
      },
      {
        "text": "Leaving on August 31st risks creating the largest hostage crisis in modern history.",
        "confidence": 0.86
      },
      {
        "text": "Sticking it out would provoke dissatisfaction from the Taliban.",
        "confidence": 0.85
      }
    ],
    "assumptions": [
      {
        "text": "The US government has legitimate authority over the establishment of evacuation timelines.",
