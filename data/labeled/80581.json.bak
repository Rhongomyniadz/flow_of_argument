        "confidence": 0.91
      },
      {
        "text": "The speaker believes that having high-level diplomatic presence at the Olympics could have led to more scrutiny of human rights issues in China.",
        "confidence": 0.9
      },
      {
        "text": "The IOC claims it is not responsible for addressing geopolitical or human rights concerns related to host countries.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "The speaker assumes that increased diplomatic engagement would have pressured China to address sensitive political topics during international forums.",
        "confidence": 0.91
      },
      {
        "text": "The speaker assumes that public attention to Xinjiang and Taiwan issues would lead to greater global pressure on China.",
        "confidence": 0.89
      },
      {
        "text": "The speaker believes that the IOC’s neutrality claim masks a strategic avoidance of human rights accountability.",
        "confidence": 0.88
      },
      {
        "text": "The speaker trusts that high-level officials possess the moral authority to raise uncomfortable truths without being dismissed.",
        "confidence": 0.87
      },
      {
