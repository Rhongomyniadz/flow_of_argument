  {
    "episode_id": 70766,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/0/70766.jsonl",
    "turn_idx": 40,
    "turn_text": "Well, I was right next to him. I was in a vehicle in front of him. And my vehicle rolled over the IED. And by protocol, if you're the vehicle behind you, you're supposed to follow our tracks. And so for some reason, it was a triggered IED by plates. So it wasn't a manned IED. It was basically a landmine, a huge landmine. So for some reason, The IE didn't go off on me, he went off on him, and my vehicle was in front, so I heard it all.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
