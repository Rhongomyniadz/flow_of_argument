  {
    "episode_id": 78130,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/8/78130.jsonl",
    "turn_idx": 8,
    "turn_text": "I'm actually I'm both thrilled and you know it's been great to watch because you're seeing I think the party coalesce so quickly around Kamala Harris. The president gets out yesterday which even for those of us who thought it might happen or thought it was the best thing to happen it's still shocking it's still surprising and he immediately endorses her and then by the end of the day you see she's raised $50 million she has hundreds of uh, congressmen and women and governors and supporters lined up, uh, you saw the Kentucky Democratic Party, uh, officially endorsed her today, saying it happened around the state. I think that whatever the process is, the DMC outlines this week. And this is one of those where you hate to talk about process, but the DMC can outline the process. Wherever that process is, I think you're going to see Kamala Harris win that process. quickly and Democrats continue to build on the momentum that honestly I think we have right now and has been absent from the democratic campaign for a little while.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
