  {
    "episode_id": 84639,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84639.jsonl",
    "turn_idx": 22,
    "turn_text": "Well, we just keep pushing at our government level, but until somebody walks out of one of these quasi-governmental businesses, which is where they're at, if they even exist anymore, they're in these businesses, so we can't get to them through FOIA. Their government funded contracts, but FOIA, of course, is Freedom of Information Act, where we can get a hold of them. And what's gonna have to happen is somebody's gonna have to walk out with material or physical evidence or something like that and bring it forward to the American public. That's the only way this is ever going to, I think, get to bottom of it.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
