  {
    "episode_id": 72832,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72832.jsonl",
    "turn_idx": 25,
    "turn_text": "it's clear for many of us that the RFS standards need to be modified. And so Congressman Goodlott and I and others on a bipartisan basis have legislation this year that will provide a modification to the renewable field standards for all of those reasons.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
