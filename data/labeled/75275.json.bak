  {
    "episode_id": 75275,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/5/75275.jsonl",
    "turn_idx": 9,
    "turn_text": "And this is exactly what I try to address when I was first elected in 2008. in the California State Assembly is the fact that depending on where you are, training varies among dispatchers. You could have, like I did, six months of training, and then you're put on probation. Now it's more like 12 months of training and six months of probation. Or you could just like you be thrown there and you're answering calls while you're learning basically a new language. For me, having to learn the codes, the LAPD codes that they use is very different than the 10 code or anything else that other agencies are using.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
