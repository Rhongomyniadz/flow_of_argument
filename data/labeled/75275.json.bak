  {
    "episode_id": 75275,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/5/75275.jsonl",
    "turn_idx": 8,
    "turn_text": "Oh man, that takes me back because I remember when I first started as well, it was all memorization. You've got all this information and my first call that I had taken, luckily it wasn't anything high priority, but when I first started, I go in the first night and I'm there with my trainer, his name was Harry. He ends up taking a phone call and I'm watching him, you know, I'm observing this. And he goes, okay, well, it's, it's your turn now. And I said, what? And he goes, yeah, you've got the next phone call. And I thought, oh, man, I thought, well, what about all this stuff I have to memorize? He goes, uh, as long as you have common sense, you're okay. I thought, Oh, wow. Okay.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
