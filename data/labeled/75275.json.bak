  {
    "episode_id": 75275,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/5/75275.jsonl",
    "turn_idx": 10,
    "turn_text": "Yeah, I think that's one of the big differences from then and now. And I say that because when I was getting towards the end of my dispatching career, some of the newer equipment, I mean, all of the 10 codes, all of the codes to classification of like domestic or disorderly or something, that was all saved in there. However, when I had first started out, I had to memorize all of those to type those in. So then when our can system would go down, I remember some of the newer people that would come on would say, well, I don't remember what that was. And I would kind of look at it and say, you didn't memorize it.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
