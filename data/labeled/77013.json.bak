  {
    "episode_id": 77013,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/7/77013.jsonl",
    "turn_idx": 54,
    "turn_text": "You've been listening to the Columbus Metropolitan Club's Weekly Forum. This week, we heard from Congresswoman Joyce Beatty, who shared insights on her work in Washington and the impact of national policies on Central Ohio. Our host was veteran CMC moderator Karen Kastler, Chief of the State House News Bureau. This forum was sponsored by the Robert Weiler Company. The presenting sponsor of our livestream was the Center for Human Kindness at the Columbus Foundation. CMC's livestream partner was the Columbus Dispatch. This forum was also supported by the Ellis. Join us next week as the not-for-profit Columbus Metropolitan Club once again connects people and ideas through community conversations. I'm Doug Buchanan with CMC. Thanks for listening.",
    "speaker_id": "SPEAKER_08",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The current event is the Columbus Metropolitan Club's Weekly Forum.",
