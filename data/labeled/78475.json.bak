  {
    "episode_id": 78475,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/8/78475.jsonl",
    "turn_idx": 4,
    "turn_text": "Of course, while this is all going on, we are still taking time today to celebrate this 200th birthday, the State of Illinois. 200 years ago today, Illinois admitted to the Union, the big birthday bash tonight in Chicago. You will be there along with outgoing Governor Rauner. What are your thoughts on this bicentennial day here in the State of Illinois?",
