  {
    "episode_id": 78475,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/8/78475.jsonl",
    "turn_idx": 2,
    "turn_text": "It's got to be sobering to realize that in a few short weeks you're going to have ultimate responsibility in situations like this to make sure that resources go where they need to go, that all the different state agencies that may be involved in response are functioning the way they're supposed to. How do you prepare for that kind of enormous responsibility?",
