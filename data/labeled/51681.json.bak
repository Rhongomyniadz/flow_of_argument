  {
    "episode_id": 51681,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/1/51681.jsonl",
    "turn_idx": 43,
    "turn_text": "Yeah, absolutely. I mean, it goes back to the motto of the 506 Parachute Infantry Regiment on 101st, Curia Heat, which means he stands alone. And so that's probably why I only did one term in the United States Congress, because I was an elected Republican, but members of the Republican Party were the ones that were in charge of redistricting, and they redistricted me out of the congressional district that I represented, and now it's the number one target. of the Democrat party in 2012. And so for me, that was a badge of honor that I wear today because I took a note to the Constitution, not to a party, not to a person or anything like that. I took a note to support and defend that thing that embodies the American people who we are.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
