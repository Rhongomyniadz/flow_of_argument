    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 90376,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90376.jsonl",
    "turn_idx": 10,
    "turn_text": "How would this affect your constituents back home? The US, the Russian oil is about 3% of US crude imports last year. What would this mean for us living in the Bay Area? What are gas prices go up more?",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
