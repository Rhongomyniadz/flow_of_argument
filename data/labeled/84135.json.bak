      },
      {
        "text": "I volunteer for Humanity Forward and Humanity Hangs.",
        "confidence": 0.9
      },
      {
        "text": "When I speak with others, they often mention the American Scorecard as their favorite policy.",
        "confidence": 0.88
      },
      {
        "text": "A shift toward valuing living standards over production is desirable.",
        "confidence": 0.87
      },
      {
        "text": "The listener likely supports the general idea behind reorienting priorities toward human well-being.",
        "confidence": 0.85
      }
    ],
    "assumptions": [
      {
        "text": "People value being cared for and prioritize well-being over economic output.",
        "confidence": 0.93
      },
      {
        "text": "GDP is widely accepted as an inadequate measure of societal progress.",
        "confidence": 0.9
      },
      {
        "text": "Focusing on 'how much we're living' implies a moral preference for quality of life over quantitative growth.",
        "confidence": 0.89
      },
      {
