    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 84135,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84135.jsonl",
    "turn_idx": 101,
    "turn_text": "Well, I think one is a campaign finance. I mean, Andrew Yang showed Bernie Sanders showed that you can raise money online, but that's very hard to do when you're not a celebrity, when you're not running for president. So what my bill does is it makes every voter a donor. It says, give everyone democracy dollars, $50, and Andrew actually supported this idea and championed it. And so that we can democratize who runs for office. So you now don't have to rely on millionaires and billionaires. You can rely on people in a community to give you $50 up to $50. And I think that would be the biggest thing we can do to open up the access to who can run for office.",
    "speaker_id": "SPEAKER_11",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Campaign finance reform is important.",
        "confidence": 0.97
      },
      {
        "text": "The speaker's bill gives every voter $50 in democracy dollars.",
        "confidence": 0.96
