  {
    "episode_id": 84135,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84135.jsonl",
    "turn_idx": 90,
    "turn_text": "I just wanted to, I want to make this really quick because I know there's a lot of people here. I do volunteer for Humanity Forward for Humanity Hangs and a lot of people when I talk to them and I ask them what their favorite policy is. They immediately go towards the American scorecard, which is moving us away from measuring economy by GDP and starting to put the pressure on making sure that our people are getting taken care of first. I'm sure you probably support the concept at least. What do you think would be some ways that we can start moving people in that direction and stop getting the focus to be so heavily on how much we're producing and more on how much we're living.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I want to keep this conversation brief.",
        "confidence": 0.95
      },
