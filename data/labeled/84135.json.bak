        "confidence": 0.94
      },
      {
        "text": "Financial hardship makes it difficult for individuals to campaign effectively.",
        "confidence": 0.93
      },
      {
        "text": "The current system disproportionately excludes lower-income individuals from running for office.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Economic inequality directly limits democratic participation by excluding poorer candidates.",
        "confidence": 0.95
      },
      {
        "text": "Political campaigns require substantial out-of-pocket expenses that are unaffordable for many low-income individuals.",
        "confidence": 0.94
      },
      {
        "text": "Representatives should reflect the socioeconomic diversity of their constituents.",
        "confidence": 0.91
      },
      {
        "text": "Policy reforms can meaningfully increase access to political candidacy for economically disadvantaged populations.",
        "confidence": 0.9
      },
      {
