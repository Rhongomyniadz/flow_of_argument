  {
    "episode_id": 80548,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80548.jsonl",
    "turn_idx": 4,
    "turn_text": "It's been interesting to watch this debate going on, and I know that Senator Schumer was negotiating. Do you have any sense of what finally swayed the West Virginia Senator to supporting this?",
