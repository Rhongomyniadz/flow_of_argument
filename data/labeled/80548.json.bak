  {
    "episode_id": 80548,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80548.jsonl",
    "turn_idx": 13,
    "turn_text": "We're making progress on wild and scenic. We've had some fairly good breakthroughs and negotiations with Freeport, Mac Moran lately. We were able to move that legislation out of the E&R committee recently. So it really does seem to be building. And there is still a gap between what some people believe that does and what it actually does. But I think we have entered into a lot of conversations in good faith. some of the progress we've made lately around mining in particular shows that this is about protecting those river segments. Fundamentally, this is the last headwaters, undammed Colorado River watershed, and it is such a dynamic place when you see, I mean, it runs from 30 CFS to 20,000 CFS and everywhere in between. And that has actually kept those river segments in really good condition. You don't see the tamarisk and the invasies that you see in other places. And you see wildlife that has blinked out in so many other locations. And people are really passionate about that river who have a familial connection to it. So I really believe we're going to get there on Hilo Wild and Zenic. We continue to make progress. We get a little bit closer every year, and we're going to get that across the finish line.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The flow of the river varies dramatically, from 30 CFS to 20,000 CFS.",
        "confidence": 0.99
      },
      {
        "text": "This area represents the last undammed headwaters of the Colorado River watershed.",
        "confidence": 0.98
