      },
      {
        "text": "The Recovering America's Wildlife Act focuses on wildlife conservation rather than land conservation.",
        "confidence": 0.96
      },
      {
        "text": "The Recovering America's Wildlife Act provides funding to tribal and state wildlife agencies.",
        "confidence": 0.95
      },
      {
        "text": "The act enables early intervention to prevent wildlife population decline into crisis mode.",
        "confidence": 0.94
      },
      {
        "text": "There is currently a biodiversity crisis in the United States.",
        "confidence": 0.93
      },
      {
        "text": "Many species once commonly seen are now rarely observed.",
        "confidence": 0.92
      },
      {
        "text": "Intervening before species reach endangered status is more effective and less costly.",
        "confidence": 0.91
      },
      {
        "text": "The Lesser Prairie Chicken is an example of a species at risk of being listed under the Endangered Species Act.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "Preventive action is more ethical than reactive rescue efforts.",
