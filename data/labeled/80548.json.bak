  {
    "episode_id": 80548,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80548.jsonl",
    "turn_idx": 30,
    "turn_text": "Yeah. So switching to gun reform in June, Congress did pass a compromise bill on gun",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Congress passed a compromise bill on guns in June.",
        "confidence": 0.95
      },
      {
        "text": "The topic of discussion switched to gun reform in June.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "Gun reform was previously being discussed before June.",
        "confidence": 0.87
      },
      {
        "text": "A 'compromise bill' implies some level of agreement among opposing factions on gun policy.",
        "confidence": 0.85
