    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/0/80548.jsonl",
    "turn_idx": 37,
    "turn_text": "You lived through that historic insurrection. And I'm curious, your thoughts looking back and with the hearings going on right now, how do we as a nation heal from something like that?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
