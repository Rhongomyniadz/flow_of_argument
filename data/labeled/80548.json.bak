        "confidence": 0.95
      },
      {
        "text": "The West Virginia Senator eventually supported the proposal.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "The speaker believes that negotiation processes influence political decisions.",
        "confidence": 0.94
      },
      {
        "text": "The listener has access to insider information about the senator’s decision-making process.",
        "confidence": 0.9
      },
      {
        "text": "Political support shifts are typically driven by specific persuasive factors or concessions.",
