  {
    "episode_id": 72718,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72718.jsonl",
    "turn_idx": 37,
    "turn_text": "You know, I don't want to ever say never, but that is a very important point for us. I mean, you can talk about how you get there, whether you've got the appropriate sanctions for people who didn't follow the rules, but to have people in permanent limbo, I don't think that's good for the country. I mean, in places where they've done that, like Germany and the Turks, it's destabilizing, it's not good. You know, the good thing about America is that we've got Americans whose families came from all over the world. My grandfather was an immigrant from Sweden. And what they really wanted was to be Americans. And that's what we want. We want the people who are here to love our country and to be good Americans.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The speaker believes that having people in permanent legal limbo is bad for the country.",
        "confidence": 0.95
      },
      {
        "text": "The speaker's grandfather was an immigrant from Sweden.",
        "confidence": 0.92
      },
      {
        "text": "Germany and Turkey have experienced destabilization due to people being in permanent legal limbo.",
        "confidence": 0.9
      },
      {
        "text": "The United States has benefited from immigrants whose families came from around the world.",
        "confidence": 0.88
      },
      {
        "text": "Immigrants who come to the U.S. typically desire to become American citizens.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "Permanent legal limbo undermines national stability and cohesion.",
        "confidence": 0.94
      },
      {
        "text": "A nation’s strength depends on integrating immigrants into its civic identity.",
        "confidence": 0.91
      },
      {
        "text": "Being American is defined by loyalty and identification with the country, not just ancestry.",
        "confidence": 0.9
      },
      {
        "text": "The speaker views immigration as a positive force for national unity and diversity.",
        "confidence": 0.89
      },
      {
        "text": "Historical examples like Germany and Turkey provide relevant lessons about the consequences of prolonged limbo status.",
        "confidence": 0.86
