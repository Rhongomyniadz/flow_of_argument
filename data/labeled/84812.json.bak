  {
    "episode_id": 84812,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84812.jsonl",
    "turn_idx": 628,
    "turn_text": "This has been Recode Decode hosted by Cara Swisher, powered by Digital Media. For more hard-hitting interviews with insiders from the worlds of tech, media, and politics, subscribe to Recode Replay on iTunes. Featuring candid conversations with leading voices like AOL CEO Tim Armstrong, Goldman Sachs' CIO Marty Chavez, the team behind the hit TV show Empire, Shark Tank investor Mark Cuban, and presidential candidate Hillary Clinton. They're all on Recode Replay. you",
