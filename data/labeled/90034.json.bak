    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 90034,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90034.jsonl",
    "turn_idx": 36,
    "turn_text": "if President Trump asked me to serve. I can't think of the time in my life when someone's asked me to serve in a place where I thought I could make a difference. And that'd be the calculus. If I think I can help the team and make a difference and deliver on the things that matter to me, my family and to our country, I'm confident that I wouldn't turn down that duty.",
    "speaker_id": "SPEAKER_05",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
