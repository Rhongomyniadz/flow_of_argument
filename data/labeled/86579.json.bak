    ],
    "turn_type_label": "Substantive"
  },
  {
    "episode_id": 86579,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86579.jsonl",
    "turn_idx": 31,
    "turn_text": "I think our way of life is at stake. I mean, I think that's really the simple answer. The middle class way of life that I grew up with in Lexington, Missouri, that has sustained our state and our families, our communities, our churches all over our state. It's at risk. It's at risk from immigration that is out of control. It's at risk from jobs that have gone overseas. It's at risk from liberal activist judges. And right now what happens in the United States Senate is as critical as anywhere else in the country for the future of our country. You know, I think the president won this state by 20 points because he knows that our way of life is at risk and Missourians know that too. And it's a critical, critical turning point for the country. So this isn't something I had intended to do, as you all have reported on, but it's something I think that is vital and I think that the hour is a critical one.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
