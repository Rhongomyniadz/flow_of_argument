  {
    "episode_id": 88428,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88428.jsonl",
    "turn_idx": 46,
    "turn_text": "Speaking of working with some of your colleagues who are more conservative, even if they're Democrats, you have said before that, you know, it's a lot easier to be on the outside and to be pure and never having to make compromises. But ultimately, that also means giving up some sort of power. So how do you square the compromises, you know, that you have to make a day to day in that job with the same, with the progressive vision of the future that you have?",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
