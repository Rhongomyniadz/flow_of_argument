    "explicit_propositions": [
      {
        "text": "Tragic acts of hate against Asian Americans continue to occur across America.",
        "confidence": 0.98
      },
      {
        "text": "The speaker has been tracking American public perceptions of how Asian people are treated in U.S. society for many years and across multiple generations.",
        "confidence": 0.95
      },
      {
        "text": "In 2013, 78% of Americans reported being satisfied with how Asian people are treated in the U.S.",
        "confidence": 0.94
      },
      {
