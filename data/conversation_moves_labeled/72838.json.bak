    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I agree with your position.",
        "confidence": 0.95
      },
      {
        "text": "Many poor people live in areas without access to healthy food.",
        "confidence": 0.94
      },
      {
        "text": "Obesity is surrounded by multiple complex issues.",
        "confidence": 0.92
      },
      {
