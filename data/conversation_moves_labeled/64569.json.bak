  },
  {
    "episode_id": 64569,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/4/64569.jsonl",
    "turn_idx": 28,
    "turn_text": "Well, I favor a good mix in politics. It needs a little of everything, but there are certainly right now far too few people that are quantitatively literate. It is amazing that a lot of legislation is crafted without people understanding what the numbers they're putting in the legislation really mean or demand or imply or force people to do. So right off the bat, I think engineers can make a contribution by being part of the process and bringing to the table a little bit of quantitative literacy, a little bit of problem-solving capacity, a little bit of synthesizing pieces of a solution together to get an overall solution. And I think there are significant aspects of the discipline that would be very significantly appreciated in the process. There's far too few of us in the game, and I know of three, but there's too",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
