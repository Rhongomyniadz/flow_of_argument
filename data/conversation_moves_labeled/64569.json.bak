        "confidence": 0.96
      },
      {
        "text": "The speaker is welcoming Johnson Unu as a guest on their platform.",
        "confidence": 0.95
      },
      {
        "text": "The speaker wants to discuss elections in the context of the 2020 election cycle.",
        "confidence": 0.94
      },
      {
        "text": "New Hampshire has significant importance in the upcoming 2020 U.S. elections.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
