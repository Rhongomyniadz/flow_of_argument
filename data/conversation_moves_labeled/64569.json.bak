  {
    "episode_id": 64569,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/4/64569.jsonl",
    "turn_idx": 13,
    "turn_text": "So let's reflect back on your stint at the White House as the Chief of Staff for George H.W. Bush. What are your impressions of the United States' current political climate? Compare that to what you saw when you were there in the 80s and 90s.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
