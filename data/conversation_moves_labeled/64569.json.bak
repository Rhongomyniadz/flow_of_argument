  },
  {
    "episode_id": 64569,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/4/64569.jsonl",
    "turn_idx": 22,
    "turn_text": "In an odd way, I'll give you a policy related to the academic world. I think we have created a structure where the federal government has gotten involved in higher education to the point where we've imposed so many requirements that look, I chaired the Finance Committee here at TUS for five years. I would have departments come to me and say, well, they're demanding we have counseling. We need nine counselors. No, you don't need nine counsel. You need a counselor. And yet people have used federal imposition of what seemed to be good ideas on the higher education community to the point where the price of higher education has gone through the roof. And we take all those policies that are related to getting an education on a campus like Tufts And let's go back and unwind them a bit so that we're not looking at $80,000 a year requirements to come here.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Tuition at institutions like Tufts now exceeds $80,000 per year.",
