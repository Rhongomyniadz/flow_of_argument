  {
    "episode_id": 42503,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/2/42503.jsonl",
    "turn_idx": 228,
    "turn_text": "where you can put scientific research into three buckets. One is publicly funded genuine real research. The second is privately funded but legitimate R&D, which we want to encourage because that's how new products develop, that innovation happens. And the third, the bad one, is phony science that is developed for the purpose of basically counter-marketing against the real science on public health and safety issues. So all the bogus tobacco scientists who created uncertainty about whether that was really dangerous or not, you know, you go through all the public health issues that pollutants have caused and there's always some scientists on the other side. And we have to, I think, recognize in this country now and particularly the real scientific community has to recognize that in effect there's a new predator. in this environment.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
