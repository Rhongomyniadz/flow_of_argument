    "turn_idx": 8,
    "turn_text": "there is such a thing in American politics these days for you? And what are the things that are a bit on the frustrating side from your perspective?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
