  {
    "episode_id": 94305,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94305.jsonl",
    "turn_idx": 50,
    "turn_text": "No, I think it's great and it's simplicity, but in a town full of lobbyists, they really freak out about simple things because they look at it saying, well, how do we justify this? Are you certain that it has the tax provisions taken care of? Are you certain that it has the banking issues taken care of? Because they're used to having everything being prescribed. And our response is, When it says that it no longer applies, it no longer applies, which means that yes, the banking issue has been taken care of. And yes, the taxation issues have been taken care of. So instead of having a 60 or 70 page bill, you have just a sentence or two that gets the job done in an area that has been just a quagmire to try to get out of.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The legislation is great due to its simplicity.",
        "confidence": 0.95
      },
      {
        "text": "When a law states it no longer applies, it ceases to apply.",
        "confidence": 0.94
      },
      {
        "text": "This approach reduces complex legislation from 60–70 pages to one or two sentences.",
        "confidence": 0.93
      },
      {
        "text": "In towns filled with lobbyists, simple legislative language causes anxiety.",
        "confidence": 0.92
      },
      {
        "text": "If a law no longer applies, then associated banking issues are resolved.",
        "confidence": 0.91
      },
      {
        "text": "If a law no longer applies, then associated taxation issues are resolved.",
        "confidence": 0.91
      },
      {
        "text": "Lobbyists demand justification for every policy detail.",
        "confidence": 0.9
      },
      {
        "text": "Previously, resolving issues in this domain was extremely difficult and convoluted.",
        "confidence": 0.9
      },
      {
        "text": "Lobbyists expect all legal provisions to be explicitly prescribed.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "Simplicity in legislation is inherently valuable and effective.",
        "confidence": 0.93
      },
      {
        "text": "Lobbyists prioritize control through complexity and detailed prescription.",
