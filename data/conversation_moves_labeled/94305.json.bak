  {
    "episode_id": 94305,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94305.jsonl",
    "turn_idx": 54,
    "turn_text": "And that's way, and so what we did here was to say, and I think it's important too, to look at the politics of the place on this, because the politics of the place in the house are different than the Senate, and they were different before the election, they're certainly different after the election. And as I'm trying to explain to people who want a solution here, I said, look, the Senate is not in a place to pass a de-scheduling bill or to move forward legalization, it's just not going to. Maybe the House could have done that before the election, maybe they can do it after the election, But it's never going to get out of the Senate that way. So how can we have something that gets out of the Senate that allows maybe your southern senators who may have a different constituency than you do in Oregon or Washington or Colorado to come up with a way that they can stand up and say, hey, you know what, this is the right thing to do. I can be for this and get beyond the filibuster majority, get above 60 votes and make it happen.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The politics of the House are different from those of the Senate.",
        "confidence": 0.97
      },
      {
        "text": "The Senate is currently unable to pass a de-scheduling bill.",
        "confidence": 0.96
      },
      {
