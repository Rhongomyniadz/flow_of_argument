  {
    "episode_id": 45973,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45973.jsonl",
    "turn_idx": 21,
    "turn_text": "It's interesting. It feels like right now some of the smartest investors in the world believe that rampant inflation is coming. And meanwhile, a lot of your colleagues in the Senate and in the House believe that in the media as well believe that this is just transitory. How worried are you about runaway inflation?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
