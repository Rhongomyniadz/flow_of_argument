  {
    "episode_id": 45973,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45973.jsonl",
    "turn_idx": 19,
    "turn_text": "When you say that we're at a tipping point and that we're potentially in for some trouble, what kind of trouble do you see coming from something like currency debasement?",
