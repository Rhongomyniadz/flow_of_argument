  {
    "episode_id": 72881,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72881.jsonl",
    "turn_idx": 16,
    "turn_text": "Every day local businesses open their doors with more than just a plan. They bring persistence, ambition and a vision for what's next. from storefronts on Main Street to warehouse floors. Small businesses are leading the way. And while they're forging ahead, they're doing it with the support and strategic financial tools from America's banks. Support from our nation's leading bank shows up every day, in advice, in partnership, in providing what it takes to operate today and plan for tomorrow. That's how real economic growth happens, not from the top down, but block by block, business by business. Building opportunity, fueling economic growth, paid for by United for a strong economy.",
    "speaker_id": "SPEAKER_02",
