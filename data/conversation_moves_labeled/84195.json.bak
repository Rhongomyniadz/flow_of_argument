    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 84195,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84195.jsonl",
    "turn_idx": 5,
    "turn_text": "So we focus our first subcommittee hearing today on success stories from around our country. It is important that Congress does its work to shine a light on the election policies that are working. and states that are getting elections right. So today at our hearing, we had two secretaries of state. One was Secretary Kyle Ardon from Louisiana. The second was Franklin Rose from Ohio. And then we brought one of Florida's supervisors of elections, Chris Anderson from Seminole County. And each of them provided some really important testimony about their perspective on the elections administration. And some of the things they were doing in their states that have been very successful for them. This is a way that when we talk about the things that are working, that those ideas are things that we can then build on and share with other states around the country to implement those best practices.",
    "speaker_id": "SPEAKER_01",
