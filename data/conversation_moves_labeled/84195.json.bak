    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Elections administration and elections laws primarily belong to individual states.",
        "confidence": 0.97
      },
      {
        "text": "Cybersecurity and infrastructure are critical components of election integrity.",
        "confidence": 0.96
      },
      {
        "text": "The U.S. Constitution mandates that state governments handle election administration and laws.",
        "confidence": 0.95
      },
      {
        "text": "Federalism is a principle respected by Congress.",
        "confidence": 0.94
      },
      {
        "text": "Ensuring robust cyber and digital infrastructure against threats is essential for election security.",
        "confidence": 0.93
      },
      {
        "text": "States should decide on their own election policies based on their judgment of appropriateness.",
        "confidence": 0.92
      },
      {
        "text": "Congress’s role is to partner with states to identify effective election practices.",
        "confidence": 0.91
      },
      {
        "text": "The committee focused its initial efforts on examining successful election practices across the country.",
