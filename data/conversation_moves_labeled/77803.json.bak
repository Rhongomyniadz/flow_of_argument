  {
    "episode_id": 77803,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/7/77803.jsonl",
    "turn_idx": 8,
    "turn_text": "A lot of times when we think about cybercrime or cyber security, the end game is a financial game or a mode of a ransomware. In this case, the adversary is infiltrating networks and implementing what we call a pivot or the ability to move around the networks. Also, as opposed to compromising computers, these attackers are compromising devices that you might see on a network which are typically ignored in most cyber security doctrines that need to be evaluated.",
    "speaker_id": "SPEAKER_10",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Cybercrime and cyber security are often associated with financial gain or ransomware.",
        "confidence": 0.95
      },
      {
        "text": "In some cases, adversaries infiltrate networks to achieve lateral movement, also known as pivoting.",
        "confidence": 0.92
      },
      {
        "text": "Some attackers target devices on a network that are typically ignored in standard cyber security doctrines.",
        "confidence": 0.9
      },
      {
        "text": "These overlooked devices require evaluation in cyber security assessments.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
