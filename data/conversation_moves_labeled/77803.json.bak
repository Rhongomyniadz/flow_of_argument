        "confidence": 0.93
      },
      {
        "text": "Standard cyber security doctrines are insufficient because they overlook certain types of network devices.",
        "confidence": 0.9
      },
      {
        "text": "The presence of exploitable devices on a network represents a significant vulnerability if unaddressed.",
        "confidence": 0.87
      },
      {
        "text": "Lateral movement within networks is a common objective in advanced cyber intrusions.",
        "confidence": 0.85
      },
      {
        "text": "There exists a distinction between traditional computing systems and other network-connected devices in terms of security prioritization.",
        "confidence": 0.83
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
