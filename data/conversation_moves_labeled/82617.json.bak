  {
    "episode_id": 82617,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82617.jsonl",
    "turn_idx": 9,
    "turn_text": "So if there's such urgency, why didn't you drop the hammer in the Articles of Impeachment and say this was a bribe? Well, for all of you out there who believe it's about a crime, you're wrong, but the crime is",
