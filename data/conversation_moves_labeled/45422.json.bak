      },
      {
        "text": "The Canada agreement has implications for American workers.",
        "confidence": 0.92
      },
      {
        "text": "The Canada agreement has implications for agriculture in Kentucky.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "American workers are affected by international trade agreements.",
        "confidence": 0.94
      },
      {
