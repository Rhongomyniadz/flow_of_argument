  {
    "episode_id": 45422,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45422.jsonl",
    "turn_idx": 49,
    "turn_text": "Canada agreement. What does this mean for American workers? And of course, more importantly, what does this mean for agriculture in the state of Kentucky?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There exists a Canada agreement.",
