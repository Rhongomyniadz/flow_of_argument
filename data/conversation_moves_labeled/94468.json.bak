        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "The listener values staying in office.",
        "confidence": 0.94
      },
      {
        "text": "The listener understands the distinction between campaigning and lawmaking roles.",
        "confidence": 0.92
      },
      {
        "text": "Constituent feedback should influence political response.",
        "confidence": 0.9
      },
      {
        "text": "Responding appropriately to constituent concerns demonstrates effective leadership.",
        "confidence": 0.89
      },
      {
        "text": "The speaker holds authority or legitimacy to guide the listener’s reflection.",
