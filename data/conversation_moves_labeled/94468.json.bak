    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Typically, discussions about congressional performance focus on bills passed or bills introduced/sponsored by a legislator.",
        "confidence": 0.96
      },
