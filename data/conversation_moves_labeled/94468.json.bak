  {
    "episode_id": 94468,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94468.jsonl",
    "turn_idx": 8,
    "turn_text": "So let's take that as one example, and I'm sure there are other things that you and your staff heard from constituents, but you hear that. What do you do with that? And I'm gonna maybe split you up into two people as a campaigner, which is pretty important if you want to stay in office, and also as a lawmaker. But as a campaigner, when you hear something like that, how do you respond?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
