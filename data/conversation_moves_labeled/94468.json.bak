  },
  {
    "episode_id": 94468,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94468.jsonl",
    "turn_idx": 13,
    "turn_text": "Oh, I mean, I'd like to think I'm normal. I mean, you know, but just like at daycare drop off, like at the grocery store, like, you know, I talked to my mom, talked to my neighbors, talked to people at church, like, but you know, whatever, like just normal. And I think that's one of the things that I've realized too, is that it's, you have to think about who's not at the table. Like I think about my experience having run a small business and like, I wouldn't have gotten invited to most of these, like any of these meetings, right? If you're trying to make it to your kid's doctor appointment or any of these things, it's very difficult to make time for the political process. And so that's why it's so important to be out and present and available. And that's why I spend so much time in my rural counties, because they're pointing to something true that needs to be heard and needs to be thought for.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "People who manage childcare or medical appointments often lack time to participate in formal political processes.",
        "confidence": 0.94
      },
      {
        "text": "It is important to be physically present and visible in civic engagement efforts.",
        "confidence": 0.93
      },
      {
        "text": "The speaker considers themselves to be a normal person.",
        "confidence": 0.92
      },
      {
        "text": "Certain individuals—particularly those without flexible schedules—are excluded from political decision-making spaces.",
        "confidence": 0.91
