    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Clarification Request (Specific)"
  },
  {
    "episode_id": 94468,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94468.jsonl",
    "turn_idx": 11,
    "turn_text": "Oh, I mean, people, some of my colleagues would be like, well, how do we get these people to understand that the economy is great? I'm like, what are you talking about? People are putting their groceries on a credit card. There is not a spreadsheet on Earth that is going to talk somebody out of their lived experience of not being able to afford rent, of working multiple jobs, of having to put stuff out of your grocery cart. You listen to them. And, you know, I mean, there's a, there's like a joke and like, you're that joke, like there's lies, damn lies and statistics. I mean, you have to be talking to enough, like it, just normal people in your community and to know whether these, these spreadsheets, these talking points are trying to blow smoke or if they're, you know, wanting to something real.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Lived experiences include inability to afford rent, working multiple jobs, and leaving items behind at checkout.",
        "confidence": 0.96
      },
      {
        "text": "Some of my colleagues believe the economy is great.",
        "confidence": 0.95
      },
      {
        "text": "No spreadsheet can override someone's lived experience of financial hardship.",
        "confidence": 0.94
      },
      {
        "text": "Listening to people is essential when assessing economic conditions.",
        "confidence": 0.93
      },
      {
        "text": "People are using credit cards to buy groceries.",
        "confidence": 0.92
      },
      {
        "text": "There is a common saying: 'lies, damned lies, and statistics.'",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "The speaker values personal lived experience over abstract data.",
        "confidence": 0.97
      },
      {
        "text": "Economic policy should be grounded in everyday people's realities.",
        "confidence": 0.95
      },
      {
        "text": "Statistical narratives can be misleading when disconnected from human experience.",
        "confidence": 0.94
      },
      {
        "text": "Authentic understanding comes from direct interaction with regular community members.",
        "confidence": 0.93
      },
      {
        "text": "Colleagues who focus on positive statistics lack empathy or connection to ordinary citizens.",
        "confidence": 0.92
      },
      {
        "text": "Public discourse often prioritizes convenient narratives over genuine hardship.",
        "confidence": 0.91
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 94468,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94468.jsonl",
    "turn_idx": 12,
