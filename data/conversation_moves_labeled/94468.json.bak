  },
  {
    "episode_id": 94468,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94468.jsonl",
    "turn_idx": 22,
    "turn_text": "Well, I don't think that bills are going to fix everything. I don't think government is going to fix everything. And I think people try to pass bills because it sounds good. But that means sometimes they just make up problems because there's no natural predator for that because it's a made up issue. Real work takes time. Real legislation really does take time and building a coalition. It'll have opponents and supporters, and it takes time to build the coalition. thinking about how to make ideas better, how to make legislation better. I'm proud of that. It's like this thing was coming to the floor and it was going to pass and I got a chance to make it better. To take somebody else's idea and kind of internalize it and chew on it and think about how do we make it better.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
