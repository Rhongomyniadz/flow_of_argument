    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Biden has not indicated any intention to step down from office.",
        "confidence": 0.94
      },
      {
        "text": "The people in administration are experiencing panic.",
        "confidence": 0.92
      },
      {
        "text": "There is significant confusion within the administrative group.",
        "confidence": 0.9
      },
      {
        "text": "Administrators are receiving conflicting signals from multiple sources.",
        "confidence": 0.88
