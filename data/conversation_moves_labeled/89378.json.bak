  {
    "episode_id": 89378,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/9/89378.jsonl",
    "turn_idx": 24,
    "turn_text": "Well, it is true that on page one, he draws his conclusion that there was no collusion. Just back to the hearing for next week. Do you know your first question?",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
