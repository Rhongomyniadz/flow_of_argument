      {
        "text": "One finding from the report was that Adam Schiff has significantly out-raised Nadine.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "Fundraising success is a key indicator of electoral viability in a Senate race.",
        "confidence": 0.95
      },
      {
        "text": "California’s high cost of campaigning makes substantial fundraising essential for competitiveness.",
        "confidence": 0.93
      },
      {
        "text": "Audiences will interpret a large fundraising gap as evidence of diminished chances for the underfunded candidate.",
        "confidence": 0.91
      },
      {
        "text": "Nadine’s inability to close the funding gap would undermine her credibility as a viable Senate contender.",
        "confidence": 0.89
      },
      {
        "text": "The speaker believes that public awareness of fundraising disparities affects voter perception and political momentum.",
        "confidence": 0.87
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Correction / Challenge"
