  {
    "episode_id": 92669,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92669.jsonl",
    "turn_idx": 4,
    "turn_text": "Well, I think what we're referring to is whether we're actually using a whiteboard or maybe some other proper tool, really trying to hold people to account. And so when we say we're going to whiteboard somebody, we mean we're going to really lay out the case for what they need to be held to account for, and we're going to ask the question and set the question up in a way that actually gets an answer. And frankly, that's altogether too rare in congressional hearings.",
    "speaker_id": "SPEAKER_00",
