  {
    "episode_id": 92669,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92669.jsonl",
    "turn_idx": 84,
    "turn_text": "Yeah, thank you for that question. I'm 49 years old. I have served four and a half years in Congress. So I definitely look at my opportunity here in the Senate to have a runway to deliver for California, to learn more about what the state is facing. and to build power in Washington. I absolutely love campaigning, and one of the reasons that I want to be California Senator is so that I can help us win all of those tough races. I know people often think about California as it's a blue state, it's a democratic state, and that's true at the aggregate, but I think coming from Orange County and having spent a lot of time campaigning in some of the other parts of California, We have tough races and I feel I think my attraction to the Senate comes from a wanting actually to be able to help more win those tough races. I know how to do it. I love doing it. I've done it three times and I'm ready to help us do it again in every part and pocket in California. I think our goal has to be to deliver a durable majority. I think people are tired of winning and losing and winning and losing because it doesn't let us get the policies done that they care about whether that's a ban on congressional stock trading or passing gun violence prevention. We need a leader in California who's going to be all in in every campaign. The only kind of campaigns I've ever had are tough ones and I am absolutely ready and wanting to help in every tough campaign in California and around the country for years to come.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
