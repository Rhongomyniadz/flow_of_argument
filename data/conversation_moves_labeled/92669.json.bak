  {
    "episode_id": 92669,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92669.jsonl",
    "turn_idx": 45,
    "turn_text": "Money and power and how they're entangled is definitely one of the overarching themes of your memoir. And I do want to explore that a little bit. You say that in the House of Representatives, the privilege of wealth divides ruthlessly. Give us an example of what you mean.",
