  {
    "episode_id": 92669,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92669.jsonl",
    "turn_idx": 55,
    "turn_text": "You've also credited your staff at enabling you to be able to do your job effectively given all the unique demands on your time, at least unique for Congress, not unique for America, as Pat is pointing out. There have also been media reports right around the beginning of this year that you have mistreated staff. You've been called out by some previous staffers. I'm wondering how you respond to that.",
    "speaker_id": "SPEAKER_15",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Your staff has enabled you to perform your job effectively.",
        "confidence": 0.95
      },
      {
        "text": "The demands on your time are unique to Congress but not to America.",
        "confidence": 0.92
      },
      {
        "text": "There have been media reports early this year alleging mistreatment of staff.",
        "confidence": 0.9
      },
      {
