  },
  {
    "episode_id": 92669,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92669.jsonl",
    "turn_idx": 48,
    "turn_text": "Yeah, I think when I asked people about, you know, for advice about how to navigate as a single mom, how did they take care of their kids when our schedules unpredictable? Are there ways that we could make Congress work more efficiently and get more done by revisiting how we kind of travel in the schedule that we have? And one of the very common responses was, well, you know, your situation is so unique. You're a single mom. You're the only single mom in Congress. That part is true. But the situation, unique part is false. There are about 10 million people raising children on their own in this country. And just as we've seen workplaces try to better accommodate people's balancing their work and their family. And that produces a more productive, better workplace. It would be the same thing for our government if Congress ran in a way that made it possible for different kinds of people with different kinds of life circumstances to serve, not just the retired and the rich.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
