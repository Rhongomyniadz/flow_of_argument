  {
    "episode_id": 92669,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92669.jsonl",
    "turn_idx": 43,
    "turn_text": "Frank, thanks. Congress member reporter, your thoughts on what Frank is suggesting here?",
