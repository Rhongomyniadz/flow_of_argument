  {
    "episode_id": 94752,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94752.jsonl",
    "turn_idx": 109,
    "turn_text": "Here's what I got at the data. In 2022, we had a result that was quite contrary to what I thought, because I was looking at the polling data. close to the election. My background, I started out at a place called the Boston Consulting Group, very analytically oriented. We basically went back and looked at each state and tried to figure out what caused us to lose.",
    "speaker_id": "SPEAKER_15",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "In 2022, we observed a result that contradicted my expectations.",
        "confidence": 0.97
      },
      {
        "text": "I was reviewing polling data shortly before the election.",
        "confidence": 0.95
      },
      {
        "text": "My professional background includes working at the Boston Consulting Group.",
