  {
    "episode_id": 70866,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/0/70866.jsonl",
    "turn_idx": 108,
    "turn_text": "Well, I really hope it doesn't, but I've been very vocal recently that I'm concerned about the rhetoric on one side of the aisle. I mean, look, you can say all you want, well, gee whiz, it's going around everywhere, but it's not. You don't see this coming from the right. When Barack Obama was president, there were a lot of his policies that I disagree with that a lot of Republicans disagreed with, but threatening him, threatening harasses cabinet members, threatening his life was never acceptable. And any of us on our side would speak out just as people on the left would if something like that happened. I am real concerned about the radio silence when somebody on the left threatens violence against someone on the right. And it's happening over and over again. It's not equivocable. It's not happening on both sides. It's happening on the left against people on the right. And it's well documented. And it's got to stop and leaders on both sides need to call it out.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
