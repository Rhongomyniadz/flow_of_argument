  {
    "episode_id": 90825,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90825.jsonl",
    "turn_idx": 17,
    "turn_text": "Now, for the people that are processing in, what happens to them after they get processed in? Where does the Board of Patrol take them? When did they get released? How does that all",
    "speaker_id": "SPEAKER_00",
