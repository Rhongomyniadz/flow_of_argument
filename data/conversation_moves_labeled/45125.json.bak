    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The impeachment hearings in Washington were chaotic and difficult to follow.",
        "confidence": 0.95
      },
      {
        "text": "There was an overwhelming amount of information presented during the hearings.",
        "confidence": 0.92
      },
      {
        "text": "The speaker views the impeachment hearings as resembling a circus.",
        "confidence": 0.9
      },
      {
        "text": "The speaker wants the listener's thoughts on the hearings.",
        "confidence": 0.88
      },
      {
        "text": "The speaker questions whether the hearings contribute meaningfully to the impeachment process in Congress and the Senate.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "The listener has sufficient knowledge or perspective to offer meaningful evaluation of the hearings.",
        "confidence": 0.94
      },
      {
        "text": "A well-functioning impeachment process should be clear and coherent rather than chaotic.",
        "confidence": 0.91
      },
      {
        "text": "Public perception of legitimacy depends on how structured and understandable the process appears.",
        "confidence": 0.89
      },
      {
        "text": "The speaker believes that political processes should be accessible and comprehensible to ordinary observers.",
        "confidence": 0.86
      },
      {
        "text": "The speaker assumes that the hearings' chaos undermines their effectiveness in advancing impeachment.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Topic Shift"
  },
  {
    "episode_id": 45125,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45125.jsonl",
    "turn_idx": 7,
    "turn_text": "You know, I think you can boil the impeachment allegations down to sort of one or two sentences. We, the Congress, gave the President permission to send several hundred million dollars to Ukraine. The first half of it was to be sent in the beginning of last year, and President Trump did that. In fact, he did something that President Obama had refused to do, and that was to give lethal aid. President Obama was given the power to give lethal aid, but just on his own sort of decided not to do it. But President Trump did send lethal aid earlier in the year. The law that we wrote said you can send them the other half once you have certified six months later that they are making progress on corruption.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The second half of the funding could be released after a six-month certification of anti-corruption progress.",
        "confidence": 0.97
      },
