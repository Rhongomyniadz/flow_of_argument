  {
    "episode_id": 45125,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/5/45125.jsonl",
    "turn_idx": 10,
    "turn_text": "Yeah. Now, I recently saw an interview you did with Fox Business talking about the Sixth Amendment and how the president should have a right to confront the whistleblower. Could you elaborate on that a little bit more, please?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I recently saw an interview you did with Fox Business.",
        "confidence": 0.97
      },
      {
