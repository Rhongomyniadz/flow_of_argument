      },
      {
        "text": "Half of the funds were to be disbursed at the beginning of last year.",
        "confidence": 0.94
      },
      {
        "text": "Lethal aid was previously withheld by President Obama even though he had legal authority to provide it.",
        "confidence": 0.93
      },
      {
        "text": "The impeachment allegations can be summarized in one or two sentences.",
        "confidence": 0.92
      },
      {
        "text": "President Trump provided lethal aid to Ukraine, which President Obama declined to provide despite having the authority.",
        "confidence": 0.91
      }
    ],
    "assumptions": [
      {
        "text": "Summarizing complex political events into brief statements is both possible and meaningful.",
        "confidence": 0.9
      },
      {
        "text": "Congress has legitimate authority to delegate foreign aid decisions to the executive branch.",
        "confidence": 0.89
      },
      {
        "text": "Certification of anti-corruption progress is a credible and appropriate condition for releasing further aid.",
        "confidence": 0.88
      },
      {
        "text": "Sending lethal aid constitutes a significant policy departure and is morally/strategically noteworthy.",
        "confidence": 0.87
      },
      {
        "text": "The speaker believes their interpretation of the facts reflects a fair and balanced account of the situation.",
        "confidence": 0.86
      },
      {
        "text": "A president’s decision not to act when legally empowered should be considered a deliberate choice with implications.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
