  {
    "episode_id": 74080,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/4/74080.jsonl",
    "turn_idx": 94,
    "turn_text": "He cited some dole actor, some sort of law that allowed for them to stay mysterious about who is and who isn't getting money. Why on earth would we ever ethically speaking? I mean, legally, it sounds like a problem too. But ethically speaking, allow people to suggest that children age six months and higher, all the way up until we die in our 70s, 80s, and 90s. Everybody on the planet should get this vaccine. And oh, by the way, don't tell anybody, I'm getting my pockets lined. Rand, that's crazy to me. I don't understand. Thank God you brought it out. I didn't even know it was happening. How is that ethical at all?",
    "speaker_id": "SPEAKER_07",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "It is unethical to keep vaccination eligibility secret from the public.",
