  {
    "episode_id": 90465,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90465.jsonl",
    "turn_idx": 160,
    "turn_text": "The second question I wanted to ask you about this, and this will fall heavily on you as head of the Governor's Association, is the question of money and resources. And one of the things that the Republican Party has done so successfully over the last decade in particular is mobilize this money, dark money as well as not dark money. on behalf of their candidates. And we've seen in the first part of this year, with all of this enthusiasm, still a deficit between the parties where Republicans are raising more money than Democrats. Are you concerned that your candidates may fall prey to that?",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The Republican Party has successfully mobilized money, including both dark money and non-dark money, on behalf of its candidates over the past decade.",
        "confidence": 0.95
      },
      {
        "text": "In the first part of this year, despite high enthusiasm, Republicans have raised more money than Democrats.",
        "confidence": 0.92
      },
      {
        "text": "The speaker is asking the addressee, as head of the Governor's Association, whether they are concerned that their candidates might be negatively affected by the Republican fundraising advantage.",
        "confidence": 0.9
