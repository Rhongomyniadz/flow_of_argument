  },
  {
    "episode_id": 90465,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90465.jsonl",
    "turn_idx": 115,
    "turn_text": "Yeah, I think we in our state have been at least partly successful avoiding some of that acrimony. We had a bipartisan success in expanding",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
