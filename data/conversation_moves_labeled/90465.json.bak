  },
  {
    "episode_id": 90465,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90465.jsonl",
    "turn_idx": 87,
    "turn_text": "Well, very much so. It was a swing district when I started there in 98. I ran against an incumbent Republican who was a six-year, well-established person. But I believed we needed a change. And so I jumped into the fray. And one, again, unexpectedly, there were only two incumbent Republicans beat that year. But we made it happen, because again, I brought some conviction to the table, and it was a balancer swing district at the time. It's trended democratic now since I've been there.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
