  {
    "episode_id": 49301,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49301.jsonl",
    "turn_idx": 10,
    "turn_text": "So it's great to be here with you. As we face the threats today, the American people have to understand that these threats just didn't develop in the last couple of years. These are not George Bush's threats. These threats developed back in the 90s when we should have been doing more to stop proliferation. and understanding that the breakup of the Soviet Union really was causing their technology that they built to use against us in the Cold War to be able to be sold to our enemies.",
