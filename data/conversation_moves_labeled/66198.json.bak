  {
    "episode_id": 66198,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/6/66198.jsonl",
    "turn_idx": 20,
    "turn_text": "I think we should do away with the inheritance tax once and for all. We're talking about people's hard-earned income after taxes that they built for their own retirement, they built for their own security, and they built for their children and their grandchildren after them. And I think we want to see people building wealth, building a foundation for themselves and their families, and then without government showing up when they go home to be with the Lord, being able to pass that on and let their children and grandchildren live their dreams.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We should abolish the inheritance tax permanently.",
        "confidence": 0.97
      },
      {
        "text": "Inheritance represents hard-earned income that individuals have saved post-tax.",
        "confidence": 0.94
      },
      {
        "text": "People build wealth primarily for personal retirement, family security, and intergenerational transfer.",
        "confidence": 0.92
      },
      {
        "text": "The government should not interfere in the transmission of accumulated wealth upon death.",
        "confidence": 0.9
      },
      {
        "text": "Passing down wealth enables future generations to pursue their life aspirations.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "Individuals deserve full ownership over wealth they accumulate through effort.",
        "confidence": 0.95
      },
      {
        "text": "Wealth accumulation reflects moral merit and personal responsibility.",
        "confidence": 0.93
      },
      {
        "text": "Government intervention in estate transfers undermines personal freedom and autonomy.",
        "confidence": 0.92
      },
      {
        "text": "Intergenerational wealth transfer is essential for long-term family well-being and opportunity.",
        "confidence": 0.9
      },
      {
        "text": "Death is a natural endpoint where financial obligations to society cease.",
        "confidence": 0.89
      },
      {
        "text": "The speaker views wealth preservation as a form of legacy and dignity.",
        "confidence": 0.87
      },
      {
        "text": "Current inheritance tax policies discourage saving and investment behavior.",
        "confidence": 0.86
      },
      {
        "text": "Family-oriented values like continuity, care, and support are socially desirable and worth protecting.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 66198,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/6/66198.jsonl",
    "turn_idx": 23,
    "turn_text": "I mean, what, what, why does that make sense that because you die, you have to turn over a bunch of your wealth",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "It makes no sense that someone has to transfer their wealth upon death.",
