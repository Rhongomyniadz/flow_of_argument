  {
    "episode_id": 74691,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/4/74691.jsonl",
    "turn_idx": 196,
    "turn_text": "So, what do you say to the people who are like, I voted my whole life, I protested, I went to the rallies, I emailed, I called, and yet it feels like nothing has gotten better. What do you say to those people who's hope is challenged?",
    "speaker_id": "SPEAKER_06",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Some people have consistently engaged in political activism throughout their lives.",
        "confidence": 0.97
      },
      {
        "text": "These individuals have participated in voting, protests, rallies, emailing, and calling elected officials.",
        "confidence": 0.96
      },
      {
        "text": "Despite their sustained efforts, they perceive that societal conditions have not improved.",
        "confidence": 0.94
      },
      {
        "text": "The speaker is addressing individuals whose hope has been challenged by these experiences.",
