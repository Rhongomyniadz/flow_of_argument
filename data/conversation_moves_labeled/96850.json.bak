  {
    "episode_id": 96850,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/6/96850.jsonl",
    "turn_idx": 84,
    "turn_text": "You know, I just remember so many times in history where the new drug came along and it, two years later, 10 years later, was like, oh my gosh, this drug causes something. So I think it's got its place. And I think it's, something to get people to the right spot. But if you don't make some changes internally, if you don't reset your nutrition clock a little bit, if you don't start doing some exercise, I hope people can get off of it. This younger age group though, we've got to focus on nutrition programs. And here's the problem, I want to make sure everyone understands though, there's an affordability quotient to this as well. Um, look, I was fortunate to grow up on a farm where we had plenty of fresh fruits and vegetables and access to healthy meats as well. My grandparents had a dairy. So all the milk we could drink, but carbohydrates are cheap. Fresh fruits and vegetables are more expensive.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
