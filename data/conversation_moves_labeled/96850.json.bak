    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There is a shortage of primary care physicians in rural regions like rural Kansas.",
        "confidence": 0.96
      },
      {
        "text": "The cost of medical school has increased over time.",
        "confidence": 0.95
      },
      {
        "text": "People are being drawn toward super-specialties and urban centers rather than primary care in rural areas.",
        "confidence": 0.94
      },
      {
        "text": "Medical school has increasingly become a status-oriented profession.",
        "confidence": 0.92
      },
      {
        "text": "Rural communities have unmet needs for basic healthcare providers.",
        "confidence": 0.91
      }
    ],
    "assumptions": [
      {
        "text": "Higher education costs deter individuals from choosing lower-paying or less prestigious fields like rural primary care.",
        "confidence": 0.93
      },
      {
        "text": "Prestige and financial reward are significant motivators in career choices within medicine.",
        "confidence": 0.9
      },
      {
        "text": "Primary care in rural areas is undervalued compared to specialized urban practice.",
        "confidence": 0.89
      },
      {
        "text": "The current system fails to incentivize medical graduates to serve underserved populations.",
        "confidence": 0.87
      },
      {
        "text": "Fixing the problem requires systemic changes to medical training or compensation structures.",
        "confidence": 0.85
