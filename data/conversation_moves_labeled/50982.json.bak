    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/0/50982.jsonl",
    "turn_idx": 10,
    "turn_text": "So I want to ask a bigger picture question is why do you think you won this campaign?",
