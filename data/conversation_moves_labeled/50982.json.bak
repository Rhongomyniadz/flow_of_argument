        "confidence": 0.94
      },
      {
        "text": "Trespassing justifies prosecution.",
        "confidence": 0.93
      },
      {
        "text": "Destruction of property justifies prosecution.",
        "confidence": 0.92
      },
      {
        "text": "A misdemeanor trespass resulting in an $85 fine and no further consequences is acceptable.",
        "confidence": 0.91
      },
      {
        "text": "Most people accept minor fines for misdemeanors without long-term repercussions.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
