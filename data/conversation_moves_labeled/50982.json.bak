  {
    "episode_id": 50982,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/0/50982.jsonl",
    "turn_idx": 103,
    "turn_text": "To the extent that anybody violated the law, they should be prosecuted. And I don't have a problem with that, to the extent that they did engage, physically engage with police officers, to the extent that they trespass, to the extent that they destroyed property, prosecute them. But one of the hallmarks of our Constitution, and probably one of the most important provisions is the Equal Protection Clause. And we treat people who are similarly situated equally. That's really the hallmark of that. If you've got a situation where a misdemeanor trespass would be a $85 fine and don't get in trouble for six months, fine. I'm okay with that. Most of us are. When you are taking people and you are creating crimes out of whole cloth against administratively, what is it parading,",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
