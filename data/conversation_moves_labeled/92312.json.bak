  },
  {
    "episode_id": 92312,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92312.jsonl",
    "turn_idx": 43,
    "turn_text": "Yeah, I think we'll leave it there because I think that that's exactly right. One thing I harp on all the time is when you speak to people where they are, you speak about their material conditions, most often. Now, again, some people don't really have these concerns, but most people do. And I think when you can speak to people's material conditions, when you can try to improve people's material conditions, and improve just the social structure that we all share and feel like we all share it and feel like if we protect gig workers, if we give people time, you know, family leave, if we make sure that they're paid a decent wage, that everybody actually benefits from that. I think that that goes a long way into sustaining what I hope is going to start this week. That's what I hope.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We should end the discussion at this point.",
        "confidence": 0.95
      },
      {
        "text": "Speaking to people where they are is important.",
        "confidence": 0.92
      },
      {
        "text": "People commonly care about their material conditions.",
        "confidence": 0.9
      },
      {
        "text": "Improving people's material conditions contributes positively to society.",
        "confidence": 0.88
