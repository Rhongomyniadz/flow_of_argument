  {
    "episode_id": 71080,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71080.jsonl",
    "turn_idx": 21,
    "turn_text": "The shame of it all is that I am someone who's predisposed to look favorably on the idea of we need more government efficiency, a department of government efficiency. In theory, yeah, that sounds great. I'm on board. Let's make the government leaner and meaner and let's get better at doing the things we need to do. I don't think anybody would claim that the government is the most efficient thing in the world. but that the way that they're going about it you know with just a sledgehammer breaking various parts of the government is is really discouraging and and like you said and and now that that's done it seems to be time to just gut programs that that frankly lots of people rely on that you would think would be sacrosanct but apparently are not.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I am predisposed to support greater government efficiency.",
