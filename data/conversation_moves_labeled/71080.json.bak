  {
    "episode_id": 71080,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71080.jsonl",
    "turn_idx": 15,
    "turn_text": "It certainly seems like you can't cut something like that without affecting care. If they're reimbursing $0.60 on the dollar right now, if hospitals are, as you say, teetering on the brink, and that gets reduced further, if they suddenly are now only reimbursing hospitals at the rate of $0.55 on the dollar or $0.50 or $0.45 on the dollar, then it's hard to see how you live in that world without hospital closures or just reduced service, just the quality of care goes down or the volume of care goes down. And I think you'd have to see some really tough decisions about, do we just cut programs? Do we just, patients are just going to have to wait in much crappier hospitals now, speaking frankly? I think you face a real Sophie's choice there.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
