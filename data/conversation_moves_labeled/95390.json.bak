  {
    "episode_id": 95390,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95390.jsonl",
    "turn_idx": 31,
    "turn_text": "Politics doesn't have to be a raging fire, destroying everything in his path. Every disagreement doesn't have to be a cause for total war. and we must reject the culture in which facts themselves are manipulated and even manufactured.",
