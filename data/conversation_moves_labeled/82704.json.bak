  },
  {
    "episode_id": 82704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82704.jsonl",
    "turn_idx": 73,
    "turn_text": "And I guess that goes back to what I'm saying, which is we need to broaden our vocabulary. We need to talk about if we're talking about environmental issues, we're talking about global climate change, we're talking about the health impact, we're talking about the tourism dollars, we're talking about new emerging jobs. We need to broaden and talk about these things is more fulsome issues because they're fulsome issues. And if somebody only cares about the health impact, okay, like check, they heard me talk about it. If someone only cares about the new jobs, well, now we're actually talking about that as being related to, you know, pro-environmental policies. And so it's not changing. It's just broadening the things that we're talking about because they are really broad topics. And I think that far too frequently when we boil them down for, you know, kind of a brief comment here or there, a lot of that gets missed.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We need to broaden our vocabulary when discussing environmental issues.",
