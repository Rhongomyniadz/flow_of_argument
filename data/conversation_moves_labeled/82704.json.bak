  {
    "episode_id": 82704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82704.jsonl",
    "turn_idx": 38,
    "turn_text": "It's interesting that you were very much inspired to run by Republican attempts to undermine the Affordable Care Act, and you end up running on a platform of protecting the Affordable Care Act, and you prevail over an incumbent Republican, Dave Brad, who had been elected in 2014 as an outspoken opponent of the Affordable Care Act. That's right. And that strategy of focusing intently on healthcare as the issue as you no doubt know, was embraced and promoted by the House leadership, especially by Nancy Pelosi and races across the country. And it seemed to have worked out pretty well for the Democrats.",
