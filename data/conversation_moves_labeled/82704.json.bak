  },
  {
    "episode_id": 82704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82704.jsonl",
    "turn_idx": 53,
    "turn_text": "Because my priority is to get things done and solve problems, and that requires that we be bringing people into a conversation. And any sort of action that might stop that conversation before it even begins to happen, I think isn't serving the goal that I seek to pursue.",
