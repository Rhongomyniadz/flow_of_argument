    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Clarification Request (Specific)"
  },
  {
    "episode_id": 82704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82704.jsonl",
    "turn_idx": 59,
    "turn_text": "Members of Congress have a variety of responsibilities and my voters sent me here to talk about healthcare, to talk about good governance, to talk about the issues that are important to them. And so where, as a member of Congress, I will have to ensure that we are providing a good check and balance, that's an obligation and a duty that I will respect. But my priorities are serving the needs of the people in my district and addressing the issues that I ran on, and those are not issues that I ran on.",
