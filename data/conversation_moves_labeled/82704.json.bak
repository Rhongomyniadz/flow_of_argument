  },
  {
    "episode_id": 82704,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82704.jsonl",
    "turn_idx": 37,
    "turn_text": "So my decision to run for the house started in early 2017. I started just lightly considering it. I was displeased with the representation that we had in our district. But for me, the real crux of my decision came on the day the House Health Care bill vote because of the fact that we have dear friends who would have been tremendously impacted by that vote who were just representative in my mind of families across our district, across our country who were going to have their lives fundamentally impacted by a decision made by their elected representatives And it was a decision driven by ideology and just partisanship as opposed to real informed decision making as opposed to the best interests of the American people. And for me, I thought it was just a complete abdication of their responsibility as lawmakers to work in the best interests of their districts, their constituents in the country. And so that was the day that I decided that I was going to run. And I started putting the plan in place and launched the campaign two months later.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
