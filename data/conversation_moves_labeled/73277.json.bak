  {
    "episode_id": 73277,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/3/73277.jsonl",
    "turn_idx": 12,
    "turn_text": "Hey Congressman, this is Darvio. Thank you once again for joining us. We really appreciate this. Another issue that has been impacting Americans is the issues that we've been having with the supply chain. Can you talk a little bit about that? How we got there and what can be done to kind of fix that?",
