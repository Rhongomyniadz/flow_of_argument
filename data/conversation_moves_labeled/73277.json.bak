  {
    "episode_id": 73277,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/3/73277.jsonl",
    "turn_idx": 2,
    "turn_text": "Okay, well, my district is the sixth district of Ohio. If you look at it from the national map, it is the longest district east of the Mississippi. It runs from about an hour outside of Cleveland, all the way down the Mississippi, or I'm sorry, the Ohio River. The Ohio River dumps into the Mississippi, by the way. But all the way down the Ohio River to nearly Cincinnati. It borders Pennsylvania, West Virginia and Kentucky, 18 counties lined up end to end. It's a very diverse district, rich in energy resources, rich in agriculture. rich in manufacturing and those types of industries, a lot of veterans and seniors live in my district. We've got just a little bit of urban area up in the northern part of my district around Youngstown, but predominantly it is a very, very rural district. People live anywhere from two to five miles apart from one another. I love it because I'm a farm boy, mule farming, plow boy myself. And then 27 years in the Air Force after that, I relate to the people that I serve and I think that's a good combination.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
