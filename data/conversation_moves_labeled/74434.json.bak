    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Trump was talking a lot about the caravan of immigrants coming up from Central America.",
        "confidence": 0.97
