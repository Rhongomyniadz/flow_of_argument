  },
  {
    "episode_id": 74434,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/4/74434.jsonl",
    "turn_idx": 11,
    "turn_text": "But in this past election cycle, over 60% of Alabamaans did vote straight ticket. Obviously, President Trump is a big draw. So how do you motivate voters to cross over?",
