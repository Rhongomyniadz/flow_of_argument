  },
  {
    "episode_id": 92776,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92776.jsonl",
    "turn_idx": 22,
    "turn_text": "You know, everybody is seeing their little piece of the elephant, right? So, you know, Joe Biden should not have waited so long he should have gotten out earlier. No, Kamaharis should have said in answer to that question that there are lots of things she would have done differently or there are things she'll do differently now. Other people are saying we did not lean enough into abortion as an issue. Others say we lean too much into abortion as an issue. And everybody's projection of a particular problem is a reflection of their own politics and what they want. I mean, all of these are historical, hypothetical, counterfactuals. If we had done x, then we would have had a different result. If we had done y, we would have different results. So, ultimately, it's all inscrutable and indeterminate. And it's far more a reflection, not illegitimately, but it is a reflection of what we want to do now and the way we think we should be moving forward.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
