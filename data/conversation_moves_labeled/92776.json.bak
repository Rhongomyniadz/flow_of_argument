    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 92776,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92776.jsonl",
    "turn_idx": 10,
    "turn_text": "Representative Raskin has a lot of faith in American's ability to govern ourselves. Before he came to Congress, he was a constitutional scholar. It gives him this easy fluency with the levers of power in America. He's not shy about using those levers. His impeachment effort failed, of course, but he didn't stop there. In the primaries, he argued the 14th Amendment meant Trump should be kicked off the ballot because he engaged in insurrection. The Supreme Court disagreed. So Raskin took his argument to the American people. When he campaigned for Democrats around the country, he said, this year would set the direction for American politics for the rest of the century and be the definitive American statement on authoritarianism. Well, here we are. As an impeachment manager, you went on the floor and you quoted a Capitol police officer who sat despairing in the rotunda after January 6th, and he asked, is this America? And you said that is the question of this impeachment trial. I wonder if you feel like this election has given you a kind of answer to that question.",
    "speaker_id": "SPEAKER_06",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
