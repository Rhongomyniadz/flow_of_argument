        "confidence": 0.96
      },
      {
        "text": "Not everyone believes that living under rulers like kings, queens, monarchs, and dictators is problematic.",
        "confidence": 0.94
      },
      {
        "text": "The situation has never truly ended.",
        "confidence": 0.92
      },
      {
        "text": "Not everyone believes humans are capable of self-governance.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "There is a prevailing narrative that democratic governance represents progress, which requires justification when challenged.",
        "confidence": 0.93
      },
      {
        "text": "Some forms of rule (e.g., monarchy, dictatorship) may be seen as legitimate or acceptable by certain groups.",
        "confidence": 0.91
      },
      {
        "text": "Self-governance is a contested idea rather than a universally accepted truth.",
        "confidence": 0.89
      },
      {
        "text": "People’s beliefs about political legitimacy are shaped by historical experience and cultural context.",
        "confidence": 0.87
