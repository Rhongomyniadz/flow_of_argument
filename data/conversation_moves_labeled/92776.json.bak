  {
    "episode_id": 92776,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92776.jsonl",
    "turn_idx": 45,
    "turn_text": "Well, there are different theories now about what's going on here. I mean, I think the dominant theory is that Trump wants Gates, who's been a real attack dog for him to be his attorney general and wants to unleash him against perceived political enemies that Trump has everywhere from the government, to the press, to business, community, and so on. The other theory, though, is that Gates was facing a vote on releasing the ethics report about his alleged involvement in sex trafficking, women and underage women. And it was going to come out on Friday, theoretically, that's what most of my colleagues believe that it was going to be released on Friday. And in order to save face, Matt Gates resigned from Congress yesterday, and since he's no longer a member, as a former member, the standard practice has been not to release an ethics report.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
