  {
    "episode_id": 92776,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92776.jsonl",
    "turn_idx": 7,
    "turn_text": "Right now I'm reading a really interesting book by H.W. Brands called The First Civil War about how basically the country was split from the very beginning between those who were loyal to monarchy, autocracy, the merger of church and state, established religion, paranoia, superstition, dogma, and those who wanted to put government on a different basis, which is the consent of the governed, everybody being created equal, unalienable rights through life, liberty, the pursuit of happiness.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
