  {
    "episode_id": 71067,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71067.jsonl",
    "turn_idx": 72,
    "turn_text": "In order to have a real conversation about our nation's energy needs, it is important to look past the politics and focus on the facts. CleanPowerProgress.org is the online home for the campaign designed to educate Americans about the most practical and cost-effective path to a cleaner energy future. The online resource provides information collected mainly from the Environmental Protection Agency and the U.S. Census, founded by the Workers of the Labor's International Union of North America. Clean Power Progress works to educate advocates on the expansion of natural gas. Labor's General President, Terrio Sullivan, said it best.",
    "speaker_id": "SPEAKER_09",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "To have a real conversation about our nation's energy needs, it is important to look past the politics and focus on the facts.",
        "confidence": 0.97
      },
