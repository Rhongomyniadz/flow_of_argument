  {
    "episode_id": 71067,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71067.jsonl",
    "turn_idx": 105,
    "turn_text": "The AFL-CIO is a proud sponsor of America's Workforce Radio. United by efforts to raise wages, listeners to this show and workers all across America are beginning to turn a corner and drive the economic debate. The AFL-CIO is comprised of 12.5 million working people from 56 unions, but we stand with and fight for everyone who is working for a better life. For more information about our raising wages agenda, go to AFL-CIO.org.",
