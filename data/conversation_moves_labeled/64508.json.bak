  {
    "episode_id": 64508,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/4/64508.jsonl",
    "turn_idx": 35,
    "turn_text": "But boy, do I love Ohio. It's a wonderful state. It's a great place to raise children. It's a great place to worship. It's got so many wonderful things about it. And I think you're doing a great job of keeping your constituents happy",
