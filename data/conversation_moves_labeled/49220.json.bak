  {
    "episode_id": 49220,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49220.jsonl",
    "turn_idx": 9,
    "turn_text": "It is, I mean, it's, first of all, just it's the best. It's the best thing that's ever happened to me. And it's certainly a lot of work, but it's a lot of work for any new parent. That's just a reality of it. There's never a convenient time to have kids. My wife and I both work full-time. I obviously travel a fair bit back and forth, so we've got added complexities there. But being a dad is great because it both makes the job feel bigger and smaller, bigger in the sense that when we're debating climate change, when we're debating really the future of our democracy, when we're talking about gun violence issues, it just brings it home and it personifies what's at stake for me. But it also makes it feel smaller because what I look forward to in the evenings is not hobnobbing with Washington power brokers, it's going home and playing Legos with my son and it allows me to compartmentalize the anxieties and stresses of the job.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The experience of being a father is the best thing that has ever happened to me.",
        "confidence": 0.97
