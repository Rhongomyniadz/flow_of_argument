  {
    "episode_id": 49220,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49220.jsonl",
    "turn_idx": 23,
    "turn_text": "They tend to, and I say this broadly, because a lot of us do it in different ways. We tend to hold beliefs that are meant to signal to our peer sets, that we are virtuous, that we are educated, and yet don't actually contemplate and interrogate the real-world pragmatic effect of those beliefs on our neighbors. And I think the crystal clear personification of this was defund the police, which has got to be one of the worst political slogans, one of the worst initiatives ever conceived. I remember I was the chair of the public safety committee at my city council when that first came about I was running for Congress and a bunch of my primary competitors signed the defund the police pledge and I just wanted no part of it. We need well-funded law enforcement. We need district attorneys and police officers who take crime seriously, who recognize that for citizens and for small business owners, that property and violent crime is unacceptable, makes people feel unsafe, and it disproportionately harms low income people. The very people that some of its proponents are claiming to help. And we're seeing now with the backlash against DAs and others, and even in very progressive cities, that voters have had enough. They're sick of it.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
