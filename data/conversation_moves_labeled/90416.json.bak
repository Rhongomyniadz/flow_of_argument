  {
    "episode_id": 90416,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90416.jsonl",
    "turn_idx": 207,
    "turn_text": "We certainly have, we, I think when you have a constitutional right that the bar is higher to put those restrictions in place. It doesn't mean there's not more things we can do to take a look at. You know, we have laws, for example, that if you have mental health problems, you're not supposed to be allowed to buy a gun. That's when you buy a gun, you're supposed to go through a background check, right? You go to a sporting goods store and you buy a gun, you're supposed to go through a background check on you. So I mean, that's where I think we need to look at some of the root causes, because if you do have somebody that is going to be at risk for this, That's where we need the public and law enforcement and educators and everybody to step in and try to be able to be more preventive so that we can stop the people who are going to be at risk for this without taking away the rights from people who are law abiding citizens who are going to do the right thing.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
