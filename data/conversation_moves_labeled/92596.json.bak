  {
    "episode_id": 92596,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92596.jsonl",
    "turn_idx": 16,
    "turn_text": "is flawed because you still score points as the game goes on, whereas in an election, all of the votes are cast. And it's just a matter of which precincts, which ballot boxes, the pace of counting, but It's not that somebody is ahead or behind and therefore they're catching up and they're putting in more effort. We have the wrong mental framework for it and it leads to this ridiculous issue each election night and in a couple of cases for days or weeks afterwards where it seems like it's some kind of ongoing competition when it's about professionals doing their job counting ballots.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
