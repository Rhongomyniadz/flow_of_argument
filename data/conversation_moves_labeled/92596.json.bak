  {
    "episode_id": 92596,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92596.jsonl",
    "turn_idx": 119,
    "turn_text": "I think, generally speaking, and frankly, this is even kind of applicable to the best, kind of proudest moment experiences is take a moment separate from the emotion of the event, either really negative or really positive, and like ask what could have been better.",
