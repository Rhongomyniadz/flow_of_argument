      },
      {
        "text": "People use a mistaken mental framework when interpreting election returns.",
        "confidence": 0.92
      },
      {
        "text": "This flawed mental model causes absurd outcomes on election nights.",
        "confidence": 0.9
      },
      {
        "text": "The confusion sometimes persists for days or weeks after the election.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
