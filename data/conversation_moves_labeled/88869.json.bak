  {
    "episode_id": 88869,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/8/88869.jsonl",
    "turn_idx": 5,
    "turn_text": "Well, you know, it's probably going to be sometime around May 15th through June 1st. I mean, we've got some cliffs that are developing in the legislation. So I think that's a realistic time frame, maybe bleed over to June 15th. But that's why we have to get back to work. And if we're not going to go in person, I'm all supportive of going to person out of there last week. I think we can do that. But at least we should engage in technology and remote type of debating of legislation. We cannot have four people. Speaker Pelosi, Mitch McConnell, Kevin McCarthy, and Chuck Schumer. sitting in a room and deciding the fate of three hundred twenty a million americans and spending three to five trillion dollars by their edicts that is not good that is not going to be something i could support so we need to use technology to get back to work if we can't do it in person",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
