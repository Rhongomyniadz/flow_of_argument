  {
    "episode_id": 84776,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84776.jsonl",
    "turn_idx": 61,
    "turn_text": "right so uh... My wife and I, when we decided to consider this and bought a campaign bus, and we have three little kids, went out to our state for 16 months straight, did right around a thousand public events over that 16 months. We decided that we were going to view this as one six-year term, and then four and a half years into it, we'd sit down and prayerfully evaluate what we thought our next calling in life was, and that may very well be to run for re-election. But we didn't start by doing this with the idea that you're going to be here for 18 or 36 years. We have a six-year calling and four and a half years into it will reevaluate and see whether or not we've done good and whether or not we think we can continue to make a difference and whether or not the people in Nebraska want to rehire",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We have three children.",
        "confidence": 0.99
