      },
      {
        "text": "Al Gore used the term 'lockbox' frequently during his campaign.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "The speaker has reliable access to accurate data about entitlement budgets.",
        "confidence": 0.9
      },
