    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84776.jsonl",
    "turn_idx": 27,
    "turn_text": "I would say both. There's inside any broken institution. There's usually a lot of ability for people to admit in private some of what's broken. But there's a reticence. You think of all the children's literature metaphors of 800 pound gorilla. Elephant has no clothes.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There is often potential for people within a broken institution to privately acknowledge its flaws.",
        "confidence": 0.95
      },
      {
        "text": "People in broken institutions tend to be reluctant to publicly discuss their problems.",
        "confidence": 0.92
      },
      {
        "text": "The 'elephant in the room' metaphor is commonly used to describe an obvious issue that everyone avoids discussing.",
        "confidence": 0.9
      },
      {
        "text": "Children's literature frequently uses metaphors involving large animals to represent obvious but ignored problems.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "Private admission of institutional failure is more common than public acknowledgment.",
        "confidence": 0.94
      },
      {
        "text": "Public silence on institutional problems is due to fear, social pressure, or organizational culture.",
        "confidence": 0.91
      },
      {
        "text": "Metaphors like the elephant without clothes convey shared understanding of hidden truths among insiders.",
        "confidence": 0.89
      },
      {
        "text": "The speaker believes that acknowledging systemic flaws requires overcoming psychological or social barriers.",
        "confidence": 0.88
      },
      {
        "text": "Audiences familiar with children's literature will recognize and interpret these metaphors correctly.",
        "confidence": 0.86
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
