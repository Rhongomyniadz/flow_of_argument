    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "People have the ability to privately acknowledge truths that are widely known.",
        "confidence": 0.92
      },
      {
        "text": "Cameras are present in most areas where the Senate conducts its work.",
        "confidence": 0.9
      },
      {
        "text": "Classified spaces related to intelligence are excluded from camera coverage.",
        "confidence": 0.89
      },
      {
        "text": "The classified spaces around Intelligence are often productive bipartisan environments.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "There is a distinction between public and private acknowledgment of facts.",
        "confidence": 0.94
      },
      {
        "text": "Public acknowledgment of truth may be constrained by political or performative pressures.",
        "confidence": 0.91
      },
      {
        "text": "Bipartisanship is valued and achievable in certain restricted settings.",
        "confidence": 0.89
      },
      {
        "text": "The presence of cameras influences behavior in legislative settings.",
        "confidence": 0.88
      },
      {
        "text": "Classified intelligence spaces are inherently more conducive to cooperation than open ones.",
        "confidence": 0.86
