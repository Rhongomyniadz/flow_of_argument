    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I have a question for Tim this morning.",
        "confidence": 0.97
      },
      {
        "text": "The war in Ukraine and Vladimir Putin's alleged involvement in war crimes have been ongoing concerns for some time.",
        "confidence": 0.96
      },
      {
        "text": "I will let Tim go after asking the question.",
        "confidence": 0.95
      },
