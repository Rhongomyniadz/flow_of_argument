  {
    "episode_id": 43939,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/3/43939.jsonl",
    "turn_idx": 20,
    "turn_text": "have been decommissioned. Can you talk about that experiencing assembly and now in the house?",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
