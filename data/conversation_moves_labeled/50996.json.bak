        "confidence": 0.91
      },
      {
        "text": "The audience understands and accepts the use of irony or levity when discussing serious institutional failures.",
        "confidence": 0.89
      },
      {
        "text": "Political discourse involves shared human experiences beyond pure rational debate.",
        "confidence": 0.87
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
