  {
    "episode_id": 49620,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49620.jsonl",
    "turn_idx": 15,
    "turn_text": "Well, I watched your introduction, you know, your introductory announcement, I guess, of your candidacy. And you did indeed emphasize that, that this is so much more important than partisanship. But you spent a great deal of, and we're going to get to Max Miller, by the way, in the vote here in a moment, which is the primary reason I brought you on this morning. But let's talk about this and your status as an independent. You were I think by most accounts, including my own, and we've talked before, not on numerous occasions, but enough for me to get a feel for you. You were one of the more extreme partisans I feel like in the government. You were as left as left comes, maybe just shy of Bernie Sanders. You never declared yourself a socialist. But most of the policies you kind of stood for were very, very left of center. So how do you find your way to the middle here as an independent, now decrying partisanship?",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
