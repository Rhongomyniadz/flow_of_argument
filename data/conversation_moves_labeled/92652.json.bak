  {
    "episode_id": 92652,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92652.jsonl",
    "turn_idx": 83,
    "turn_text": "is shameful and we need to do better. So a couple of things we need to do. We focus first of all on the back end, people who've been unsheltered for the longest period of time, which is fine. We need to continue to do that. But we're not focusing on those who are recently unsheltered. those individuals after a few days, actually, that becomes home. And then more people come and that becomes family. More people come than that becomes a community. And then it becomes more difficult.",
    "speaker_id": "SPEAKER_07",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "It is shameful that current efforts to address homelessness are inadequate.",
        "confidence": 0.95
