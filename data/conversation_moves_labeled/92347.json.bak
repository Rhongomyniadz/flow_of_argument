  {
    "episode_id": 92347,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92347.jsonl",
    "turn_idx": 107,
    "turn_text": "Well, I certainly hope so. I mean, you know, I don't know the exact political dynamics facing Senator Susan Collins and Senator McCalsky and Mitt Romney and Kennedy and I don't know all of their situations, but I hope that all of them will begin to feel the weight of the responsibility that we certainly felt in the House. I mean, you think about the whole sweep of the American past and then you think about our children in the future and the future generations and what is going to be left for them. So if we allow a president to drag foreign powers into our elections and to use American resources to make that happen, American democracy will never be the same. What is to keep any president from dragging any particular power, whether it's despots and dictators or tyrants, or forcing democratic countries through the leverage of foreign aid to come and get involved for the president? I mean, that's a very dark turn.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
