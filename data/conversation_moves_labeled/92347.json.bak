  {
    "episode_id": 92347,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92347.jsonl",
    "turn_idx": 114,
    "turn_text": "On a happier note, a constitutional scholar, do you see America's resilience being able to rise above this and protect herself and prosper into the future? 100%.",
