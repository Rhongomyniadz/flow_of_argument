        "confidence": 0.91
      },
      {
        "text": "Members of Congress are not willing to show physical courage or bravery.",
        "confidence": 0.9
      },
      {
        "text": "Congress should demonstrate physical bravery when deciding on troop deployment and actions.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
