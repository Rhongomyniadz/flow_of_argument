  {
    "episode_id": 84578,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84578.jsonl",
    "turn_idx": 18,
    "turn_text": "I don't think U.S. should put troops in Ukraine. And constitutionally, we can't put troops in Ukraine unless it passes Congress. And right now, $60 billion worth of aid can't pass Congress. So I'm pretty sure putting U.S. troops on the ground can't pass Congress. Thank God that Lloyd Austin doesn't have the discretion to make that decision. I think one of the best votes I've cast so far was to object to the waiver that allowed him to become Secretary of Defense. I think he's been an absolutely horrible Secretary of Defense. And that comment is one of the ones that punctuates how bad the Secretary of Defense he's been.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
