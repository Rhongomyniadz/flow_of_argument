      },
      {
        "text": "Building an international coalition and planning offensive operations takes sufficient time to consult Congress.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "A shared national experience of war strengthens democratic legitimacy and accountability.",
        "confidence": 0.93
      },
