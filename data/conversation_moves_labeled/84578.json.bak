  {
    "episode_id": 84578,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84578.jsonl",
    "turn_idx": 23,
    "turn_text": "So you've also been active in debates about the government's surveillance authorities. What's the problem as you see it? And how do you think we should fix it?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
