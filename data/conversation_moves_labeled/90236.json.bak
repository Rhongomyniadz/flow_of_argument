  {
    "episode_id": 90236,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90236.jsonl",
    "turn_idx": 18,
    "turn_text": "That's exactly right. I mean, I tell people all the time, the House passed 396 bills that went to the Senate and sat on Harry Reid's desk. 396 of them. And by the way, a fair number of those, like 30% of those were democratic bills. And the vast majority of them, much more than 50% had bipartisan support. And yet, they go to the Senate majority leader, Harry Reid, and who's one of the most powerful majority leaders we've had in generations. And there they died. And it's very frustrating, I think, for the American people to see good positive legislation, legislation that actually addresses some of the critical issues of our day and yet not able to get it through the Senate. Hopefully now we have a little bit of a different mood over there and we can move some of these important bills.",
    "speaker_id": "SPEAKER_05",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
