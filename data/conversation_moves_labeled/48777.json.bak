    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Some Democrats currently hold the view that they should not work with members of the opposing party.",
        "confidence": 0.97
      },
      {
        "text": "These Democrats believe that working with the opposing party is unacceptable.",
        "confidence": 0.94
      },
      {
        "text": "Democrats who hold this view do not see their role as meeting the opposing party halfway.",
        "confidence": 0.92
      },
      {
        "text": "According to this perspective, it is the responsibility of the opposing party to come to Democrats' positions.",
