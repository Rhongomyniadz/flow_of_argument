  {
    "episode_id": 47118,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/7/47118.jsonl",
    "turn_idx": 65,
    "turn_text": "Well, Kelly, I asked the question that way because it's one of those things that drives me crazy that, again, conservatives wanting the government to dictate what two adults can do in terms of entering contracts into each other. It just doesn't make any sense to me.",
