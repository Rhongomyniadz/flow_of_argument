        "confidence": 0.94
      },
      {
        "text": "The listener values political discourse around reproductive rights.",
        "confidence": 0.91
      },
      {
        "text": "The speaker has sufficient credibility to judge the quality of political interviews.",
        "confidence": 0.9
      },
      {
        "text": "A well-articulated interview by a Republican on abortion reflects positively on the party’s potential to engage constructively.",
        "confidence": 0.88
