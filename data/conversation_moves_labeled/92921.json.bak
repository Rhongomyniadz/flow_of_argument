    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92921.jsonl",
    "turn_idx": 2,
    "turn_text": "All right, good deal. Thank you for being here. So has your mind wrapped around the idea that this time next month you will be a member of Congress?",
