  {
    "episode_id": 92921,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92921.jsonl",
    "turn_idx": 42,
    "turn_text": "Because you always have to make choices. This is a country that is a tremendous land of opportunity, even a day with all of our problems, certainly in comparison with many places around the world. There will always be more people seeking to come here than we have the ability to allow in. That's been true throughout most of our history. And so we have to be able to make rational choices about what's in American interests in terms of setting humanitarian priorities, of meeting job needs in this country, of meeting economic needs in this country, all of those things. But you can't have a meaningful discussion on that if you don't then enforce your decision by controlling the border and who's coming in. It has to be job one.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There will always be more people seeking to come to the United States than the U.S. can allow in.",
        "confidence": 0.95
      },
      {
        "text": "The United States is a country with significant opportunities compared to many other countries.",
        "confidence": 0.92
