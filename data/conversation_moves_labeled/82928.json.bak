  {
    "episode_id": 82928,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82928.jsonl",
    "turn_idx": 39,
    "turn_text": "Yeah, look, I always say if you had a thousand fifth graders and said, draw 32 units on this map of Texas, none of those thousand fifth graders would come up with the current lines that we have.",
