      },
      {
        "text": "Public trust in politicians increases when they consistently show up and participate in community life.",
        "confidence": 0.89
      },
      {
        "text": "Primaries often produce ideologically extreme representatives who lack incentive to compromise.",
        "confidence": 0.88
      },
      {
        "text": "General elections serve as a broader democratic test of legitimacy compared to closed primaries.",
        "confidence": 0.87
      },
      {
        "text": "Being perceived as authentic and respectful allows Republicans to build rapport even in overwhelmingly Democratic areas.",
        "confidence": 0.86
      },
      {
        "text": "Community events like Tardianas provide meaningful opportunities for political outreach and relationship-building.",
        "confidence": 0.85
      },
      {
        "text": "People are more open to dialogue when personal connections precede ideological debate.",
        "confidence": 0.84
      },
      {
        "text": "Effective governance requires representatives who prioritize common values over partisan identity.",
        "confidence": 0.83
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 82928,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82928.jsonl",
    "turn_idx": 32,
    "turn_text": "A lot of critics will say there'd be more competitive districts like yours if parties weren't in control of drawing these lines across the country after elections. Who do you think should draw district lines?",
    "speaker_id": "SPEAKER_08",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
