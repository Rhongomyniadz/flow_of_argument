  {
    "episode_id": 65911,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/5/65911.jsonl",
    "turn_idx": 53,
    "turn_text": "Well, Clay, it's vitally important. When I travel around my district and I've heard it a lot in Quincy, one of the biggest complaints we hear from employers is they can't find enough quality skilled workers. And not everyone's going to go to a four-year university and getting back to focusing on technical school and talking about both vocational school and trade school. That has to be part of the fabric of America. It has to be part of our next generation workforce. And if we want to keep this economy going, and so, yes, investing as the president said again, That was an issue last night that got bipartisan support on both sides, and it should. But if we got to invest, and I think you'll see bipartisan movement in the House to help fund that here in the next year, and we ought to do that, but it's important that we continue to find skilled labor and get young people involved in the trades and technical education and that will pay dividends long-term for us",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
