    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Citizenship matters.",
        "confidence": 0.97
      },
      {
        "text": "Citizenship matters a lot.",
        "confidence": 0.96
      },
      {
        "text": "If we do not enforce our borders, citizenship loses its value.",
        "confidence": 0.95
      },
      {
        "text": "A country cannot exist without borders.",
        "confidence": 0.94
      },
      {
        "text": "This is a government that is by the people, for the people.",
        "confidence": 0.92
      },
      {
        "text": "We must govern ourselves.",
        "confidence": 0.91
      },
      {
        "text": "It is necessary to know who our fellow citizens are.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "Enforced borders are essential to maintaining the legitimacy of citizenship.",
        "confidence": 0.93
      },
      {
        "text": "The value of citizenship depends on exclusivity and controlled access.",
        "confidence": 0.92
      },
      {
        "text": "Self-governance requires clear boundaries between citizens and non-citizens.",
        "confidence": 0.91
      },
      {
        "text": "There is a moral obligation to preserve national sovereignty through border control.",
        "confidence": 0.89
      },
      {
        "text": "Knowing who fellow citizens are is a prerequisite for democratic self-rule.",
        "confidence": 0.88
      },
      {
        "text": "The current government is representative of the people’s will.",
        "confidence": 0.87
      },
      {
        "text": "Borders serve as markers of political community and shared identity.",
        "confidence": 0.86
