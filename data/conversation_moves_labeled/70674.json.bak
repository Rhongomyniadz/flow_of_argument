    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Agree / Align"
  },
  {
    "episode_id": 70674,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/0/70674.jsonl",
    "turn_idx": 35,
    "turn_text": "Well, it's all about power and it's all about control. And, you know, someone once said it's not about who gets devoted, it's about who counts the vote. I've heard that numerous times even in the recent couple of years. We know it's not. It's about who cast the vote. And to me, We've got an election coming up here that a lot of people have got to pay attention to, that people think about these, you know, it's not November, so it's not that important an election. But May the 24th is a very important election in the state of Georgia. There's a lot of the nonpartisan going to be held elections and state boards, school boards, well, Secretary of State, this part of it. It's important that people get off their rear ends and get out and vote, but I always tell them it's important to vote, but it's even more important to vote",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
