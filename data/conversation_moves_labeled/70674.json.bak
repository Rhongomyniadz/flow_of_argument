  {
    "episode_id": 70674,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/0/70674.jsonl",
    "turn_idx": 50,
    "turn_text": "Yeah, great question. There are two primary responsibilities of the Secretary of State. One is the election side, the other is the business side, the licensing, permitting for businesses, all that sort of stuff, the corporate aspect. And from the election side of things, we have got to enforce the law. We have some great steps forward now with SB 202. We need leadership that will enforce the law. We need to investigate which the Secretary of State has robust investigative authority. When there are allegations of mismanagement or fraudulent activity, it needs to be investigated and where there is wrongdoing, there needs to be consequences. We've got to hold counties like Fulton County accountable for decades of wrongdoing there. We need a Secretary of State, I believe, who will stand up to right now to the Biden Department of Justice and say, in essence, we're not in Georgia going to participate in HR1. We're not going to let the federal government take over our elections here. The Constitution is clear. This is a state issue, the time, place, and manner of elections are left to the states, but the Democrats want to take that over. We've got to have leadership that will stand up to this national attempt, and we'll win that case, by the way, in the courts, because the Constitution is clear on those things.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
