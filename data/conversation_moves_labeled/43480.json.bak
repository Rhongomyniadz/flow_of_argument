      }
    ],
    "assumptions": [
      {
        "text": "Audiences expect justification, not mere assertion, when confronted with new ideas.",
        "confidence": 0.94
      },
      {
        "text": "Effective communication requires openness to critique.",
        "confidence": 0.93
      },
      {
