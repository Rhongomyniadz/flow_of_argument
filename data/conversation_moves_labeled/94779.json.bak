        "confidence": 0.91
      },
      {
        "text": "It was exciting to receive support for Michigan.",
        "confidence": 0.9
      },
      {
        "text": "Ruby Garcia was murdered by an illegal alien.",
        "confidence": 0.89
      },
      {
        "text": "This incident is part of a larger national issue involving illegal aliens.",
        "confidence": 0.87
      },
      {
        "text": "There have been multiple recent cases of violence linked to illegal aliens, including the Lake and Riley case.",
        "confidence": 0.86
      },
      {
        "text": "Families across the country are concerned about future incidents like this.",
        "confidence": 0.85
      },
      {
        "text": "The border crisis involves additional dangers beyond individual crimes.",
        "confidence": 0.83
      }
    ],
    "assumptions": [
      {
        "text": "The speaker believes that illegal aliens pose a significant threat to public safety.",
        "confidence": 0.95
      },
      {
        "text": "Supporting Michigan is a positive and meaningful gesture.",
        "confidence": 0.93
      },
      {
        "text": "Republicans' opposition to the border bill is irrational or unjustified.",
        "confidence": 0.9
      },
      {
        "text": "The media fails to adequately report on the severity of immigration-related crime.",
        "confidence": 0.89
      },
      {
        "text": "A bipartisan border bill represents a legitimate solution to the crisis.",
        "confidence": 0.88
      },
      {
        "text": "The listener has relevant knowledge or influence regarding the border bill.",
        "confidence": 0.87
