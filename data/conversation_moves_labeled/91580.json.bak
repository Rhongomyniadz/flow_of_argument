  {
    "episode_id": 91580,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/1/91580.jsonl",
    "turn_idx": 109,
    "turn_text": "I think that it's totally a moral issue. I don't believe that the state has the right to force our children to take a vaccine. Like she was saying, you know, it's not a disease that you can catch just from being next to someone. It's a disease that you have to catch from sexual activity. And I just, I think that it's a moral issue and I don't believe that the state has the right to force our children to have that vaccine.",
    "speaker_id": "SPEAKER_12",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
