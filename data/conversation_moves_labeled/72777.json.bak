  {
    "episode_id": 72777,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72777.jsonl",
    "turn_idx": 10,
    "turn_text": "Your thoughts of requirements on stores on corner stores and others that they would have to have a wider variety of foods to be able to service those who wanted to use their SNAP benefits.",
