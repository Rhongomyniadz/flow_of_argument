        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "Public opinion on foreign policy is shaped by partisan affiliation rather than consistent ethical principles.",
        "confidence": 0.91
      },
      {
        "text": "The U.S. government has a duty to take a unified position on international conflicts involving democracy versus authoritarianism.",
        "confidence": 0.89
      },
      {
        "text": "There exists a moral equivalence between supporting Israel and supporting Ukraine in the eyes of the public discourse.",
        "confidence": 0.87
