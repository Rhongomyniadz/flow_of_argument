  {
    "episode_id": 82329,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82329.jsonl",
    "turn_idx": 58,
    "turn_text": "Well, and I recently got publicly a bit of a debate with AOC, because she had introduced an amendment to restrict the ability of the military to advertise or recruit on gaming platforms like Twitch. And I said, look, this perpetuates this incredibly elitist trope, that the only reasons why people will enlist in the military is because they're a dumbing.duke. and rather the people that I, and you see this in the Upper East Side and the Upper West Side all the time, this attitude, when in reality we need to treat public servants such as them, just as we do treat graduates of Harvard. It's fascinating that you bring up Ivy League education because the notions of status, the notions of who are the elite, I think we have to fundamentally re-envision in the United States of America. So that's the first thing.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "AOC introduced an amendment to restrict military recruitment on gaming platforms like Twitch.",
