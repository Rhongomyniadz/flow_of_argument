    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Issues often persist over time without resolution.",
        "confidence": 0.95
      },
      {
        "text": "Action regarding the death tax is expected by 2025.",
        "confidence": 0.94
      },
      {
        "text": "Estate planning involves significant effort and financial cost by individuals preparing for their future.",
        "confidence": 0.93
      },
      {
        "text": "A decade or nearly 15 years ago, efforts were made to eliminate the death tax or increase its exemption threshold to benefit agriculture and small businesses.",
        "confidence": 0.92
      },
      {
        "text": "Some leaders in the administration and Congress oppose the current position and want to move toward eliminating or reducing benefits related to estate planning.",
        "confidence": 0.91
      },
      {
        "text": "Retirements in Congress lead to changes in the individuals involved in policy discussions.",
        "confidence": 0.9
      },
      {
        "text": "Congressman Jason Smith has become a key advocate in the House for maintaining stability and certainty around the death tax.",
        "confidence": 0.89
      },
      {
        "text": "The debate over the death tax has evolved from a fiscal/financial issue into a social justice framing based on excessive wealth transfer.",
        "confidence": 0.87
      },
      {
        "text": "Lowering the threshold and eliminating stepped-up basis are proposed measures to address perceived inequities in wealth transfer.",
        "confidence": 0.86
      },
      {
        "text": "There is growing concern among some stakeholders about the impact of shifting the framing of the issue toward social justice.",
        "confidence": 0.85
      }
    ],
    "assumptions": [
      {
        "text": "Individuals should be able to retain control over their accumulated wealth through planned transfers.",
        "confidence": 0.93
      },
      {
        "text": "Tax policies affecting estates reflect long-term personal investment and foresight rather than mere accumulation of wealth.",
        "confidence": 0.91
      },
      {
        "text": "Framing tax reform as a matter of social justice undermines legitimate economic planning and individual responsibility.",
        "confidence": 0.9
      },
      {
        "text": "Stepped-up basis is a critical component of fair estate valuation and supports intergenerational enterprise sustainability.",
