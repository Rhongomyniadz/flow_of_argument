      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Topic Shift"
  },
  {
    "episode_id": 72489,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72489.jsonl",
    "turn_idx": 24,
    "turn_text": "I didn't realize some of this until I researched the book, but in the very beginning, you know, when I think it was Ben Franklin asked the Pope about appointing the first American bishop, and the Pope said to him, who should we appoint as the first American bishop? Because they were used to getting agramaut with the European rulers, and Ben Franklin said, point anybody you want. First Amendment. And that was the first time, I think, for the Vatican, they thought, whoa, this is a totally different system here. And then, of course, the Ark and the Dove landed in Maryland, and the Jesuits found it in Maryland, and it was within a generation that they could have known property and had all this confiscatory laws.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I did not realize some of this information before researching the book.",
        "confidence": 0.95
      },
