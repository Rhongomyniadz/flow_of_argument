    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 71498,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71498.jsonl",
    "turn_idx": 17,
    "turn_text": "It changed very drastically, Alan, but it happened over time. I'm a lifelong Republican. I left the party a year ago because the party is a cult. Look, For years and years, the Republican party establishment ignored its base, ignored its voters. Its voters were scared and concerned and angry because there were so much fast change going out in America. The party ignored these voters. And so then when Donald Trump came along five years ago, a demagogue and said, I hear you, I'm going to build the wall and I'll make Mexico pay for it and all of that baloney. They all bought it. They all fought, they all said, all these voters said, finally somebody hears me and they clung to him and they're still clinging to him, which is why I think Donald Trump, if he wants to, the Republican Party is still his.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I am a lifelong Republican.",
        "confidence": 0.97
      },
      {
        "text": "For years, the Republican Party establishment ignored its base voters.",
        "confidence": 0.96
      },
