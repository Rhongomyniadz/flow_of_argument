      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 71281,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71281.jsonl",
    "turn_idx": 40,
    "turn_text": "No, no minority party ever votes for the opposition leader to be the speaker. I don't find the Republicans blaming this on Democrats to be",
