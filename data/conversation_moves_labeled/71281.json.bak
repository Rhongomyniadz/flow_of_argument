        "confidence": 0.94
      },
      {
        "text": "The United States needs greater stability in leadership.",
        "confidence": 0.93
      },
      {
        "text": "Matt Gaetz violated that rule yesterday.",
        "confidence": 0.92
      },
      {
        "text": "The Republican conference should change the House rules to raise the threshold for a motion to vacate above one vote.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
