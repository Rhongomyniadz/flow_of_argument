  {
    "episode_id": 90234,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90234.jsonl",
    "turn_idx": 17,
    "turn_text": "Well, it's very, I simplify. It's the same thing I did as a mayor. Before making any new commitments, I asked myself, is it affordable? Is it sustainable? And is it my job? In other words, is it Washington's job to make that decision? And it's very similar to the way that I make decisions here. I asked myself, is it affordable? Is it sustainable? Is it what the people of Utah send me to do? And if it doesn't fit those criteria, then it's an easy no. But I made some promises to the people of the Fourth District that I was going to get the decision making as close to them as possible. that I was going to make sure that Washington reigns in its spending, that we were going to treat the type of legislations that I choose to approve or pick up based on the same types of decisions I made as a mayor.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
