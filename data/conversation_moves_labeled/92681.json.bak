    "turn_type_label": "Substantive",
    "conversation_move_label": "Topic Shift"
  },
  {
    "episode_id": 92681,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92681.jsonl",
    "turn_idx": 19,
    "turn_text": "I think that is absolutely right. This was one of the not surprising, but at the same time terrible realizations from me over the last several years, which is there's really no flaw in our Constitution. There's no flaw in the impeachment remedy. I wouldn't want to change that remedy to allow an impeachment of a president with a simple majority vote. turn the Congress into a parliament. But a system really does depend on members of Congress giving content to those provisions, giving meaning to them as they were intended, discerning right from wrong and recognizing what the truth is and not trying to make their own truth. And in the absence of members of Congress employing that kind of good faith, it doesn't work. The system doesn't work.",
    "speaker_id": "SPEAKER_05",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
