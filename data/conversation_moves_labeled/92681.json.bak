    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92681.jsonl",
    "turn_idx": 55,
    "turn_text": "Though I have to note, you did have some particular disdain for Congress member and minority leader Kevin McCarthy in your book. You made a point to share an anecdote where you essentially said that McCarthy lies.",
    "speaker_id": "SPEAKER_08",
    "inferred_speaker_name": null,
