  {
    "episode_id": 92681,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92681.jsonl",
    "turn_idx": 4,
    "turn_text": "I want to start with what happens next on your committee investigating January 6th, if I could, and it's moved to pursue contempt of Congress charges against Steve Bannon. What will that contempt referral accomplish?",
