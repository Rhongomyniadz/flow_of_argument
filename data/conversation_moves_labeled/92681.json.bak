        "confidence": 0.95
      },
      {
        "text": "The speaker wants to discuss the consequences of the contempt referral against Steve Bannon.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Contempt of Congress charges have legal and political consequences beyond mere symbolic value.",
        "confidence": 0.94
      },
      {
        "text": "The audience understands the procedural significance of a contempt referral in congressional investigations.",
        "confidence": 0.91
      },
      {
        "text": "The speaker believes that pursuing contempt charges reflects a serious commitment to accountability.",
        "confidence": 0.89
      },
      {
        "text": "There is a shared understanding within the discussion context that the investigation into January 6th remains active and consequential.",
