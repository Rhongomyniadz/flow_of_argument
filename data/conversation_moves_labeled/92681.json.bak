        "confidence": 0.9
      },
      {
        "text": "The identities of those behind the insurrection should be pursued legally.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "Funding implies organized coordination rather than individual action.",
        "confidence": 0.95
      },
      {
        "text": "Traveling long distances and staying in hotels requires financial support.",
        "confidence": 0.93
      },
      {
        "text": "Information about funding and leadership exists and is accessible.",
        "confidence": 0.9
      },
      {
        "text": "Public accountability for the insurrection is morally necessary.",
        "confidence": 0.88
      },
      {
        "text": "Government institutions have the capacity to investigate and act on leads.",
        "confidence": 0.87
      },
      {
        "text": "The speaker has moral standing to demand answers about national events.",
        "confidence": 0.85
