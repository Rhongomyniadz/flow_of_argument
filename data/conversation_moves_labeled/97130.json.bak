        "confidence": 0.93
      },
      {
        "text": "Eli Velasquez had been ineligible to qualify as an accredited investor for approximately 20 years despite being close to meeting the threshold.",
        "confidence": 0.92
      },
      {
        "text": "Expanding the definition of accredited investors would better support future entrepreneurs.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "The speaker believes that personal experience with financial exclusion validates their position on policy reform.",
        "confidence": 0.93
