  {
    "episode_id": 84506,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84506.jsonl",
    "turn_idx": 152,
    "turn_text": "One complaint I've heard from people, even people who don't really follow politics closely, is the notion that in the U.S. Congress, if someone serves even one term, then once they leave, they've got this lifetime pension healthcare paid for, and that's all paid for by the taxpayers. Seems to me with term limits, there'd be that many more people that they'd have to support. How do you deal with that issue?",
    "speaker_id": "SPEAKER_06",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Some people believe that members of U.S. Congress receive a lifetime pension and healthcare after serving just one term.",
        "confidence": 0.92
      },
      {
        "text": "This benefit is funded entirely by taxpayers.",
        "confidence": 0.87
      },
      {
        "text": "Term limits would increase the number of former congress members requiring financial support.",
        "confidence": 0.85
      }
    ],
    "assumptions": [
      {
        "text": "The current system of benefits for former congress members is unsustainable under term limits.",
        "confidence": 0.9
      },
      {
        "text": "Lifetime pensions and healthcare for former representatives are widely perceived as excessive or unfair.",
        "confidence": 0.86
      },
      {
        "text": "Taxpayers should not bear the full cost of long-term benefits for political officials.",
        "confidence": 0.84
      },
      {
        "text": "A larger pool of former congress members due to term limits would strain public finances.",
        "confidence": 0.82
      },
      {
        "text": "There is a moral obligation to limit government benefits for elected officials based on service duration.",
        "confidence": 0.78
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Clarification Request (Specific)"
  },
  {
