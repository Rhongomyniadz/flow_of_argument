      },
      {
        "text": "The speaker's family has operated a ranch south of Valentine.",
        "confidence": 0.94
      },
      {
        "text": "The speaker's family are small business owners.",
        "confidence": 0.92
      },
      {
        "text": "The speaker has been running for the U.S. Senate for a long time.",
        "confidence": 0.91
      },
      {
        "text": "Other states should follow the example set by the voters in the speaker's state.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "The current type of people sent to Washington is responsible for systemic problems in government.",
        "confidence": 0.94
      },
      {
        "text": "A non-career politician with rural, entrepreneurial experience brings more integrity or effectiveness than career politicians.",
        "confidence": 0.93
      },
      {
        "text": "Voters in other states are capable of making better choices if they emulate the speaker's state.",
        "confidence": 0.92
      },
      {
        "text": "Returning to one's community after public service reflects commitment to local values over political ambition.",
        "confidence": 0.91
      },
      {
        "text": "Change in representation will lead to meaningful improvement in governance.",
