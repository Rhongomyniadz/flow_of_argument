  {
    "episode_id": 84506,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84506.jsonl",
    "turn_idx": 162,
    "turn_text": "Now that's something that has become so ingrained in Congress. There's a lot of money involved there. I mean, there are people who have family members as lobbyists, Vice President Biden being the most visible one. Do you think that you could get the support to actually get those measures passed and those rules changed?",
    "speaker_id": "SPEAKER_06",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Lobbying influence is deeply embedded in Congress.",
        "confidence": 0.95
      },
      {
        "text": "There is significant financial interest tied to lobbying activities in Congress.",
        "confidence": 0.92
      },
      {
        "text": "Vice President Biden has family members working as lobbyists.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "The presence of family members as lobbyists creates conflicts of interest.",
        "confidence": 0.94
      },
      {
        "text": "Financial incentives distort legislative decision-making in Congress.",
        "confidence": 0.91
      },
      {
        "text": "Changing entrenched lobbying practices requires political will and broad coalition support.",
        "confidence": 0.87
      },
      {
        "text": "Public trust in Congress depends on transparency and ethical integrity in policymaking.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 84506,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84506.jsonl",
    "turn_idx": 163,
    "turn_text": "Well, you know, we need to say change the type of person that we're sending to Washington. And I'm a rancher. My family ranches south of Valentine were small business owners. I'm not this career politician. I have been running for the U.S. Senate forever. But my goal is to go there and do the job and then come home. And that's what we hope to see other states due to the voters in other states. Because if we don't change the type of person that we're sending to Washington, we're never going to get it fixed.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We need to change the type of person sent to Washington.",
        "confidence": 0.97
      },
      {
        "text": "The speaker is not a career politician.",
        "confidence": 0.96
      },
      {
        "text": "The speaker is a rancher.",
        "confidence": 0.95
      },
      {
