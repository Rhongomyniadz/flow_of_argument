  {
    "episode_id": 84506,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/4/84506.jsonl",
    "turn_idx": 176,
    "turn_text": "Well, here again, I was very shocked when I learned that members of Congress could participate in insider trading. Citizens aren't allowed to do that. And what I mean by that is that members of Congress have access to information that citizens of this country don't. And it seems as though a few of them have taken advantage of that to become wealthy. That again is appalling, that that has been taking place in this country. I always used to wonder, how can you go to Washington as a public servant and make money? You know, here in Lincoln, you don't get elected to the legislature and become richer while you're down here. That's not what public service is about. You shouldn't be elected to an office to serve the people and then make money in that office.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
