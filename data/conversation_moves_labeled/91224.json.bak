    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 91224,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/1/91224.jsonl",
    "turn_idx": 25,
    "turn_text": "Speaking of the economic crisis, it is bad. And on Friday, the House of Representatives signed the bill that the Senate passed just a day earlier, and yet today we find a drop on Wall Street over 500 points. Do you think this bill was the right move?",
