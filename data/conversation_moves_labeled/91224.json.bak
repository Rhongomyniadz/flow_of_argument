    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 91224,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/1/91224.jsonl",
    "turn_idx": 32,
    "turn_text": "experiencing, and I think there will be a unified support with Republicans as well as the majority Democrats involved in this. I think that Barack Obama's one of his greatest strengths is his willingness to surround himself with very, very smart people. And this area, those very, very smart people include people like Warren Buffett like Bob Rubin, like Paul Volker, and others who are going to be giving him the best advice as to what we need to do in order to turn this around as quickly as possible and restore stability, confidence to the American people, get us back on a path of prosperity like we were on during the years of Bill Clinton's presidency.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Barack Obama's greatest strength is his willingness to surround himself with very smart people.",
        "confidence": 0.94
      },
      {
        "text": "The goal is to restore stability and confidence to the American people.",
        "confidence": 0.93
      },
