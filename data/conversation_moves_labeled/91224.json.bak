  },
  {
    "episode_id": 91224,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/1/91224.jsonl",
    "turn_idx": 28,
    "turn_text": "Now we've got to cross our fingers and hope it works because if it doesn't work, we're in a world of trouble.",
