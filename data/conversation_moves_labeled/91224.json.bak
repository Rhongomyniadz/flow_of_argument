    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 91224,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/1/91224.jsonl",
    "turn_idx": 29,
    "turn_text": "Right now, if Barack Obama gets elected, hopefully, and I'm knocking on wood there, Barack Obama will get elected, if he sees that this was not really the right move, that this was just nothing but a temporary band-aid on a hemorrhage, do you think that he's got the stuff to really do what it takes? In other words, to come up with programs, a la FDR, to turn things around, and is that possible today?",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Current measures are comparable to a temporary band-aid on a hemorrhage.",
        "confidence": 0.92
      },
      {
        "text": "Barack Obama might get elected.",
        "confidence": 0.85
      },
      {
        "text": "If Barack Obama gets elected, he may recognize that current measures are ineffective.",
        "confidence": 0.8
      }
    ],
    "assumptions": [
      {
        "text": "A leader should take decisive action when facing systemic crises.",
