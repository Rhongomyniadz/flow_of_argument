  {
    "episode_id": 49480,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49480.jsonl",
    "turn_idx": 7,
    "turn_text": "Well, you're absolutely right. That's exactly what it is. And I got to say, Congressman, I never growing up in this country through the late 70s, the 80s, into the 90s, I never imagined we could get to a place where we have one party and they couch it and they try to couch it in polite terms. But the fact of the matter is they are doing everything they can to institute total totalitarian control over every aspect of the lives of Americans. They want to control everything from the kind of vehicles we drive to how we can set our thermostat to what thoughts we can have in our head. How is this come about?",
    "speaker_id": "SPEAKER_05",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I agree with your assessment.",
        "confidence": 0.95
      },
      {
        "text": "The current political party is attempting to establish totalitarian control over American citizens.",
        "confidence": 0.92
      },
      {
        "text": "The speaker did not imagine this situation while growing up in the U.S. during the late 70s, 80s, and 90s.",
        "confidence": 0.9
      },
      {
        "text": "This effort includes controlling vehicle types, thermostat settings, and personal thoughts.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "Totalitarian control over daily life is possible within modern democratic institutions.",
        "confidence": 0.94
      },
      {
        "text": "There exists a single dominant political party actively pursuing systemic authoritarianism.",
        "confidence": 0.91
      },
      {
        "text": "Political discourse has become so degraded that even moderate language masks extreme intentions.",
        "confidence": 0.89
      },
      {
        "text": "Personal autonomy is being systematically eroded by state power under the guise of policy.",
        "confidence": 0.87
      },
      {
        "text": "The speaker views themselves as part of a community resisting ideological encroachment.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
