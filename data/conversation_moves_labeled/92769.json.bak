    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Added fees appear on airline tickets.",
        "confidence": 0.97
      },
      {
        "text": "Added fees appear on concert tickets.",
        "confidence": 0.96
      },
      {
        "text": "Connecticut Senator Richard Blumenthal is proposing legislation to remove added fees.",
        "confidence": 0.95
      },
      {
        "text": "In certain instances, added fees match the cost of the ticket itself.",
        "confidence": 0.94
      },
      {
        "text": "Senator Blumenthal refers to these fees as 'junk fees'.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Consumers should have full transparency about all costs associated with purchasing a ticket.",
        "confidence": 0.93
      },
      {
        "text": "Hidden fees are deceptive and undermine consumer trust.",
        "confidence": 0.91
      },
      {
        "text": "Legislative intervention is an appropriate mechanism to address unfair pricing practices.",
        "confidence": 0.9
      },
      {
        "text": "The term 'junk fees' reflects a widely shared public perception of these charges as unjustified.",
        "confidence": 0.88
      },
      {
        "text": "Audiences expect politicians to respond to consumer concerns about financial fairness.",
        "confidence": 0.87
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Topic Shift"
  },
  {
