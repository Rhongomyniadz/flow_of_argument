        "confidence": 0.93
      },
      {
        "text": "The speaker values updates on policy developments affecting the region.",
        "confidence": 0.91
      },
      {
        "text": "The outcomes of these issues matter to the broader community beyond direct stakeholders.",
        "confidence": 0.89
      },
      {
        "text": "It is reasonable to expect some movement over time on significant public policy matters.",
        "confidence": 0.87
      }
    ],
    "turn_type_label": "Substantive",
