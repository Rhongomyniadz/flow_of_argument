  {
    "episode_id": 95620,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95620.jsonl",
    "turn_idx": 6,
    "turn_text": "Nice. I think that's very admirable, your kind of connection to that, that local area. And I think a lot of people value that. So now that we've talked a little bit about what you've done for your current career, let's talk about your career now. So what exactly is your job as a congressman, representative?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
