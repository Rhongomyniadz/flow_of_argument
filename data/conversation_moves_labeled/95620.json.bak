  {
    "episode_id": 95620,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95620.jsonl",
    "turn_idx": 4,
    "turn_text": "Great. All right. To start off, Congressman Panetta, tell us a little bit about yourself. How did you start your career? What did you do before you were elected?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
