        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Admiration for community ties reflects a positive moral evaluation of civic engagement.",
        "confidence": 0.93
      },
      {
        "text": "The interlocutor’s status as a sitting congressional representative is publicly known or verifiable.",
        "confidence": 0.91
      },
      {
        "text": "Audience members generally share values around local belonging and public service.",
        "confidence": 0.9
      },
      {
        "text": "A shift from past achievements to present responsibilities is a natural progression in professional interviews.",
        "confidence": 0.89
