        "confidence": 0.96
      },
      {
        "text": "The speaker wants Congressman Panetta to describe his personal background.",
        "confidence": 0.94
      },
      {
        "text": "The speaker wants Congressman Panetta to discuss how he began his career.",
        "confidence": 0.93
      },
      {
        "text": "The speaker wants Congressman Panetta to share what he did prior to being elected.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Congressman Panetta is willing and able to provide information about his past.",
        "confidence": 0.95
      },
      {
        "text": "The speaker believes that understanding someone’s early career contributes to meaningful discussion.",
        "confidence": 0.94
      },
      {
        "text": "It is appropriate and expected for public figures to reflect on their personal history during interviews.",
        "confidence": 0.93
      },
      {
        "text": "The speaker views themselves as having the authority or role to ask questions in this setting.",
