  {
    "episode_id": 90466,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90466.jsonl",
    "turn_idx": 17,
    "turn_text": "Well, my dad worked for a bit, but not for very long. And the man who owned the store that he ran told them that he just wasn't capable of doing it anymore. So all of a sudden, my family, when I was a teenager, and again, I'm one of the older kids in my family, my sisters, 13 years younger than I am, so we ranged, a broad range. All of a sudden he didn't have a job and he didn't have an income. And my mom who'd stayed home, she'd had a few years of college but quit to get married and didn't have any skills, hadn't been working, had to all of a sudden take that responsibility of seven kids taking care of my dad who was ill and making sure we were all okay, it was rough.",
    "speaker_id": "SPEAKER_02",
