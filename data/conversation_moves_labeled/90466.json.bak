  {
    "episode_id": 90466,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90466.jsonl",
    "turn_idx": 14,
    "turn_text": "You know, I remember it well. From the time I was an early teenager, my dad would fall down very easily. I remember one time he fell down and somebody walking towards us looked at him and called him a drunk and my dad didn't drink. And so, you know, as a kid, you're kind of, this just doesn't feel good. But it was at a time when healthcare was expensive for families. They didn't go check it out. And so it took probably three or four years before they finally did. And he got the diagnosis. And MS is not easy to diagnose. Certainly wasn't thin. So it took a while. And, you know, but that was life-changing for a family.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "My father frequently fell down starting from when I was an early teenager.",
        "confidence": 0.97
      },
      {
        "text": "My father did not consume alcohol.",
        "confidence": 0.96
      },
      {
        "text": "Multiple Sclerosis (MS) is difficult to diagnose.",
