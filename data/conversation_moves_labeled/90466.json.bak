  {
    "episode_id": 90466,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90466.jsonl",
    "turn_idx": 197,
    "turn_text": "Well, first of all, let me just say that, yes, we defeated the repeal effort in the Senate by three votes, but it was really defeated by the hundreds of thousands of Americans who stood up and fought against an irresponsible bill.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We defeated the repeal effort in the Senate.",
        "confidence": 0.97
      },
      {
        "text": "The defeat occurred by a margin of three votes.",
        "confidence": 0.95
      },
      {
        "text": "Hundreds of thousands of Americans stood up against the bill.",
        "confidence": 0.94
      },
      {
        "text": "The bill was described as irresponsible.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
