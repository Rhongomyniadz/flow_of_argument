    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I learned an important lesson from that experience.",
        "confidence": 0.97
      },
      {
        "text": "One option is to stay at home and complain about negative events affecting oneself or others.",
