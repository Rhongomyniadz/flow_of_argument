  {
    "episode_id": 90466,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90466.jsonl",
    "turn_idx": 50,
    "turn_text": "I think by anger is what I would say. They just could not get away with this because it was a put down to me that I couldn't make a difference because I was a mom in tennis shoes. But it was a put down to every single person in the state by saying, you don't make a difference. You're not important. Well, I grew up believing that everybody is important and that we all contribute in different ways. And I thought our voices are just as important as yours. I don't care if you're a tall guy in a dark suit with a red tie and you look important or if you're just a mom in tennis shoes. You have a right to have a say. And that's what we did and we fought",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Appearance does not determine the legitimacy of someone's voice.",
        "confidence": 0.96
      },
      {
        "text": "Anger is what I would say.",
        "confidence": 0.95
      },
      {
        "text": "Anyone, regardless of status or attire, has the right to participate in public discourse.",
        "confidence": 0.95
      },
      {
        "text": "I believe that every individual has inherent importance.",
        "confidence": 0.94
      },
      {
        "text": "Our voices are equally valid compared to those in positions of power.",
        "confidence": 0.93
      },
      {
        "text": "They could not get away with this act because it was a personal affront to me.",
        "confidence": 0.92
      },
      {
        "text": "People contribute to society in diverse ways.",
        "confidence": 0.91
      },
      {
        "text": "The act was a devaluation of my identity as a mother wearing tennis shoes.",
        "confidence": 0.9
      },
      {
        "text": "We took action and fought back against this injustice.",
        "confidence": 0.9
      },
      {
        "text": "The act also insulted everyone in the state by implying they were unimportant.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "Public participation should be based on equal dignity rather than formal status or appearance.",
        "confidence": 0.93
      },
      {
        "text": "Civic resistance is justified when fundamental equality is challenged.",
        "confidence": 0.92
      },
      {
        "text": "Being dismissed due to gendered or class-based stereotypes undermines democratic values.",
        "confidence": 0.91
      },
      {
        "text": "Powerful individuals typically use symbolic cues like suits and ties to assert dominance.",
        "confidence": 0.9
      },
      {
        "text": "A collective sense of worth is tied to being recognized as having influence.",
        "confidence": 0.89
      },
      {
        "text": "Moms in casual clothing represent a marginalized group whose contributions are often undervalued.",
        "confidence": 0.88
      },
      {
        "text": "Dismissing ordinary people erodes trust in institutions and civic engagement.",
        "confidence": 0.87
      },
      {
        "text": "Injustice becomes more meaningful when it targets shared identities within a community.",
        "confidence": 0.86
      },
      {
        "text": "The speaker’s identity as a mother gives her moral standing in political discourse.",
        "confidence": 0.85
      },
      {
        "text": "Emotional response like anger signals legitimate moral outrage in the face of disrespect.",
        "confidence": 0.84
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
