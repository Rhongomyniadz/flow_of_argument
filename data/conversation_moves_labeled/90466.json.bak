  {
    "episode_id": 90466,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90466.jsonl",
    "turn_idx": 114,
    "turn_text": "Well, after winning the state senate seat, I loved being involved in the policy decisions and working issues through. Never dreamed that I'd go on from there, but I came home one weekend and watched the Clarence Thomas hearings. on the TV and I just was stunned that this was my United States Senate. These were the people representing me. And I remember saying to some friends, there's nobody there saying what I would say. And I said that night, I'm going to have to run for the Senate because they need somebody to say what I would say. And nobody thought I had a chance. I mean, obviously.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
