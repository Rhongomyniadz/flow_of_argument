  {
    "episode_id": 72789,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72789.jsonl",
    "turn_idx": 17,
    "turn_text": "Senator, you've been outspoken on child nutrition reform and wanting to make sure that kids are provided the best in nutrition. Some still are adamant that the child nutrition reform would include flexibility. Is there compromise in the works?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
