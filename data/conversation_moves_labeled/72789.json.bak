  {
    "episode_id": 72789,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72789.jsonl",
    "turn_idx": 16,
    "turn_text": "Well, I think it has to be as soon as possible. And from my standpoint, that's why I've been out and engaged in offering to play a leadership role in helping to find that common sense solution We have to have industry being willing to step up and wanting to do that and negotiate and do that. And I've been also working with those who want to see mandatory labeling to work with them on an approach that would meet the needs of consumers but do it in a way. that is effective and supportive of industry and biotechnology. So what we need are willing partners right now. So if folks want to find a solution, I really believe that there is a solution out there. And personally, I think it needs to be done as soon as possible. I'm willing to work with anybody who wants to work to get that done.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
