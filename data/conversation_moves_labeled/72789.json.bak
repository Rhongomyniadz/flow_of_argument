  {
    "episode_id": 72789,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/2/72789.jsonl",
    "turn_idx": 19,
    "turn_text": "Some school systems are financially strapped to the point of laying off teachers are not replacing those that are retiring and providing more vegetables, providing fresh fruits is a cost burden. Is there more money from Washington that can help these school systems meet the challenge of better nutrition for kids?",
