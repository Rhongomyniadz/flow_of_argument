  {
    "episode_id": 76905,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/6/76905.jsonl",
    "turn_idx": 11,
    "turn_text": "Voting on the bill called the authorization for the use of military force was brought forward. And just hours after the service, all 435 members of Congress gathered for the vote. Barbara Lee faced her colleagues and took a deep breath.",
    "speaker_id": "SPEAKER_06",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
