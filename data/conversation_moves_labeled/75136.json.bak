  {
    "episode_id": 75136,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/5/75136.jsonl",
    "turn_idx": 16,
    "turn_text": "There's some talk about the pros and cons. Some of the other industries have some concern about it. But my goal is not to have the federal government make the decision on what we use on our roads and bridges as far as surface. It allows the local engineers, I'm all about bringing it as local as I can. And that's what I'm most proud of, that the federal government does not decide. what goes on our roads. It's the local engineers and those local project managers.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
