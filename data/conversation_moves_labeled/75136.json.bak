        "confidence": 0.94
      },
      {
        "text": "Saving money on jobs increases available funding for additional jobs.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Congress has legitimate authority over infrastructure spending decisions.",
        "confidence": 0.93
      },
      {
        "text": "The President’s approval is necessary for infrastructure investments to take effect.",
        "confidence": 0.91
      },
      {
        "text": "Cost savings from job-related expenditures directly translate into increased budget capacity.",
        "confidence": 0.89
      },
      {
        "text": "More funding enables the creation of more jobs in infrastructure projects.",
        "confidence": 0.87
      },
      {
        "text": "Efficiency gains through cost reduction are desirable outcomes in public policy.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 75136,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/5/75136.jsonl",
    "turn_idx": 27,
    "turn_text": "That's exactly right. We know that when you invest the right way being prudent with the dollars, you can stretch them a long way. And we know that in the federal government, there's areas of bending that we can reduce programs that may not be working as well as they originally thought, so it's definitely a great discussion.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
