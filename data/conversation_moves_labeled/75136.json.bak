  {
    "episode_id": 75136,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/5/75136.jsonl",
    "turn_idx": 7,
    "turn_text": "You're a new face here on the congressional scene. What are the people in your district saying about infrastructure? Do you hear about that when you're talking to them or are they off on other things that they would think might be more important?",
