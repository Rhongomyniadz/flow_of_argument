        "confidence": 0.91
      }
    ],
    "assumptions": [
      {
        "text": "The government has the capacity to influence inflation through policy measures.",
        "confidence": 0.96
      },
      {
        "text": "Economic stability requires balancing growth and price control.",
        "confidence": 0.94
      },
      {
