  {
    "episode_id": 73272,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/3/73272.jsonl",
    "turn_idx": 41,
    "turn_text": "Isn't that the ideal in, I guess, a democracy or a democratic government? The ideal is everybody go vote. I never realized this, but in some countries it's like a law. You have to vote. It's not a suggestion. You better show and be able to show your proof that you voted. Because we are all about freedoms and stuff. We don't like to hear things like that. But if that's really effective, but then we also have the same idea. I did a show a little while ago about gerrymandering and how that's been around for over 200 years. And yet everyone that looks at it considers it a corruption of the electoral process because the politicians are picking their voters rather than the voters are picking the politicians. I don't know. I think we've lived with it so long that people don't even realize, I think, what this is.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
