    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/6/96863.jsonl",
    "turn_idx": 63,
    "turn_text": "But you all particularly talked about super precedence with Amy Coney Barrett, you know, as it related to Roe v Wade. So what do we need to worry about this bill and how do you sort of see it playing out with the court?",
    "speaker_id": "SPEAKER_06",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
