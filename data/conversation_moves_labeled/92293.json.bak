  {
    "episode_id": 92293,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92293.jsonl",
    "turn_idx": 22,
    "turn_text": "Well, we'll send you a copy of our comments so you and your staff can see how we're responding to USDA in this first scoping. But first and foremost, it's important that farmers and ranchers that we are listened to. We are the frontline conservationists. As you know, we have to be at the table and I hope that we can continue to impress upon USDA that let's first give credit where credits do, that we first need to reflect and articulate, quantify all the great things that we're already doing every day and have been doing for some time that truly have made a difference. You look at Missouri, you look at the $1.10 sales tax for state parks and soil conservation. That soil conservation effort has Obviously had environmental impacts, positive environmental impacts. So we're going to continue to stress that, okay, it's not just about what's going forward and asking more of us, but let's appreciate what we have been doing for some time in terms of environmental progress.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
