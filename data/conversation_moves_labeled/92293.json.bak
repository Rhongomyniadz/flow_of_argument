  },
  {
    "episode_id": 92293,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92293.jsonl",
    "turn_idx": 26,
    "turn_text": "Go get them. Appreciate you. All right. Next up, Mr. Tanksley, we'd love to hear from you. What's what's the latest from Jefferson City more specifically from the Capitol?",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The speaker wants Mr. Tanksley to begin speaking.",
        "confidence": 0.95
