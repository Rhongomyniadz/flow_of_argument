        "confidence": 0.92
      },
      {
        "text": "Farmers and ranchers are frontline conservationists.",
        "confidence": 0.9
      },
      {
        "text": "It is important to acknowledge and quantify past conservation efforts by farmers and ranchers.",
        "confidence": 0.9
      },
      {
        "text": "Missouri’s $1.10 sales tax supports both state parks and soil conservation.",
        "confidence": 0.89
      },
      {
        "text": "Farmers and ranchers must be included at decision-making tables.",
        "confidence": 0.88
      },
      {
        "text": "The Missouri soil conservation program has produced measurable positive environmental impacts.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "USDA currently underappreciates existing farmer-led conservation work.",
        "confidence": 0.93
      },
      {
        "text": "Recognizing past contributions increases credibility and trust in future collaboration.",
        "confidence": 0.91
      },
      {
        "text": "Environmental progress can be quantified and measured objectively.",
