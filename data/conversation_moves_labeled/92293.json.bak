    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The President Obama's goal was for 30% of productive land to be conserved within 30 years.",
        "confidence": 0.95
      },
      {
        "text": "This conservation goal is potentially being reconsidered with an accelerated timeline.",
        "confidence": 0.9
      },
      {
        "text": "Democrats in Washington, including Senator Schumer and Speaker Pelosi, perceive a short-term political opportunity related to land conservation.",
        "confidence": 0.88
