      {
        "text": "Acknowledging past achievements makes stakeholders more receptive to new demands.",
        "confidence": 0.85
      },
      {
        "text": "Public funding mechanisms like sales taxes indicate societal value placed on conservation.",
        "confidence": 0.84
      }
    ],
    "turn_type_label": "Substantive",
