  {
    "episode_id": 92293,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/2/92293.jsonl",
    "turn_idx": 8,
    "turn_text": "Well, absolutely. We certainly appreciate your time. It's a great time coming off of the president's first joint address to Congress. So I'm sure you've had some time to kind of collect your thoughts on what you heard. And maybe that's a great place to start, Senator.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We appreciate your time.",
        "confidence": 0.97
      },
      {
