  {
    "episode_id": 73270,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/3/73270.jsonl",
    "turn_idx": 67,
    "turn_text": "Well, yeah, probably more, you know, all in, but I will tell you when in my races, you know, on Long Island, I need. needed between a million three and two million every two years to run. And I was a, thank God, I was a popular incumbent. I had a few stiff challenges. And that's where I had to raise two million. But in a typical year where I knew I was going to win, I still had to spend 1.3 million. So multiply that by 435 members of Congress. Some don't have races, they don't spend nearly that, but some have races where 8 to 10 million will be spent all in. It takes a lot of time to raise that money, and our time would be better spent figuring out how we can agree rather than how we can defeat each other.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
