  {
    "episode_id": 86550,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86550.jsonl",
    "turn_idx": 9,
    "turn_text": "Yeah, it's like telling Americans we don't trust you to spend your your tax refund appropriately. So we're going to direct you that you only get a 12th of it every month. That's just, we believe that you can make the best decisions using your own money the way that you want. So when you get that tax refund, you should just get it all at once instead of the government actually receiving interest income by not paying you all of what they owe you.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The government withholding part of a tax refund violates trust in citizens' financial judgment.",
        "confidence": 0.95
      },
      {
        "text": "Releasing a tax refund in full at once allows individuals to make better financial decisions.",
        "confidence": 0.93
      },
      {
        "text": "Monthly disbursement of a tax refund gives the government access to interest income on funds owed to taxpayers.",
        "confidence": 0.9
      },
      {
        "text": "Taxpayers should receive their full refund immediately upon eligibility.",
        "confidence": 0.88
      },
      {
        "text": "Delaying payment of refunds amounts to the government profiting from taxpayer funds.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "Individuals are competent to manage their own finances without governmental oversight.",
        "confidence": 0.94
      },
      {
        "text": "Government institutions prioritize fiscal gain over citizen autonomy when managing refunds.",
        "confidence": 0.91
      },
      {
        "text": "Trust in citizens’ decision-making is more important than administrative control over funds.",
        "confidence": 0.9
      },
      {
        "text": "Interest earned by the government during delay constitutes unjust enrichment.",
        "confidence": 0.89
      },
      {
