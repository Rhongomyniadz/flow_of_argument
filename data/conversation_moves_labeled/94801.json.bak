  {
    "episode_id": 94801,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94801.jsonl",
    "turn_idx": 23,
    "turn_text": "Well, I think the institution of the Senate with the requirement of a supermajority to stop debate before you get the finality on a bill forces bipartisanship. And, you know, people would think I was bragging if I said I work in a bipartisan way. And I say that two ways. One, pretty difficult to prove, but there isn't a senator I dislike. And if anybody dislikes me, I don't want to know who their name is. And secondly, I refer people to the Georgetown University website to go on to click on to. Senator Luger's center and once a year they give index of bipartisanship in the United States Senate and I've never worse off than 12 out of 100 and sometimes I've been as good as five out of 100 so I think that that centers shows that at least the surveys show that I work in a bipartisan way. And I think that's how you get along with very liberal people and very conservative people.",
    "speaker_id": "SPEAKER_05",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
