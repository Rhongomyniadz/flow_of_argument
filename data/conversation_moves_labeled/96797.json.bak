  },
  {
    "episode_id": 96797,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/6/96797.jsonl",
    "turn_idx": 14,
    "turn_text": "Well, I'm optimistic that I'm always been optimistic. I mean, I'm a business guy. So if you're not optimistic, you're not getting anywhere. But I'm also realistic. We've got Democrats in DC that, you know, they don't want to balance the budget. They want to spend your money. So if they keep doing that, this inflation is not going to get under control. I don't see Biden caring about the border. But I'm optimistic we now have the House. As you know, I ran against Mitch McConnell to be the Republican leader in the Senate. And I think the fight that they had in the House over a leader or over a speaker is going to be good because we're going to start doing the things that Republicans around the country care about.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
