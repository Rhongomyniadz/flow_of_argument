      }
    ],
    "assumptions": [
      {
        "text": "The public believes current sentencing reports reflect actual time served, which creates false security.",
        "confidence": 0.92
      },
      {
        "text": "People value predictability and certainty in criminal justice outcomes.",
        "confidence": 0.91
      },
      {
        "text": "Victims deserve transparency about the actual consequences of convictions.",
        "confidence": 0.9
      },
      {
        "text": "The current system incentivizes manipulation through discretionary credits and exceptions.",
        "confidence": 0.89
      },
      {
        "text": "Mandatory minimums increase perceived fairness and deterrence in sentencing.",
        "confidence": 0.88
      },
      {
        "text": "Increased accountability in sentencing leads to greater societal safety.",
        "confidence": 0.87
      },
      {
        "text": "The term 'sentence' in media reporting refers to total calendar time, not time served.",
        "confidence": 0.86
      },
      {
        "text": "There is widespread misunderstanding among citizens about how prison time is calculated.",
        "confidence": 0.85
      },
      {
        "text": "Legislative changes mandating fixed percentages improve trust in the justice system.",
        "confidence": 0.84
      },
      {
        "text": "Prisoners benefit from knowing their maximum possible release date under a transparent system.",
