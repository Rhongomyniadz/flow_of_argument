  {
    "episode_id": 90943,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/0/90943.jsonl",
    "turn_idx": 87,
    "turn_text": "Doug, thank you very much. I'm here with Doug Collins, the author of The Clock and The Calendar, and a great book, and I think it really does exactly what you suggest, and that is, is this an aberration of the work that we do in Congress, or is this the beginning of a slide downhill? Thank you very much for writing the book and for being with us today. Thank you, Ken. I've enjoyed being here.",
    "speaker_id": "SPEAKER_07",
    "inferred_speaker_name": null,
