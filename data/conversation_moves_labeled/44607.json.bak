  {
    "episode_id": 44607,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/4/44607.jsonl",
    "turn_idx": 21,
    "turn_text": "It really comes from my time traveling around and working in Africa. It's It was just amazing to see at the local health clinics and some of the villages I'd be there, the moms and their children that are looking for simple things like vaccinations and treatments for malaria. And just the simple steps that we can take that would literally just cost us pennies to make such a profound difference in the lives of these people who really deserve it. We're all human beings, we all have responsibility to look at for one another. And the US with all that we have, I think that's really It defines us just as humans to be able to look out for one another and to do what we can. The fact that the U.S. has been able to do that, I've just seen such a positive effect in other countries and certainly with the people that that I see in my own district. And naturally, global health is US health. Global security is US security. And so we need to be able to stop outbreaks before they happen, because it's good for all of us.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
