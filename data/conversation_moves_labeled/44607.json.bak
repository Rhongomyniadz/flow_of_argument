        "confidence": 0.92
      },
      {
        "text": "Confining immigrants increases their vulnerability to both communicable and non-communicable diseases present in society.",
        "confidence": 0.91
      },
      {
        "text": "Immigration can influence public health outcomes.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
