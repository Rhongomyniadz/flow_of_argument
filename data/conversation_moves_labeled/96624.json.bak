      {
        "text": "The speaker believed they could not face the family of a fallen friend.",
        "confidence": 0.85
      }
    ],
    "assumptions": [
      {
        "text": "Moral responsibility extends beyond personal safety to include fairness toward others facing conscription.",
        "confidence": 0.93
      },
      {
