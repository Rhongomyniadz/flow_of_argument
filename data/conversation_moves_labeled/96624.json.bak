  {
    "episode_id": 96624,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/6/96624.jsonl",
    "turn_idx": 124,
    "turn_text": "No, because he thought it was based on a lie. He always said that the one vote he regretted the most was for the Tonkin Gulf",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "He thought the decision was based on a lie.",
        "confidence": 0.97
      },
      {
        "text": "The speaker regrets voting for the Tonkin Gulf resolution.",
        "confidence": 0.96
      },
      {
        "text": "The speaker believes his vote for the Tonkin Gulf resolution was wrong.",
        "confidence": 0.94
      }
    ],
    "assumptions": [
      {
        "text": "Lying about military incidents justifies political regret.",
        "confidence": 0.92
      },
      {
        "text": "Political decisions should be grounded in truthful intelligence.",
        "confidence": 0.91
      },
      {
        "text": "Regret over a past vote implies moral responsibility for its consequences.",
        "confidence": 0.89
      },
      {
        "text": "The Tonkin Gulf incident was misrepresented or fabricated.",
        "confidence": 0.87
      },
      {
        "text": "One vote can carry significant ethical weight in policy-making.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 96624,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/6/96624.jsonl",
    "turn_idx": 126,
    "turn_text": "They all found out soon after that it was a false narrative that was used as an excuse to provoke the war. And he came to believe it was not winnable without destroying the whole of Southeast Asia. But I was really proud of him. I was a college student during that time. But the reason I volunteered to go is that my upbringing was in two places, the big city of Washington, DC, where my father served there. and then a small town in Tennessee and that was my emotional spiritual home always still is now. And everybody knew who was on the draft board, everybody knew who was up in each month. I just couldn't feel right about using some of the strategies that were available in the big cities and if you had connections with your family. And I just felt like I couldn't imagine some guy, one of my friends in Carthage, Tennessee, going in my place, getting killed. What would I say to his family? It sounds corny, but that's really was it. And the fact that my father was going to be a candidate the following year as an opponent of the war brought it kind of in a sharp relief for me too.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The speaker was a college student at the time of the war.",
        "confidence": 0.95
      },
      {
        "text": "The speaker’s upbringing involved living in Washington, DC, and a small town in Tennessee.",
        "confidence": 0.94
      },
      {
        "text": "The small town in Tennessee was the speaker’s emotional and spiritual home.",
        "confidence": 0.93
      },
      {
        "text": "They all found out soon after that it was a false narrative used to provoke the war.",
        "confidence": 0.92
      },
      {
        "text": "The speaker’s father was running against the war as a political candidate the following year.",
        "confidence": 0.91
      },
      {
        "text": "He came to believe the war was not winnable without destroying much of Southeast Asia.",
        "confidence": 0.9
      },
      {
        "text": "In the speaker’s hometown, people knew who was on the draft board and who was drafted each month.",
        "confidence": 0.89
      },
      {
        "text": "The speaker could not morally accept using city-based advantages or family connections to avoid the draft.",
        "confidence": 0.87
      },
      {
        "text": "The speaker could not bear the thought of a friend from Carthage, Tennessee, dying in their place.",
        "confidence": 0.86
