  {
    "episode_id": 49762,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49762.jsonl",
    "turn_idx": 7,
    "turn_text": "I would call attention to an article that is called, my attention by my wife, as a matter of fact, and in our whole tribute, we talk about the World Wide Web. This demonstrates that nowhere, nowhere in the world today is there the kind of decision as a kind of decision made that is recommended by those who really want to create a two-tier system.",
    "speaker_id": "SPEAKER_02",
