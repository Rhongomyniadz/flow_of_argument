  {
    "episode_id": 49762,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49762.jsonl",
    "turn_idx": 8,
    "turn_text": "Okay Senator, with all due respect, I have to stop you there. Net neutrality is not about a two-tiered system. Net neutrality is the opposite of a two-tiered system. What people that are against net neutrality for is exactly a two-tiered system. Let me explain net neutrality a little bit, at least how the people that are supporting net neutrality would like you to understand it. Net neutrality is about this very simple premise. that when my ones and zeros make it onto the information superhighway, they are treated with the same respect as anybody else's ones and zeros. And when I request ones and zeros from some other site, that those ones and zeros that are sent to me are treated with the same respect as any other ones and zeros that are on the internet. There is no two tiered system we're asking for. We're asking for a one tiered system in the backbone of the internet.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Net neutrality is not about a two-tiered system.",
        "confidence": 0.97
      },
      {
        "text": "Net neutrality is the opposite of a two-tiered system.",
        "confidence": 0.96
      },
      {
        "text": "Net neutrality is based on the principle that data packets (ones and zeros) should be treated equally on the internet.",
        "confidence": 0.95
      },
      {
        "text": "People who are against net neutrality support a two-tiered system.",
        "confidence": 0.94
      },
      {
        "text": "When users send data onto the internet, it should be treated with equal respect compared to others' data.",
        "confidence": 0.93
      },
      {
        "text": "When users receive data from websites, it should be delivered with equal respect compared to other data on the internet.",
        "confidence": 0.92
      },
      {
        "text": "Supporters of net neutrality advocate for a single-tiered system in the internet backbone.",
        "confidence": 0.91
      },
      {
        "text": "The current internet backbone does not currently operate under a two-tiered system.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "The internet backbone should function as a neutral conduit without preferential treatment.",
        "confidence": 0.95
      },
      {
        "text": "A fair internet requires equal treatment of data regardless of source or destination.",
