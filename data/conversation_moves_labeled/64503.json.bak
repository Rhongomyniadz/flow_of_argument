  {
    "episode_id": 64503,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/4/64503.jsonl",
    "turn_idx": 8,
    "turn_text": "Well, really, it will be one that involves advising Majority Leader Mitch McConnell on ways that we can unite the party, on ways that we can unite Republican senators behind an agenda, so that we're not just talking about what we're against in government. In recent years, with the president, with whom we often disagree, we've gotten stuck understandably in a mode of frequently talking about what we're against, but we also have to be for something. It's time for us to actually govern now that we have a majority. And so we'll be helping to advise the majority leader on ways that we can unite the Republican senators around a policy agenda that will help us move forward and expand our nation's middle class.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The speaker will advise Majority Leader Mitch McConnell on strategies to unify Republican senators.",
