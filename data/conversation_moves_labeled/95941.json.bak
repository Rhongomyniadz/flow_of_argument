  {
    "episode_id": 95941,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95941.jsonl",
    "turn_idx": 6,
    "turn_text": "Let's start by talking a little bit about your road to becoming congressman. I know you've worked in politics or in the political scene for quite a while. Kind of tell us a little bit about your background, how you got to be where you are today.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The speaker wants to begin discussing the addressee's path to becoming a congressman.",
        "confidence": 0.97
      },
      {
        "text": "The speaker requests the addressee to describe their personal background and journey to their current position.",
        "confidence": 0.96
      },
      {
        "text": "The addressee has been involved in politics or the political scene for a significant amount of time.",
        "confidence": 0.94
      }
    ],
    "assumptions": [
      {
        "text": "The addressee has achieved the role of congressman through a discernible career trajectory.",
        "confidence": 0.92
      },
      {
        "text": "The addressee possesses relevant personal history worth sharing on public record.",
        "confidence": 0.89
      },
      {
        "text": "Public discussion of political careers contributes to meaningful discourse.",
        "confidence": 0.87
      },
      {
        "text": "The addressee views themselves as having a legitimate and noteworthy political journey.",
        "confidence": 0.85
      },
      {
        "text": "The audience values insight into political figures' formative experiences.",
        "confidence": 0.83
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Answer"
  },
  {
    "episode_id": 95941,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95941.jsonl",
    "turn_idx": 7,
    "turn_text": "Well, you know, it's interesting. I'll tell you, I never had intentions of being involved in politics. It was, I'll make the story as quick as I can, but two important components. One, I actually was a mountaineering instructor. I taught out to a wilderness trips. It's where my wife and I met. And my parents were giving me a hard time about doing something quote, more serious with my life. And so really, and I think it was more of an active rebellion than anything else. I applied for internships in the, in the Congress, and I got an internship with one of our senators, and I remember I came straight off of a trip, I had long hair and a beard and cut it all, went and started doing this internship, supposed to be there one month, they asked me to stay on, longer stay on staff, got offered a job, and it was just this huge disruption of my world, and that was kind of an introduction. I didn't think I'd like it, and I loved it. I left doing staff work, and I had a number of people urging me to run for this open seat in the Congress, and I remember telling one of my friends, I said, if I ever run for political offices, once you take a baseball bat and knock me up inside my head, and thankfully he didn't do it. But in any case, I told all the people over several months that I wasn't running. I wasn't interested in running. And finally, one night, my wife after hearing some folks urging me to do it, she rolled over the next morning in bed and said, you know what? You need to run. And I was so shocked because she hates politics and hates the divisiveness. And she just said, you know what? She said, you You know the state really well, you know the issues, you know how to get things done and I think you want to do it and I'll tell you that was the first time ever that I actually thought about running and kind of all downhill from there with the exception of getting into this amazing runoff with our former governor, our legendary former governor and we ended up winning and it's been a really neat experience though.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
