  {
    "episode_id": 48043,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/8/48043.jsonl",
    "turn_idx": 178,
    "turn_text": "Well, you vote for me because I want to pick up where I started and I want to finish what I started. You vote for me, you got a person who's going to go back to Washington and he's going to have four years of seniority. That's an advantage. It's an advantage because most things are decided based on seniority in Washington. So when I return to Washington, I'm going to be able to start with those four years of service and is going to determine what committee I'm assigned to, which is important to Louisiana, is going to determine how seat assignments are made, office assignments, and at the end of the day I just think that's an advantage. And then lastly, I've been there. I've done that. And I want to go back and finish doing what I started to do. I want to raise the minimum wage. I think people work too hard. Don't get paid for the work they do. I want to invest in early childhood education, which is so important. Our kids, we're losing them when they get to the third grade because we didn't give them preparation. So I want to clean the environment. I mean, the environment in Louisiana is terrible. I'm the guy who introduced air monitoring for our state. I want to deal with the gun problem, and I believe with this, finish with this. Got too many guns on our streets. I'm the guy who stood up to the president. Actually, in 1984, who stood up to the president of the United States of America and said, no, this crime bill is bad. I was probably the only African-American member of the Congress who stood up because I believe that we shouldn't be in the business of building prisons and making guns more available. I just believe that, you know, if you like me, you have a chance to get somebody there with the experience needed to finish the job.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I have previous experience serving in Washington.",
        "confidence": 0.96
      },
      {
        "text": "I want to pick up where I started and finish what I started.",
        "confidence": 0.95
      },
      {
        "text": "I want to raise the minimum wage.",
        "confidence": 0.94
      },
      {
        "text": "People work hard but are underpaid.",
        "confidence": 0.93
