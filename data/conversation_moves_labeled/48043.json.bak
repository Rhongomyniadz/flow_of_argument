  {
    "episode_id": 48043,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/8/48043.jsonl",
    "turn_idx": 75,
    "turn_text": "The proliferation of charters in this state is troublesome to me. I'm an advocate for public schools, I'm a product of public schools, magnet school, but public school, nonetheless. All of this charter movement over the last 20, 25 years, I don't see, and I stand to be corrected, I don't see any empirical data. that says that charters do a better job of educating our children than regular neighborhood schools do. And if that's the case, then why is there such advocacy for charters as opposed to steps to improve neighborhood schools. And it comes primarily from Republican conservatives. And there are some Democrats who fall into that line. But it's mainly conservative Republicans who are moving in that direction. But there is no data that supports charter schools as doing a better job of educating our children.",
    "speaker_id": "SPEAKER_04",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
