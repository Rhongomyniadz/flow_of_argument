      },
      {
        "text": "Continued arms shipments to a party may imply de facto warfare.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "The speaker trusts the legal framework around declaring war as meaningful and binding.",
        "confidence": 0.93
      },
      {
        "text": "De facto war conditions are morally and politically significant regardless of formal declarations.",
        "confidence": 0.91
      },
      {
        "text": "The audience values adherence to constitutional procedures and institutional legitimacy.",
        "confidence": 0.89
      },
      {
        "text": "Actions speak louder than labels when determining whether a nation is at war.",
        "confidence": 0.87
      },
      {
        "text": "Political leaders have a responsibility to recognize and respond to de facto wars through oversight mechanisms.",
        "confidence": 0.86
