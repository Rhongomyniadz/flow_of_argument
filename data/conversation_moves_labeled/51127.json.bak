  },
  {
    "episode_id": 51127,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/1/51127.jsonl",
    "turn_idx": 31,
    "turn_text": "No, I mean, I think I think that the role that that we all need to look at is whether he believes in the rule of law, whether he's going to be independent and impartial. And so as we move forward, I will tell you that that will make a decision after we see the hearing, but you know, those to me, those decisions wouldn't disqualify him from the court.",
    "speaker_id": "SPEAKER_01",
