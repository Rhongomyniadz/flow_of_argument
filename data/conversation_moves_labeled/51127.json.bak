  {
    "episode_id": 51127,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/1/51127.jsonl",
    "turn_idx": 4,
    "turn_text": "My goal when I came to Washington was to represent North Dakota. And one of the things that I heard over and over again as I was auditioning for this job or interviewing for this job, something we call a campaign, was that Dodd-Frank was really, the regulations coming out of Dodd-Frank was really crushing our small institutions. That was virtually what was supposed to prevent too big to fail now was too small to succeed. And so after receiving the assignment on the banking committee, I knew that getting regulatory relief for our small institutions, lending institutions, and keeping relationship banking alive in this country was going to be my top priority on the banking committee.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
