  {
    "episode_id": 51127,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/1/51127.jsonl",
    "turn_idx": 26,
    "turn_text": "I want to move to the Consumer Financial Protection Bureau, the CFPB. The agency has kind of always been criticized by Republicans who are not happy with the single-director structure. And now you've seen Mick Mulvaney's leadership as the acting director, and as well you've got the nomination of Kathy Crenninger. Do you think maybe in hindsight it may have been better to sort of set the agency up as a five-member commission?",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I want to move to the Consumer Financial Protection Bureau.",
        "confidence": 0.97
      },
      {
        "text": "Mick Mulvaney served as the acting director of the CFPB.",
        "confidence": 0.96
      },
      {
        "text": "The CFPB has been criticized by Republicans due to its single-director structure.",
        "confidence": 0.94
      },
