    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The Senate currently requires 60 members to invoke cloture and end debate.",
        "confidence": 0.97
      },
      {
        "text": "Cloture allows a bill to move forward to a final vote in the Senate.",
        "confidence": 0.95
      },
      {
        "text": "In the two years prior to the last election, Democrats held a simple majority in the Senate.",
        "confidence": 0.92
      },
      {
        "text": "A simple majority in the Senate does not guarantee passage of legislation due to filibuster rules.",
        "confidence": 0.9
      },
      {
        "text": "At least 41 senators can block a vote by refusing to support cloture.",
        "confidence": 0.89
      },
      {
        "text": "Many people do not understand the procedural barriers in the Senate.",
        "confidence": 0.88
      },
      {
        "text": "The current Senate rules prevent legislative progress despite having majorities in both chambers.",
        "confidence": 0.87
      },
      {
        "text": "Having a simple majority alone is insufficient to pass bills under current Senate procedures.",
        "confidence": 0.86
      }
    ],
    "assumptions": [
