  {
    "episode_id": 77036,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/7/77036.jsonl",
    "turn_idx": 9,
    "turn_text": "And a lot of it has to do with the fact that Americans have lost confidence in many of their institutions, including their governmental institutions. We have spent a lot of time being affected by this decline in confidence. Now the time has arrived to start asking the question, what can we do about it? And I believe that one of the fundamental things that we can do about it is to give Americans the skills and the motivation to actually get involved in solving their local community problems. My belief is that a person who has been an activist in the arena actually striving to make a difference is not likely to be one who looks down on government and wants to essentially bail out of their citizenship responsibility.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "Americans have lost confidence in many of their institutions, including governmental ones.",
        "confidence": 0.95
      },
      {
        "text": "The speaker and others have been significantly affected by the decline in institutional confidence.",
        "confidence": 0.92
      },
      {
        "text": "It is now appropriate to ask what can be done about the decline in institutional confidence.",
        "confidence": 0.9
      },
      {
        "text": "One key solution to restoring confidence is equipping Americans with the skills and motivation to engage locally.",
        "confidence": 0.88
      },
      {
        "text": "Individuals who actively participate in solving local problems are less likely to disdain government or abandon civic duties.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "Civic engagement strengthens trust in governmental institutions.",
        "confidence": 0.94
      },
      {
        "text": "People who experience firsthand success in activism develop more positive views toward governance.",
        "confidence": 0.91
      },
      {
        "text": "Institutional distrust stems largely from disengagement rather than inherent flaws in institutions.",
        "confidence": 0.89
      },
      {
        "text": "Skill-building and intrinsic motivation are sufficient catalysts for sustained civic involvement.",
        "confidence": 0.86
      },
      {
        "text": "There is a shared value among Americans that active citizenship is desirable.",
        "confidence": 0.85
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
