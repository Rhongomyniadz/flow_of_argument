  {
    "episode_id": 44476,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/4/44476.jsonl",
    "turn_idx": 4,
    "turn_text": "Oh, man. In-person Fiesta, you've got me. Anyway, I wanted to ask you about something that is happening tomorrow in the house and that is likely to to dominate the news this week. And that is that the house is going to debate and vote upon a proposal to establish an independent commission to investigate the violent events in the capital of January 6th. The politics around this have gotten really, really ugly. Can you talk a little bit about that and really what you think is on the line with this debate and this vote tomorrow?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
