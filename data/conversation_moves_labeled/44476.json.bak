    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The speaker has previously argued that the U.S.'s political culture undermines its national defense capabilities.",
        "confidence": 0.96
      },
      {
        "text": "Russia, China, and cyber threats represent serious dangers to American national security.",
        "confidence": 0.95
      },
      {
        "text": "The work focuses on the intersection between national security and technology.",
        "confidence": 0.94
      },
      {
        "text": "Congress is currently deeply divided along partisan lines.",
        "confidence": 0.93
      },
      {
        "text": "A significant portion of the current work being done by the speaker is situated within their professional background.",
