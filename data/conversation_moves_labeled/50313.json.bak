      },
      {
        "text": "Affirmative action did not exist in the 1960s.",
        "confidence": 0.93
      },
      {
        "text": "The speaker has a hard-nosed attitude toward immigration.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
