  {
    "episode_id": 82241,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/2/82241.jsonl",
    "turn_idx": 35,
    "turn_text": "Every year we are using more resources than the Earth can replenish in that year. We are acting as if we have 1.6 Earths.",
    "speaker_id": "SPEAKER_12",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
