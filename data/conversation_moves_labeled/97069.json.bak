        "confidence": 0.96
      },
      {
        "text": "Successful businesses lead to increased employment.",
        "confidence": 0.95
      },
      {
        "text": "Businesses need support from legislators and governmental officials to succeed.",
        "confidence": 0.94
      }
    ],
    "assumptions": [
