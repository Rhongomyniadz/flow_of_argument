  },
  {
    "episode_id": 97069,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/7/97069.jsonl",
    "turn_idx": 59,
    "turn_text": "Well, you know, we're working on a big agenda right now on a ton of things, including things like leveraging artificial intelligence to make our economy more competitive with the rest of the world, including places like China. We're talking about trying to do things on workforce. to train the workforce in the future because there are a lot of people that don't have the skills they need for the jobs that are here today and here tomorrow. Of course, we need to right-size the regulatory and tax system so that we don't overly burden businesses at the same time. So there's a whole lot of things that we need to work on in Ohio and around the country to make Ohio and the United States of America more competitive economically against the rest of the world and to allow American businesses to provide great paying jobs for Americans and provide for American families. So there's no shortage of opportunity right now and a lot of things going on in Ohio and around the country that give us a chance to make those things happen.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We are currently working on a large-scale agenda involving many initiatives.",
        "confidence": 0.97
      },
      {
        "text": "There is a significant gap between current workforce skills and job requirements.",
        "confidence": 0.96
      },
      {
        "text": "Ohio and the United States face strong international economic competition.",
        "confidence": 0.95
      },
      {
        "text": "Artificial intelligence is being leveraged to improve economic competitiveness globally.",
        "confidence": 0.94
      },
      {
        "text": "Workforce training programs are needed for future employment needs.",
        "confidence": 0.93
      },
      {
        "text": "There are ample opportunities available in Ohio and nationally to achieve economic progress.",
        "confidence": 0.93
      },
