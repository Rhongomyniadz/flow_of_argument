    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/7/97069.jsonl",
    "turn_idx": 58,
    "turn_text": "Okay, now you represent businesses. I do. So how do you work with legislators? and other governmental officials to try to make things better for the businesses so that the businesses can be successful, then they can put more people to work.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
