  {
    "episode_id": 79438,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/9/79438.jsonl",
    "turn_idx": 10,
    "turn_text": "I read what you learned early on that the key to any negotiation at any level is genuine trust. Now, it appears to a lot of citizens that trust has been replaced by loyalties, that if a senator doesn't go along and is loyal to the party, then that senator is a problem. Agree or disagree?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
