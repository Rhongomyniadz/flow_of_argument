  {
    "episode_id": 95663,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95663.jsonl",
    "turn_idx": 207,
    "turn_text": "So it wasn't long ago where the candidate and the campaign of the candidate was the difference maker. You know, the candidate that raised the money and used it to buy advertisements, build a campaign staff and the like, controlled it and had a big influence on the outcome of the election. Now, That's been outsourced. Candidates, in an often case, raise just a tiny percentage of what is actually spent in the race, because all these big outside influential entities are spending massive amounts of money to support these candidates. Candidates are less important now. They're commodities.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "In the past, the candidate and their campaign were the primary factor in determining election outcomes.",
        "confidence": 0.97
      },
      {
        "text": "Today, much of the funding in elections comes from outside groups rather than the candidates themselves.",
        "confidence": 0.96
      },
      {
        "text": "Candidates previously raised funds to finance advertisements and campaign staff.",
        "confidence": 0.95
      },
      {
        "text": "The candidate who raised more money had greater control over the election process.",
        "confidence": 0.94
      },
      {
        "text": "Outside entities spend significantly larger amounts of money compared to candidates in modern campaigns.",
        "confidence": 0.93
      },
      {
        "text": "Candidates today typically raise only a small fraction of the total money spent in their races.",
        "confidence": 0.92
      },
      {
        "text": "The role of the candidate has diminished in importance relative to previous eras.",
        "confidence": 0.91
      },
      {
        "text": "Candidates are increasingly viewed as interchangeable or fungible in contemporary politics.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "The effectiveness of a political campaign depends primarily on financial investment.",
        "confidence": 0.94
      },
      {
        "text": "Money spent by external actors shapes public perception and electoral outcomes more than candidate-driven efforts.",
        "confidence": 0.93
      },
      {
        "text": "A candidate’s personal agency in influencing election results is reduced when they lack independent funding capacity.",
        "confidence": 0.92
      },
      {
        "text": "The value of a candidate lies in their ability to mobilize resources and attract attention, which is now largely decoupled from them.",
        "confidence": 0.9
      },
      {
        "text": "Political success should be measured by influence over outcomes, which is now dominated by structural financial forces.",
        "confidence": 0.88
      },
      {
        "text": "Audiences perceive candidates as less authentic or central when their campaigns are driven by external interests.",
        "confidence": 0.87
      },
      {
        "text": "The term 'commodity' implies that candidates are treated as replaceable inputs in a system driven by capital.",
