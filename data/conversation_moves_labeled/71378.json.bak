  {
    "episode_id": 71378,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71378.jsonl",
    "turn_idx": 66,
    "turn_text": "Yeah, a small measure could be that we don't ask people who have been trained here and who want to stay here to leave the country because their visa expired. If somebody came here and wants to stay here and we train them and we've invested, we've spent the money there. on their education and their training? Well, they should be allowed to stay here. Folks who want to go back, whether it be to Poland or another country, to use their skills back home, certainly we want to encourage that too. And we're not going to say we're only going to train people who stay here. But for those who do want to stay, it's pretty ridiculous to think that we forced them to leave.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We do not require individuals who were trained locally and wish to remain in the country to leave after their visa expires.",
        "confidence": 0.95
      },
      {
        "text": "It would be unreasonable to force someone to leave the country after being trained and wishing to stay.",
        "confidence": 0.94
      },
      {
        "text": "We have invested financial resources in the education and training of individuals who wish to stay.",
        "confidence": 0.92
      },
      {
        "text": "Individuals who wish to return to their home countries, such as Poland, should be encouraged to do so.",
        "confidence": 0.9
      },
      {
        "text": "We do not restrict training solely to individuals who intend to stay permanently.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
      {
        "text": "Investing in someone’s education creates a moral obligation to allow them to stay if they wish.",
        "confidence": 0.93
      },
      {
        "text": "The value of human capital justifies retaining skilled individuals within the country.",
        "confidence": 0.91
      },
      {
        "text": "People who receive training should have agency over their own residency decisions.",
        "confidence": 0.9
      },
      {
        "text": "Forcing trained individuals to leave undermines national investment and efficiency.",
        "confidence": 0.89
