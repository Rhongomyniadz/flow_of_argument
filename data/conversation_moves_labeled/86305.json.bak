  {
    "episode_id": 86305,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86305.jsonl",
    "turn_idx": 52,
    "turn_text": "I mean, I tell you what, it is unbelievably frustrating. I think that Americans for too long have delegated to Washington DC much of the powers that we should take back. And I think they would be even more horrified than I am every day to find out what the political class in Washington has done with those powers that isn't to the betterment of Americans, but just to the betterment of themselves inside the Beltway. Every time I get on that plane every week, right here from Indiana back to Washington. I continue to be appalled by what I see. The only thing that I continue to be really optimistic about is the fact that every time I come home, I see hard-working Hoosiers getting up every day, bettering their families, bettering their communities, bettering their futures. And I know this country's future is bright because of that, in spite of Washington, D.C.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
