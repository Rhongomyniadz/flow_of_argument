      },
      {
        "text": "Facebook desires significant control over Americans' lives and access to information.",
        "confidence": 0.9
      },
      {
        "text": "Facebook does not wish to accept the full responsibilities associated with its power.",
        "confidence": 0.88
      },
      {
        "text": "The actual scale and influence of Facebook exceed those of a typical private company.",
        "confidence": 0.87
