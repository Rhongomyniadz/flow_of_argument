  {
    "episode_id": 86305,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86305.jsonl",
    "turn_idx": 25,
    "turn_text": "I think people are really concerned at the notion that maybe instead of a government that is censoring people, we've got a super large monopoly that is censoring information and censoring people. I'm a big believer that if you were going to have extraordinary power, then you should have extraordinary responsibility attendant to that power. And I think what we've seen with Facebook is a deep desire to have a tremendous amount of power over the lives of Americans, the information that flows into their hands, but they don't want to have all the responsibility that's attached to it. They want to advocate that responsibility and pretend like, oh, no, we're just a private company. We get to make any decision that we want, but the reach and scale and power that they have is not that of just a private company. And I think we should be looking more and more into Facebook themselves and some of the other tech companies that are controlling more and more of our lives.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
