  {
    "episode_id": 49960,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49960.jsonl",
    "turn_idx": 13,
    "turn_text": "Yeah, so going into the year, there was a lot of excitement about Sanders' second run for the White House. Justice Democrats had this plan where they kind of paired back how many candidates they were endorsing and really, really zeroed in on places where they thought they could be successful, often in bluer districts across the country. And at first, it seemed like things could have been going better. Sanders loses in the presidential primary. And one of the Justice Democrats' first candidates of the year in Texas, Jessica Sistneros, lost a challenge against the Democratic incumbent, although pretty narrowly. But then as the year goes on, things got better for them. And at this point, nearly all of the House candidates just as Democrats have backed this cycle have won their races, including Marie Newman, who beat an anti-abortion Democrat in a rematch in Illinois, and Jamal Bowman, who beat long-term incumbent Elliot Engle in New York.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "There was significant excitement about Bernie Sanders' second run for the White House at the beginning of the year.",
        "confidence": 0.95
