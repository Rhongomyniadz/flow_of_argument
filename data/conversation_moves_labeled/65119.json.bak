      {
        "text": "This demographic change has created an arithmetic challenge for Social Security funding.",
        "confidence": 0.89
      },
      {
        "text": "A serious policy crisis emerged by 2016 and has worsened since then.",
        "confidence": 0.87
      },
      {
        "text": "Addressing this issue requires strong leadership from the White House.",
        "confidence": 0.85
      },
      {
        "text": "Effective action also requires genuine concern from members of Congress.",
        "confidence": 0.84
      }
    ],
    "assumptions": [
