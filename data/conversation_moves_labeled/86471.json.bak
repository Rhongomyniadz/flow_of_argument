  {
    "episode_id": 86471,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86471.jsonl",
    "turn_idx": 15,
    "turn_text": "Do you see the divide that we're sensing from media and different parts of the country? Is it divide as big as it appears to be between Democrats, Republicans, between different groups across the country?",
