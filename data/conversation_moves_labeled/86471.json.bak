  {
    "episode_id": 86471,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86471.jsonl",
    "turn_idx": 16,
    "turn_text": "I think it is, and it's unfortunate because we just don't talk to each other. We talk at each other. And even though people are divided, they want to come together and they want to see things get done. So if this Congress isn't able to solve some of the problems that we're facing, getting the economy going more, dealing with the immigration issue, as I said, I think they're just as likely to throw this new bunch out as they were the old. I don't think there's any personal loyalty there. They just want to change and they want to see something happen.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "People do not communicate effectively with each other.",
        "confidence": 0.96
      },
      {
        "text": "Current political discourse consists of talking at rather than with each other.",
        "confidence": 0.94
      },
      {
        "text": "Despite political divisions, people desire unity and progress.",
        "confidence": 0.92
      },
      {
        "text": "Congress has failed to address major national issues like the economy and immigration.",
        "confidence": 0.9
      },
      {
        "text": "If the current Congress fails to solve pressing problems, voters will replace them.",
        "confidence": 0.89
      },
      {
        "text": "Voters lack personal loyalty to elected officials.",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
