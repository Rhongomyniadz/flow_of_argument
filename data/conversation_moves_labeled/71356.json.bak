      },
      {
        "text": "The speaker believes they possess the credibility and capability to lead inclusively.",
        "confidence": 0.91
      },
      {
        "text": "An inaugural speech has symbolic power to shape public perception of unity.",
        "confidence": 0.9
      },
      {
        "text": "The American people value representation beyond electoral outcomes.",
        "confidence": 0.89
      }
    ],
    "turn_type_label": "Substantive",
