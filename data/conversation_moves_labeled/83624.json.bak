  },
  {
    "episode_id": 83624,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83624.jsonl",
    "turn_idx": 65,
    "turn_text": "Yes. You've had colleagues ask about this and we would be interested to see if you have any whistleblower evidence of confidential human informants for the FBI in the crowd or in the Capitol on the date of January 6th.",
