  {
    "episode_id": 86127,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/6/86127.jsonl",
    "turn_idx": 43,
    "turn_text": "My family came to Madison, Senator, 50 years ago. I was six years old, second grader, and we came from Chicago. She was getting out of an abusive marriage to my father. I was six. You met my sister Lalita a few weeks ago, and you met some of the state street artists. She was four. Who was the land of great opportunity? In the early 1970s, Milwaukee, with Ailes Smith and all the other companies, was called, I believe by Time Magazine, is one of the best places for black people to live. What do you say when you're at meetings in Washington and people begin to talk about the fact that by many, and I don't mean just magazines, but by many of us who are African-Americans are reading statistics and reading that was one of the worst places for black people to live in comparison to their white counterparts. How do you frame that for people? How do you respond when people say, you're a senator from Wisconsin, aren't you having all of those race to equity reports and racial justice issues and mass incarceration and justified anger? What do you say when people ask you about that aspect of Wisconsin?",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
