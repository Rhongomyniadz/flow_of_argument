    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "We should begin by discussing bio-technology.",
        "confidence": 0.97
      },
      {
        "text": "The topic of bio-technology is currently under consideration.",
        "confidence": 0.95
      }
    ],
    "assumptions": [
      {
        "text": "Starting with defining key terms is an appropriate way to initiate a discussion.",
        "confidence": 0.94
      },
      {
        "text": "The interlocutor understands the term 'bio-technology' at a basic level.",
        "confidence": 0.92
      },
      {
        "text": "There is value in clarifying ambiguous or undefined concepts before proceeding further.",
        "confidence": 0.9
      },
      {
        "text": "The participants share a common goal of understanding bio-technology.",
