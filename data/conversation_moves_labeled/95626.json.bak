  },
  {
    "episode_id": 95626,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/5/95626.jsonl",
    "turn_idx": 5,
    "turn_text": "It's all about the science of understanding life and how it functions in humans. in animals, in plants, in microbes, and understanding increasingly profound levels at the cellular level, at the genetic level, at the molecular level, and then taking that knowledge and applying it to solve problems. mostly solving problems of disease, how can we create new treatments and prevention secures for diseases, but also how can we make farmers more productive to feed a growing world population, and how do we make more sustainable, materials and fuels. So we like to say that what we do with biotechnology is that we heal, and we feed, and we fuel the world. So that's what the science is. And what the biotechnology innovation organization, not only it is, is a trade association for about a thousand of those companies that we help with both public policy advocacy and also with conferences and conventions to bring them together to collaborate.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
