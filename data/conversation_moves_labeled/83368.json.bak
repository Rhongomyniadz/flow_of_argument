    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "If I had listened to polls, I would not have run for my first office.",
        "confidence": 0.97
      },
      {
        "text": "If I had listened to polls, I would not have run for my second office.",
        "confidence": 0.96
      },
      {
        "text": "If I had listened to polls, I would not have run for my third office.",
        "confidence": 0.95
      },
      {
        "text": "We place excessive importance on polls.",
        "confidence": 0.94
      }
    ],
    "assumptions": [
