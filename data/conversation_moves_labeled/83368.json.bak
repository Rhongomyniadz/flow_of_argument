  {
    "episode_id": 83368,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83368.jsonl",
    "turn_idx": 115,
    "turn_text": "Well, like I've said many times, because it is a mantra for me during election time. There are two ways to run, either without an opponent or scared. You got to earn it and you got to get out there and you got to do the work and I'm prepared to do it.",
    "speaker_id": "SPEAKER_06",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I have said this multiple times before.",
        "confidence": 0.95
      },
      {
        "text": "I am personally ready and willing to undertake the required work.",
        "confidence": 0.94
      },
      {
        "text": "This idea functions as a personal mantra for me during election periods.",
        "confidence": 0.92
      },
      {
        "text": "One must earn their position through effort.",
        "confidence": 0.91
      },
      {
        "text": "One must actively engage by going out and doing the necessary work.",
        "confidence": 0.9
      },
      {
        "text": "There are only two ways to run for office: without an opponent or out of fear.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "Election campaigns require genuine commitment and active participation rather than passive waiting.",
        "confidence": 0.93
      },
      {
        "text": "The value of hard work is central to legitimate political ambition and public service.",
        "confidence": 0.9
      },
      {
        "text": "Public office should be pursued through earned legitimacy, not convenience or avoidance.",
        "confidence": 0.89
      },
      {
        "text": "Personal consistency in messaging strengthens credibility in political discourse.",
        "confidence": 0.88
      },
      {
        "text": "Fear-based motivations are inherently unproductive or illegitimate in political campaigning.",
        "confidence": 0.87
      },
      {
        "text": "Audience members recognize and respect perseverance and authenticity in candidates.",
        "confidence": 0.86
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Assert / Elaborate"
  },
  {
    "episode_id": 83368,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83368.jsonl",
    "turn_idx": 116,
