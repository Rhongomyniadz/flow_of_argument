  },
  {
    "episode_id": 71132,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71132.jsonl",
    "turn_idx": 11,
    "turn_text": "All right, got it. So you've served in you've represented Milwaukee for quite a few terms now. You are on the Ways and Means Committee. You've you've championed a lot of issues for the black community, a lot of resolutions those issues. How much longer are you planning to continue to represent Milwaukee? And who do you think might be next? Or are you even thinking of that right now?",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
