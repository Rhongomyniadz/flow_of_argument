  {
    "episode_id": 71132,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/1/71132.jsonl",
    "turn_idx": 4,
    "turn_text": "Yes, that is why we have you on the show today. It is Black History Month and I thought it would be pretty important to have Wisconsin's only black congressional member on the show. So I just want to kick it off here. What's the most pertinent need of Black Wisconsinites right now and how do we accomplish that?",
