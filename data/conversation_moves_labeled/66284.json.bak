  {
    "episode_id": 66284,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/6/66284.jsonl",
    "turn_idx": 5,
    "turn_text": "One of the concerns, of course, that was spoken about yesterday by the governor is regarding the evictions moratorium that the governor will be lifting in just a few weeks here. And there is that concern of a potential wave of people that will be losing their ability to pay rent and being forced to evict the state announced a program that will help in that transition. Wanted to get your thoughts on what this is. If this is a concern, it's something that you folks are working on on a national level.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The governor spoke about the eviction moratorium yesterday.",
        "confidence": 0.95
      },
      {
        "text": "The eviction moratorium will be lifted in a few weeks.",
        "confidence": 0.92
      },
      {
        "text": "There is a concern about a potential wave of people unable to pay rent after the moratorium ends.",
        "confidence": 0.9
      },
