    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The appropriations committee is responsible for allocating federal funding.",
        "confidence": 0.98
      },
      {
        "text": "I am a member of the appropriations committee in Congress.",
        "confidence": 0.97
      },
      {
        "text": "The appropriations committee is the oldest committee in Congress.",
        "confidence": 0.96
      },
      {
        "text": "The appropriations committee has existed since the early years of Congress.",
        "confidence": 0.95
      },
      {
        "text": "The appropriations committee operates on a yearly basis.",
        "confidence": 0.92
      }
    ],
    "assumptions": [
      {
        "text": "Being on the appropriations committee grants significant influence over government spending decisions.",
        "confidence": 0.94
      },
      {
        "text": "Federal funding allocation is a critical function within the legislative process.",
        "confidence": 0.93
      },
      {
        "text": "The age and historical continuity of a congressional committee imply legitimacy and institutional importance.",
        "confidence": 0.9
      },
      {
        "text": "Audience members recognize or should recognize the significance of being part of a long-standing congressional committee.",
        "confidence": 0.89
      },
      {
        "text": "The speaker’s position on the committee reflects expertise or credibility in fiscal matters.",
