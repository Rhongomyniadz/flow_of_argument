  {
    "episode_id": 66284,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/6/66284.jsonl",
    "turn_idx": 29,
    "turn_text": "Yeah, same, he's not a candidate, but really focused on what he's doing right now. And also agreeing with the current governor, of course, Governor David Eager's benchmark of that 70% saying that the state has done a good job of setting that benchmark and making sure that we are heading towards that direction rather than moving the goalpost of where we need to be saying that he believes that getting everyone vaccinated to that degree is important. and not lifting those mask mandates that he said, well, he's seeing throughout the country. And of course, we know that many states are now actually going to be re-implementing some of those things that they have, some of those restrictions that they have loosened up. So he agrees also with Governor Ige and where we're at with that 70% benchmark.",
    "speaker_id": "SPEAKER_01",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
