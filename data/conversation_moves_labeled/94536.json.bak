    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94536.jsonl",
    "turn_idx": 66,
    "turn_text": "You and a lot of other people on both sides of the aisle have faced protests from people. I'm just curious, just as a senator who represents the American people, what is the psychological role that protest plays, you think?",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
