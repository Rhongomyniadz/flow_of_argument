    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94536.jsonl",
    "turn_idx": 58,
    "turn_text": "We Democrats are guided by our values. We're not just going to oppose for the sake of opposing, but they've got to meet us on our values and they haven't and they've moved hard right. So, you know, if they were to say tomorrow, we'll get rid of the carried interest loophole, which Trump campaigned to get rid of. Of course, we're not going to oppose it because Trump's name is on it, but we're not going to just compromise for its own sake. And when they come up with a Affordable Care Act or a Cabinet nomination or an infrastructure bill that doesn't meet our values, we'll oppose them tooth and nail.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
