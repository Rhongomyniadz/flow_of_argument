  {
    "episode_id": 94536,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94536.jsonl",
    "turn_idx": 60,
    "turn_text": "No, I don't mind the up. I mean, this a very important job. I realized something a few days after the election that if Hillary had been president and I'd been majority leader, I would have had more fun. It would have been an easier job. And most importantly, would have gotten some good things done, which is why we're here. But with Trump as president and me as minority leader, the job is much more important. So I am ready for the fight. I'm invigorated in a sense by the need to block what they're doing. And that's what motivates me. I realize some people are going to throw brick bats, but that goes with the territory.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I do not mind the challenges of my current role.",
        "confidence": 0.95
      },
      {
        "text": "Blocking policies enacted by the current administration is part of my core motivation.",
        "confidence": 0.93
      },
      {
        "text": "The position I currently hold is very important.",
        "confidence": 0.92
      },
      {
        "text": "I feel motivated and energized by the need to oppose actions taken by the current administration.",
        "confidence": 0.91
      },
      {
        "text": "With Donald Trump as president and me as minority leader, my role has become even more significant.",
        "confidence": 0.9
      },
      {
        "text": "Some people will criticize me, but criticism is expected in political leadership.",
        "confidence": 0.89
      },
      {
        "text": "If Hillary Clinton had been president and I had been majority leader, the experience would have been more enjoyable.",
        "confidence": 0.88
      },
      {
        "text": "A Hillary Clinton presidency with me as majority leader would have made the job easier.",
        "confidence": 0.87
      },
      {
        "text": "Under a Hillary Clinton presidency, meaningful accomplishments would have been possible.",
        "confidence": 0.86
      },
      {
        "text": "My presence here today is tied to the importance of achieving substantive outcomes.",
        "confidence": 0.85
      }
    ],
    "assumptions": [
