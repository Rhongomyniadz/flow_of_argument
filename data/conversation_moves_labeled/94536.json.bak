  },
  {
    "episode_id": 94536,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94536.jsonl",
    "turn_idx": 67,
    "turn_text": "Look, I cut my eye teeth in the Vietnam War, posing the Vietnam War. It was a grassroots movement that eventually toppled the most powerful man in the world, Lyndon Johnson. I think the protests are terrific. I'm all for them. The energy, the new energy that the Democratic Party and Progressive America has found is great. Are there occasional brick breads thrown? Sure. Are people sometimes impatient? Sure. But that's just fine. I take that as part of it and I'd certainly prefer having a strong out there protest movement than having quiescence, apathy, or nothing.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I personally experienced the Vietnam War firsthand.",
        "confidence": 0.97
      },
      {
        "text": "Protests against the Vietnam War were effective in influencing political change.",
        "confidence": 0.96
      },
      {
        "text": "A vibrant protest movement is preferable to public apathy or silence.",
        "confidence": 0.95
      },
      {
        "text": "The Vietnam War led to the resignation of President Lyndon Johnson.",
        "confidence": 0.94
      },
      {
        "text": "The presence of protest-related disruptions is acceptable.",
        "confidence": 0.93
      },
      {
        "text": "The Vietnam War was a grassroots movement.",
        "confidence": 0.92
      },
      {
        "text": "Current progressive movements generate energetic political engagement.",
        "confidence": 0.91
      },
      {
        "text": "Occasional acts of violence during protests occur.",
        "confidence": 0.9
      },
      {
        "text": "Some protesters may exhibit impatience.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "Historical protest movements can achieve significant political outcomes.",
