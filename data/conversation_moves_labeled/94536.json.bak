  },
  {
    "episode_id": 94536,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/4/94536.jsonl",
    "turn_idx": 68,
    "turn_text": "You said earlier that you thought the Democrats did not have an economic message. Is that your analysis of why they lost and why Trump won?",
