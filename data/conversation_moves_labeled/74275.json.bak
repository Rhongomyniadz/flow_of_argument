  {
    "episode_id": 74275,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/4/74275.jsonl",
    "turn_idx": 9,
    "turn_text": "Thank you. Well, let's turn our attention now to matters pertaining to health security. Let's talk about here at home the National Vaccination Campaign. And I'd like to talk to you also about how things are going in Oklahoma. There's been remarkable progress across the country in the last 120 days. And we also were hitting a plateau of sorts. And we're beginning to come to terms. We got over half of our adult population fully vaccinated right now. There's been some dramatic shift of opinion in favor of getting the vaccine as quickly as possible. But we're also struggling with hesitation, people having continuing to have questions about this, some who are refusing to consider the vaccine. And tell us your thoughts on the progress that we've achieved. How do we explain that? And looking forward, how do we carry the progress forward? What do you think we're going to look like as we head into the fall?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The National Vaccination Campaign is currently underway.",
        "confidence": 0.97
      },
      {
        "text": "There has been remarkable progress in the past 120 days regarding vaccination efforts nationwide.",
        "confidence": 0.96
      },
      {
        "text": "More than half of the adult population in the country is now fully vaccinated.",
        "confidence": 0.95
      },
      {
        "text": "A plateau in vaccination rates was observed recently.",
        "confidence": 0.94
      },
      {
        "text": "There has been a significant shift in public opinion toward supporting rapid vaccination.",
        "confidence": 0.93
      },
      {
        "text": "Some individuals continue to express hesitancy or refuse to get vaccinated.",
        "confidence": 0.92
      },
      {
        "text": "The speaker wants listeners to share their thoughts on recent progress and future strategies.",
        "confidence": 0.9
      }
    ],
    "assumptions": [
      {
        "text": "Public health outcomes depend on widespread vaccination.",
        "confidence": 0.94
      },
      {
