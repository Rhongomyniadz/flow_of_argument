  {
    "episode_id": 66394,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/6/6/66394.jsonl",
    "turn_idx": 14,
    "turn_text": "My primary prescription is we have to fundamentally change the way we think about health care in this country. We can't afford health care right now and what are the Democrats doing proposing more of it, more government-run health care. The Republicans are afraid to talk about this issue. They're afraid to say what we need to say, which is government should always be there for those people in need But all of the rest of us Americans need to begin to assume more of the day-to-day cost of our own healthcare. Until we get there, we're always going to have a debt problem in this country.",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
