    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "I love you for calling out the Republican Party.",
        "confidence": 0.95
      },
      {
        "text": "There is a lot of posturing in current politics.",
        "confidence": 0.92
      },
      {
        "text": "Much of what happens in Washington resembles a one-party system.",
        "confidence": 0.9
      },
