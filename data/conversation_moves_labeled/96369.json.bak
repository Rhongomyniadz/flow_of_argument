  {
    "episode_id": 96369,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/9/6/96369.jsonl",
    "turn_idx": 46,
    "turn_text": "to estimates and maybe you disagree with the estimates. the Congressional Budget Office, I think, said it was one and a half trillion dollars at the deficit over the next 10 years. So you come from a state like South Dakota where we balance the state budget every year and you go to Washington, you end up voting for something that's going to add a lot to the deficit. How do you reconcile that?",
    "speaker_id": "SPEAKER_00",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
