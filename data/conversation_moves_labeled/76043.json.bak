  {
    "episode_id": 76043,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/7/6/76043.jsonl",
    "turn_idx": 17,
    "turn_text": "So we're gonna, Alex, we're not gonna, Delta is not the last of the variants we're gonna see. This disease evolves. We need to evolve the manner in which we deal with it. Frankly, when this thing first heard our shores, I think Governor Newsom did the right thing and saying, everybody shut down, we need to know what we're dealing with. Where I fault him is that 30 days later, the private schools and healthcare, it started to make significant inroads and how to deal with it and he never evolved his approach to it. That's where I fault him. He was still stuck doing stuff that we started with when the science and sociological patterns had changed. So my view here is that Deltas with us, we have to deal with it. Parents and people need to have the freedom and options for where they take their kids to school, how they buy groceries, where do they go to work, things like that. That's the responsibility of a responsible governor.",
    "speaker_id": "SPEAKER_02",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
