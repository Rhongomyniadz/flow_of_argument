  {
    "episode_id": 51012,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/1/51012.jsonl",
    "turn_idx": 1,
    "turn_text": "This brings me back to my days of being a counsel on the Capitol Hill, where I served as a lawyer to a congressional committee and keeping a schedule for a member of Congress is a hopeless cause. No matter what you do, the bells calling them to the floor have a mind of their own. and it disrupts meetings throughout the day and particularly when they're getting close to congressional recess time and they're trying to jam in all kinds of things on the floor. They have zero control of their schedule. So I guess we just have to bear with this a minute and hope that she returns from the floor quickly.",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
