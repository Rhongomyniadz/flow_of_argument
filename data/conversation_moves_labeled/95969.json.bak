        "confidence": 0.98
      },
      {
        "text": "Republicans hold a majority in the House of Representatives.",
        "confidence": 0.98
      },
      {
        "text": "Using the debt ceiling as a bargaining chip puts the entire U.S. economy at risk.",
        "confidence": 0.97
      },
      {
        "text": "The debt ceiling should not be used as a tool for wholesale political agenda setting.",
        "confidence": 0.96
      },
      {
        "text": "Historically, the debt ceiling has not been used as a vehicle for negotiations.",
        "confidence": 0.94
      },
      {
        "text": "Kevin McCarthy's proposed policy involves real stakes and is not merely a negotiating tactic without consequence.",
        "confidence": 0.92
      },
      {
        "text": "There are insufficient Republican votes in the House to pass McCarthy’s own proposal.",
        "confidence": 0.91
      }
    ],
    "assumptions": [
      {
        "text": "The stability of the U.S. economy is a paramount value worth protecting from political brinkmanship.",
        "confidence": 0.95
      },
      {
        "text": "Political compromise should not involve high-stakes economic threats like defaulting on national debt.",
        "confidence": 0.94
