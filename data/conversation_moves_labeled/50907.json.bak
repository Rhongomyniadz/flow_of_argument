      },
      {
        "text": "The experience of receiving unexpectedly high medical bills feels like extortion to the speaker.",
        "confidence": 0.9
      },
      {
        "text": "The proposed rule would allow patients to compare prices across providers and choose more affordable options.",
        "confidence": 0.89
      },
      {
        "text": "An executive order was issued to create a federal rule requiring public disclosure of healthcare pricing.",
        "confidence": 0.88
      }
    ],
    "assumptions": [
