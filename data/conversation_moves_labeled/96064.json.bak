        "confidence": 0.88
      },
      {
        "text": "The previous administration sent a message of exclusion: 'We will not turn your way.'",
        "confidence": 0.87
      }
    ],
    "assumptions": [
      {
        "text": "A welcoming message influences migration behavior.",
        "confidence": 0.94
      },
      {
        "text": "Public sentiment toward immigration policy affects actual migration patterns.",
        "confidence": 0.91
      },
      {
        "text": "Messages from political leadership are perceived by migrants and shape their decisions.",
        "confidence": 0.89
      },
      {
        "text": "The perception of being unwelcome is a significant deterrent to crossing borders.",
        "confidence": 0.86
      },
      {
        "text": "Symbolic actions like wearing 'you're welcome' shirts convey official policy direction.",
        "confidence": 0.85
      },
      {
        "text": "The current crisis at the border is partly attributable to past discouragement of entry.",
