  {
    "episode_id": 49972,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49972.jsonl",
    "turn_idx": 163,
    "turn_text": "As a pollster, I'll tell you one misperception, not as an insider, is you've heard that old expression. People hate Congress, but they like their own Congress person. That's not true. It's not true anymore. People don't like Congress and they don't like their own Congress person. But guess what? They don't have the opportunity to vote that person out because they're shuttered into closed primaries and a majority of districts, almost every single district, the majority of voters belong to the party or non-party, opposite of the member of",
    "speaker_id": "SPEAKER_12",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
      {
        "text": "The common perception that people dislike Congress but like their local representative is false.",
        "confidence": 0.94
      },
      {
        "text": "People do not like their own congressperson.",
        "confidence": 0.92
      },
      {
        "text": "Voters often cannot remove underperforming representatives due to closed primary systems.",
        "confidence": 0.9
      },
      {
        "text": "Most congressional districts are dominated by one political party.",
        "confidence": 0.89
      }
    ],
    "assumptions": [
      {
        "text": "The speaker has reliable data on public opinion toward members of Congress.",
        "confidence": 0.91
      },
      {
        "text": "Closed primaries reduce electoral accountability and limit voter choice.",
        "confidence": 0.87
      },
      {
        "text": "Electoral system design significantly influences voter satisfaction with representation.",
        "confidence": 0.86
      },
      {
        "text": "Public approval ratings reflect genuine sentiment rather than superficial impressions.",
