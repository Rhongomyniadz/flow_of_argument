    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/4/9/49972.jsonl",
    "turn_idx": 161,
    "turn_text": "Now that you've been on the inside, what is the preconception that most of us have that we misunderstand, that we're wrong about serving in Congress?",
