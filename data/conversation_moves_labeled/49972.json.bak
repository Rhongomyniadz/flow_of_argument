      },
      {
        "text": "The current electoral structure requires mechanisms to prevent minority winners.",
        "confidence": 0.88
      },
      {
        "text": "Majority preference is a morally superior standard for electing representatives than plurality.",
        "confidence": 0.87
      }
    ],
    "turn_type_label": "Substantive",
