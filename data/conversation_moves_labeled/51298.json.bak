  {
    "episode_id": 51298,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/1/51298.jsonl",
    "turn_idx": 73,
    "turn_text": "Seeing those trucks yesterday was a really good start, but we've already seen some of those who've tried to use starvation as a weapon of war, putting back in all the breaks. We need to see President Burhan continue to exert that clear message that these are just the beginning. We've got 100 trucks already ready. They need to be moving, not just through Adre, but also on the Dava Road and other mechanisms to get to over 20 million people who face acute shortage and even starvation. We've got to be moving quickly.",
    "speaker_id": "SPEAKER_20",
