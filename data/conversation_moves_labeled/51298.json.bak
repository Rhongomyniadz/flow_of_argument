  },
  {
    "episode_id": 51298,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/1/51298.jsonl",
    "turn_idx": 4,
    "turn_text": "It is one of the oldest tricks in politics, from a guy who has, let's face it, gotten pretty stale. We do not need four more years. of bluster and bumbling and chaos. We have seen that movie before and we all know that the sequel is usually worse.",
