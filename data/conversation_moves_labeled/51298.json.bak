      {
        "text": "Political tactics involving repetition of past strategies are generally manipulative or ineffective.",
        "confidence": 0.9
      },
      {
        "text": "Audiences recognize patterns in political behavior and can anticipate negative outcomes based on history.",
        "confidence": 0.89
      },
      {
        "text": "Sequels to bad movies are typically worse than the original, serving as a valid analogy for repeated leadership.",
        "confidence": 0.88
      },
      {
        "text": "The public values stability and competence over spectacle and unpredictability.",
        "confidence": 0.87
      }
    ],
    "turn_type_label": "Substantive",
    "conversation_move_label": "Correction / Challenge"
  },
  {
