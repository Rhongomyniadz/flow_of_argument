  },
  {
    "episode_id": 51298,
    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/5/1/51298.jsonl",
    "turn_idx": 60,
    "turn_text": "Yes, we're always aware that our daughter would be absolutely delighted with what the Foundation's been able to achieve. She was a fairly modest person, so she wouldn't like the fame, but she'd be very happy to see this.",
