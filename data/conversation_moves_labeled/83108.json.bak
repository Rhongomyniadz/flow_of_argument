    "turn_file": "/shared/3/projects/podcasts/transcriptionQueue/turns/pol_appearance_episodes_interviews/8/3/83108.jsonl",
    "turn_idx": 12,
    "turn_text": "Well, thanks again for joining us this morning. I have political playlists. We're here to give different avenues for people to engage with politics. And a lot of people feel disconnected from the political system today and feel that it's broken. So what would you say as a way for Americans to feel more connected to the system?",
    "speaker_id": "SPEAKER_03",
    "inferred_speaker_name": null,
    "inferred_speaker_role": null,
    "chosen_text_key": "transcript",
    "explicit_propositions": [
